<!--
  Docker Application Log Decoders
  Parses structured logs from containerized services read via json-file log driver.

  NOTE: With <log_format>json</log_format>, Wazuh's built-in JSON decoder handles
  the initial parse — extracting "log", "stream", "time" fields automatically.
  decoded_as = "json". The location field contains the symlink path:
    /var/log/docker-containers/<container>.log

  These child decoders extract app-specific fields from the "log" content
  for events already decoded by the built-in json decoder.
-->

<!-- ================================================================ -->
<!-- KANIDM — extract fields from Rust structured log lines            -->
<!-- Kanidm log format: "<uuid> <LEVEL> <handler> [duration]"          -->
<!-- or: "<uuid> <LEVEL> ┕━ ｉ [info]: <message>"                     -->
<!-- ================================================================ -->

<!-- There is no custom parent decoder — the built-in "json" decoder
     handles all Docker json-file logs. Rules use <decoded_as>json</decoded_as>
     plus <location>docker-containers</location> to scope matching. -->

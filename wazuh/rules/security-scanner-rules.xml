<!-- Security Scanner Integration Rules                                   -->
<!-- Rule IDs: 102000-102029                                              -->
<!--                                                                      -->
<!-- PURPOSE                                                              -->
<!--   The security scanner on hostinger-01 emits JSONL findings for     -->
<!--   each check performed against targets (netexec, nmap). These rules  -->
<!--   classify findings by severity and specific AD misconfiguration     -->
<!--   checks, routing each to the appropriate alert tier so the          -->
<!--   analyst queue is proportional to finding criticality.             -->
<!--                                                                      -->
<!-- ANCHORING                                                            -->
<!--   The anchor (102000) keys off the security-scanner-json decoder     -->
<!--   at level 0 (not indexed). All severity and finding rules chain    -->
<!--   from 102000 via if_sid, so only fully-decoded scanner JSONL        -->
<!--   events reach the child rules.                                     -->
<!--                                                                      -->
<!-- VOLUME CONTROL                                                       -->
<!--   102000 is level 0 (not indexed); it groups all scanner events.    -->
<!--   Indexing is gated by child rules that scope on data.severity       -->
<!--   and data.check fields. Informational findings land at level 3;    -->
<!--   targeted AD misconfiguration checks reach level 10-12.            -->
<!--                                                                      -->
<!-- FIELDS (security-scanner-json decoder via JSON_Decoder plugin)      -->
<!--   data.source     discriminant, always "security-scanner"           -->
<!--   data.scanner    tool name, e.g. "netexec", "nmap"                 -->
<!--   data.timestamp  ISO 8601 scan timestamp                           -->
<!--   data.target     IP or hostname being scanned                      -->
<!--   data.protocol   e.g. "smb", "ldap", "kerberos"                   -->
<!--   data.check      specific check, e.g. "smb_signing", "null_session"-->
<!--   data.result     finding string, e.g. "disabled", "3_accounts_found"-->
<!--   data.severity   info | medium | high | critical                   -->
<!--   data.raw        raw scanner output line (optional)                -->

<group name="security-scanner,ad-assessment,">

  <!-- ================================================================ -->
  <!-- ANCHOR - a security scanner finding was decoded (level 0)         -->
  <!-- Not indexed; all severity and check-specific rules chain from     -->
  <!-- this via if_sid.                                                  -->
  <!-- ================================================================ -->
  <rule id="102000" level="0">
    <decoded_as>security-scanner-json</decoded_as>
    <description>Security scanner: finding recorded</description>
    <group>security-scanner,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- SEVERITY TIERS - classify by data.severity, chain from 102000     -->
  <!-- Informational findings are indexed at level 3 for baselining.    -->
  <!-- Medium/high/critical escalate using MITRE T1046 (Network Service -->
  <!-- Scanning) as the primary technique; check-specific rules below   -->
  <!-- carry the precise sub-technique for each AD misconfiguration.    -->
  <!-- ================================================================ -->
  <rule id="102001" level="3">
    <if_sid>102000</if_sid>
    <field name="data.severity">^info$</field>
    <description>Security scanner: informational finding - $(data.check) on $(data.target)</description>
  </rule>

  <rule id="102002" level="8">
    <if_sid>102000</if_sid>
    <field name="data.severity">^medium$</field>
    <description>Security scanner: medium severity - $(data.check) on $(data.target)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="102003" level="10">
    <if_sid>102000</if_sid>
    <field name="data.severity">^high$</field>
    <description>Security scanner: HIGH - $(data.check) on $(data.target)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="102004" level="12">
    <if_sid>102000</if_sid>
    <field name="data.severity">^critical$</field>
    <description>Security scanner: CRITICAL - $(data.check) on $(data.target)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>


  <!-- ================================================================ -->
  <!-- AD FINDINGS - specific Active Directory misconfiguration checks   -->
  <!-- All chain from 102000 and carry targeted MITRE sub-technique IDs  -->
  <!-- for the attack vector each finding directly enables.             -->
  <!-- ================================================================ -->

  <!-- SMB signing disabled - enables NTLM relay / MitM attacks         -->
  <!-- T1557.001 (Adversary-in-the-Middle: LLMNR/NBT-NS Poisoning)     -->
  <rule id="102010" level="12">
    <if_sid>102000</if_sid>
    <field name="data.check">^smb_signing$</field>
    <field name="data.result">^disabled$</field>
    <description>AD Security: SMB signing disabled on $(data.target) - relay attack vector</description>
    <mitre>
      <id>T1557.001</id>
    </mitre>
    <group>security-scanner,credential_access,lateral_movement,</group>
  </rule>

  <!-- SMB null session - unauthenticated share/user enumeration        -->
  <!-- T1078.002 (Valid Accounts: Domain Accounts) / T1135 (Network     -->
  <!-- Share Discovery)                                                 -->
  <rule id="102011" level="10">
    <if_sid>102000</if_sid>
    <field name="data.check">^null_session$</field>
    <field name="data.result">^allowed$</field>
    <description>AD Security: SMB null session allowed on $(data.target)</description>
    <mitre>
      <id>T1078.002</id>
      <id>T1135</id>
    </mitre>
    <group>security-scanner,initial_access,discovery,</group>
  </rule>

  <!-- Anonymous LDAP bind - unauthenticated directory enumeration      -->
  <!-- T1087.002 (Account Discovery: Domain Account)                   -->
  <rule id="102012" level="10">
    <if_sid>102000</if_sid>
    <field name="data.check">^anonymous_bind$</field>
    <field name="data.result">^allowed$</field>
    <description>AD Security: Anonymous LDAP bind allowed on $(data.target)</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>security-scanner,discovery,</group>
  </rule>

  <!-- Kerberoastable service accounts found - offline TGS cracking     -->
  <!-- T1558.003 (Steal or Forge Kerberos Tickets: Kerberoasting)      -->
  <rule id="102013" level="10">
    <if_sid>102000</if_sid>
    <field name="data.check">^kerberoastable_accounts$</field>
    <field name="data.result" type="pcre2">_accounts_found$</field>
    <description>AD Security: Kerberoastable accounts on $(data.target) - $(data.result)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>security-scanner,credential_access,</group>
  </rule>

  <!-- ASREPRoastable accounts - pre-auth not required, offline crack   -->
  <!-- T1558.004 (Steal or Forge Kerberos Tickets: AS-REP Roasting)    -->
  <rule id="102014" level="10">
    <if_sid>102000</if_sid>
    <field name="data.check">^asreproastable_accounts$</field>
    <field name="data.result" type="pcre2">_accounts_found$</field>
    <description>AD Security: ASREPRoastable accounts on $(data.target) - $(data.result)</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>security-scanner,credential_access,</group>
  </rule>

  <!-- ADCS misconfiguration - vulnerable cert templates (ESC1/4/6)     -->
  <!-- T1649 (Steal or Forge Authentication Certificates)               -->
  <!-- T1550.001 (Use Alternate Authentication Material: Pass the Hash) -->
  <rule id="102015" level="12">
    <if_sid>102000</if_sid>
    <field name="data.check">^adcs_misconfiguration$</field>
    <field name="data.result" type="pcre2">_vulnerable_templates$</field>
    <description>AD Security: CRITICAL - Vulnerable ADCS certificate templates on $(data.target)</description>
    <mitre>
      <id>T1649</id>
      <id>T1550.001</id>
    </mitre>
    <group>security-scanner,credential_access,privilege_escalation,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- EXTERNAL EXPOSURE - high-risk ports/services visible externally   -->
  <!-- Chains from 102000; fires when an external scan reports a high-  -->
  <!-- severity open port. T1133 (External Remote Services).            -->
  <!-- ================================================================ -->
  <rule id="102020" level="10">
    <if_sid>102000</if_sid>
    <field name="data.check">^external_port_open$</field>
    <field name="data.severity">^high$</field>
    <description>External scan: High-risk port exposed on $(data.target) - $(data.result)</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>security-scanner,network_policy,</group>
  </rule>

</group>

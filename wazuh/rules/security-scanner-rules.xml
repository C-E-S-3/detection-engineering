<!-- Security Scanner Integration Rules                                   -->
<!-- Rule IDs: 102000-102029                                              -->
<!--                                                                      -->
<!-- PURPOSE                                                              -->
<!--   The security scanner on hostinger-01 emits JSONL findings for     -->
<!--   each check performed against targets (netexec, nmap). These rules  -->
<!--   classify findings by severity and specific AD misconfiguration     -->
<!--   checks, routing each to the appropriate alert tier.               -->
<!--                                                                      -->
<!-- DECODER NOTE                                                         -->
<!--   Wazuh's builtin JSON decoder (loaded first) decodes these events. -->
<!--   The JSON decoder does not expose fields to <field> rule elements;  -->
<!--   use <match> for single-key substring match on the raw JSON string  -->
<!--   or <regex type="pcre2"> for multi-key patterns.                   -->
<!--                                                                      -->
<!-- ANCHORING                                                            -->
<!--   The anchor (102000) matches the discriminant "source" key at      -->
<!--   level 0 (not indexed). All severity and finding rules chain from  -->
<!--   102000 via if_sid.                                                -->
<!--                                                                      -->
<!-- FIELDS (from raw JSONL, matched via match/regex)                    -->
<!--   "source":"security-scanner"  discriminant                         -->
<!--   "scanner":"netexec|nmap"     tool name                            -->
<!--   "target":"<ip>"              scanned IP or hostname               -->
<!--   "protocol":"smb|ldap|..."    transport/app protocol               -->
<!--   "check":"<check_name>"       specific check performed             -->
<!--   "result":"<result>"          finding value                        -->
<!--   "severity":"info|medium|high|critical"                            -->

<group name="security-scanner,ad-assessment,">

  <!-- ================================================================ -->
  <!-- ANCHOR - a security scanner finding was decoded (level 0)         -->
  <!-- Not indexed; all severity and check-specific rules chain from     -->
  <!-- this via if_sid.                                                  -->
  <!-- ================================================================ -->
  <rule id="102000" level="0">
    <decoded_as>json</decoded_as>
    <match>"source":"security-scanner"</match>
    <description>Security scanner: finding recorded</description>
    <group>security-scanner,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- SEVERITY TIERS - classify by severity field, chain from 102000    -->
  <!-- ================================================================ -->
  <rule id="102001" level="3">
    <if_sid>102000</if_sid>
    <match>"severity":"info"</match>
    <description>Security scanner: informational finding</description>
  </rule>

  <rule id="102002" level="8">
    <if_sid>102000</if_sid>
    <match>"severity":"medium"</match>
    <description>Security scanner: medium severity finding</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="102003" level="10">
    <if_sid>102000</if_sid>
    <match>"severity":"high"</match>
    <description>Security scanner: HIGH severity finding</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="102004" level="12">
    <if_sid>102000</if_sid>
    <match>"severity":"critical"</match>
    <description>Security scanner: CRITICAL severity finding</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>


  <!-- ================================================================ -->
  <!-- AD FINDINGS - specific Active Directory misconfiguration checks   -->
  <!-- All chain from 102000; use pcre2 regex for multi-field matching   -->
  <!-- ================================================================ -->

  <!-- SMB signing disabled - enables NTLM relay / MitM attacks         -->
  <rule id="102010" level="13">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"smb_signing".*"result":"disabled"</regex>
    <description>AD Security: SMB signing disabled on target - relay attack vector</description>
    <mitre>
      <id>T1557.001</id>
    </mitre>
    <group>security-scanner,credential_access,lateral_movement,</group>
  </rule>

  <!-- SMB null session - unauthenticated share/user enumeration        -->
  <rule id="102011" level="11">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"null_session".*"result":"allowed"</regex>
    <description>AD Security: SMB null session allowed on target</description>
    <mitre>
      <id>T1078.002</id>
      <id>T1135</id>
    </mitre>
    <group>security-scanner,initial_access,discovery,</group>
  </rule>

  <!-- Anonymous LDAP bind - unauthenticated directory enumeration      -->
  <rule id="102012" level="11">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"anonymous_bind".*"result":"allowed"</regex>
    <description>AD Security: Anonymous LDAP bind allowed on target</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>security-scanner,discovery,</group>
  </rule>

  <!-- Kerberoastable service accounts found - offline TGS cracking     -->
  <rule id="102013" level="11">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"kerberoastable_accounts".*"result":"[^"]*_accounts_found</regex>
    <description>AD Security: Kerberoastable accounts found on target</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>security-scanner,credential_access,</group>
  </rule>

  <!-- ASREPRoastable accounts - pre-auth not required, offline crack   -->
  <rule id="102014" level="11">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"asreproastable_accounts".*"result":"[^"]*_accounts_found</regex>
    <description>AD Security: ASREPRoastable accounts found on target</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>security-scanner,credential_access,</group>
  </rule>

  <!-- ADCS misconfiguration - vulnerable cert templates (ESC1/4/6)     -->
  <rule id="102015" level="13">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"adcs_misconfiguration".*"result":"[^"]*_vulnerable_templates</regex>
    <description>AD Security: CRITICAL - Vulnerable ADCS certificate templates on target</description>
    <mitre>
      <id>T1649</id>
      <id>T1550.001</id>
    </mitre>
    <group>security-scanner,credential_access,privilege_escalation,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- EXTERNAL EXPOSURE - high-risk ports/services visible externally   -->
  <!-- ================================================================ -->
  <rule id="102020" level="11">
    <if_sid>102000</if_sid>
    <regex type="pcre2">"check":"external_port_open".*"severity":"high"</regex>
    <description>External scan: High-risk port exposed on target</description>
    <mitre>
      <id>T1133</id>
    </mitre>
    <group>security-scanner,network_policy,</group>
  </rule>

</group>

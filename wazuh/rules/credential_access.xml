<!-- Credential Access Detection Rules (MITRE ATT&CK TA0006) -->
<!-- Rule IDs: 100100-100199 -->
<!-- Source: Curated from SigmaHQ detection rules -->

<group name="credential_access,mitre_t1003,">

  <!-- Mimikatz Usage Detection -->
  <rule id="100100" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.originalFileName">mimikatz\.exe</field>
    <description>Credential Access: Mimikatz execution detected (T1003)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
    <group>credential_access,mimikatz,</group>
  </rule>

  <rule id="100101" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)sekurlsa::|lsadump::|kerberos::|crypto::</field>
    <description>Credential Access: Mimikatz command-line arguments detected (T1003)</description>
    <mitre>
      <id>T1003</id>
    </mitre>
    <group>credential_access,mimikatz,</group>
  </rule>

  <!-- SAM Database Dump -->
  <rule id="100110" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg\s+save\s+hklm\\sam</field>
    <description>Credential Access: SAM registry hive export detected (T1003.002)</description>
    <mitre>
      <id>T1003.002</id>
    </mitre>
    <group>credential_access,sam_dump,</group>
  </rule>

  <rule id="100111" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg\s+save\s+hklm\\(system|security)</field>
    <description>Credential Access: SYSTEM/SECURITY registry hive export detected (T1003.002)</description>
    <mitre>
      <id>T1003.002</id>
    </mitre>
    <group>credential_access,sam_dump,</group>
  </rule>

  <!-- LSASS Memory Access -->
  <rule id="100120" level="14">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x1FFFFF|0x1010|0x1038</field>
    <description>Credential Access: Suspicious LSASS memory access detected (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass_access,</group>
  </rule>

  <!-- NTDS.dit Access -->
  <rule id="100130" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)ntdsutil.*activate\s+instance\s+ntds</field>
    <description>Credential Access: NTDS.dit extraction via ntdsutil (T1003.003)</description>
    <mitre>
      <id>T1003.003</id>
    </mitre>
    <group>credential_access,ntds_dump,</group>
  </rule>

  <rule id="100131" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)vssadmin.*create\s+shadow.*\/for=C:</field>
    <description>Credential Access: Volume Shadow Copy creation for credential theft (T1003.003)</description>
    <mitre>
      <id>T1003.003</id>
    </mitre>
    <group>credential_access,ntds_dump,</group>
  </rule>

  <!-- DCSync Detection -->
  <rule id="100140" level="15">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2</field>
    <description>Credential Access: DCSync attack detected - directory replication request (T1003.006)</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>credential_access,dcsync,</group>
  </rule>

  <!-- Credential Dumping via comsvcs.dll -->
  <rule id="100150" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs\.dll.*MiniDump</field>
    <description>Credential Access: Process memory dump via comsvcs.dll (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass_access,</group>
  </rule>

  <!-- Kerberoasting -->
  <rule id="100160" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">0x17</field>
    <field name="win.eventdata.ticketOptions" type="pcre2">0x40810000</field>
    <description>Credential Access: Potential Kerberoasting detected - RC4 TGS request (T1558.003)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>credential_access,kerberoasting,</group>
  </rule>

</group>

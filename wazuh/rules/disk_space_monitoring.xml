<!-- Disk Space Monitoring Rules                                               -->
<!-- Rule IDs: 101500-101519                                                   -->
<!-- Detects filesystem exhaustion (ENOSPC) from kernel syslog, userspace      -->
<!-- processes, and Docker container stderr/stdout. Also catches high-threshold -->
<!-- disk usage warnings (>= 90%) from monitoring scripts.                     -->
<!--                                                                           -->
<!-- Architecture:                                                             -->
<!--   - Syslog-based rules (101500-101509) match via decoded_as=syslog.       -->
<!--     Rule 101500 is the anchor; children refine by source/severity.        -->
<!--   - Docker rules (101510-101519) chain off the docker base (101200).      -->
<!--                                                                           -->
<!-- MITRE ATT&amp;CK:                                                             -->
<!--   - T1499 (Endpoint Denial of Service): adversary-caused disk exhaustion  -->
<!--   - T1485 (Data Destruction): disk fill to destroy logs / deny recovery   -->
<!--   Impact tactic (TA0040)                                                  -->

<group name="linux,disk_space,impact,">

  <!-- ================================================================ -->
  <!-- BASE RULE - anchor for syslog disk space events                  -->
  <!-- Matches ENOSPC and "no space left on device" from any source.    -->
  <!-- ================================================================ -->

  <rule id="101500" level="0">
    <regex type="pcre2">(?i)(no\s+space\s+left\s+on\s+device|ENOSPC)</regex>
    <description>Linux: Disk space exhaustion event (syslog anchor)</description>
  </rule>


  <!-- ================================================================ -->
  <!-- KERNEL ENOSPC - filesystem at 100%                               -->
  <!-- Fired when the kernel cannot allocate space for a write.         -->
  <!-- Indicates the physical/virtual disk is 100% full.               -->
  <!-- ================================================================ -->

  <rule id="101501" level="12">
    <if_sid>101500</if_sid>
    <program_name>kernel</program_name>
    <description>Linux: Kernel ENOSPC - filesystem is 100% full; writes failing</description>
    <mitre>
      <id>T1499</id>
      <id>T1485</id>
    </mitre>
    <group>disk_exhaustion,kernel,impact,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- USERSPACE ENOSPC - process failed to write                       -->
  <!-- Any non-kernel process reporting no space left. Covers log       -->
  <!-- writers, databases, container runtimes, etc.                     -->
  <!-- ================================================================ -->

  <rule id="101502" level="10">
    <if_sid>101500</if_sid>
    <description>Linux: Process failed with ENOSPC - disk full, writes dropped</description>
    <mitre>
      <id>T1499</id>
    </mitre>
    <group>disk_exhaustion,impact,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- HIGH DISK USAGE WARNING - >= 90% threshold                       -->
  <!-- Catches monitoring-script output (e.g. df-based checks) that     -->
  <!-- report a partition at 90-100% before hard ENOSPC is reached.     -->
  <!-- Pattern: "partition '/foo': NN% full" or "filesystem 90%"        -->
  <!-- ================================================================ -->

  <rule id="101503" level="8">
    <regex type="pcre2">(?i)(filesystem|partition|volume|disk)[^:]{0,60}(?:9[0-9]|100)\s*%</regex>
    <description>Linux: Filesystem usage >= 90% - approaching exhaustion</description>
    <group>disk_warning,impact,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- ROOTCHECK DISK WARNING - Wazuh built-in disk check escalation    -->
  <!-- Wazuh rootcheck fires rule 510 for generic anomaly events;       -->
  <!-- this child escalates when the anomaly is disk-space related.     -->
  <!-- ================================================================ -->

  <rule id="101504" level="9">
    <if_sid>510</if_sid>
    <regex type="pcre2">(?i)(disk\s+usage|no\s+space|filesystem\s+full|partition.*full)</regex>
    <description>Linux: Wazuh rootcheck - disk space anomaly detected</description>
    <group>disk_warning,rootcheck,impact,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- DOCKER OVERLAY DISK FULL - container filesystem exhaustion       -->
  <!-- Matches Docker container stderr/stdout (json-file log driver).   -->
  <!-- Chains off docker base rule 101200 (decoded_as=json + stream).  -->
  <!-- Overlay filesystem exhaustion can indicate:                      -->
  <!--   - Uncontrolled log growth inside container                     -->
  <!--   - Data exfiltration staging filling local storage              -->
  <!--   - Ransomware encrypting files inside container volume          -->
  <!-- ================================================================ -->

  <rule id="101510" level="11">
    <if_sid>101200</if_sid>
    <field name="log" type="pcre2">(?i)(no\s+space\s+left\s+on\s+device|ENOSPC|overlay.*no\s+space|write.*no\s+space|disk\s+full)</field>
    <description>Docker: Container reports disk full - overlay filesystem exhaustion</description>
    <mitre>
      <id>T1499</id>
      <id>T1485</id>
    </mitre>
    <group>disk_exhaustion,docker,impact,</group>
  </rule>


  <!-- Rapid recurrence: disk full repeated 5+ times in 60 seconds      -->
  <!-- Indicates continuous write pressure, not a one-off error.        -->
  <rule id="101511" level="13" frequency="5" timeframe="60">
    <if_matched_sid>101510</if_matched_sid>
    <same_srcip />
    <description>Docker: Repeated disk-full errors in container - sustained write pressure (possible data staging)</description>
    <mitre>
      <id>T1499</id>
      <id>T1485</id>
    </mitre>
    <group>disk_exhaustion,docker,impact,high_frequency,</group>
  </rule>

</group>

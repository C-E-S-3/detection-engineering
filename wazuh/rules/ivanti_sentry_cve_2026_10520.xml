<!-- ============================================================
     Ivanti Sentry CVE-2026-10520 / CVE-2026-10523 Detection Rules
     MITRE ATT&CK:
       T1190  - Exploit Public-Facing Application
       T1136.001 - Create Account: Local Account (CVE-2026-10523)
     Rule IDs: 101800-101810
     Author: SecOps Engineer (Purple Team)
     Date: 2026-06-14

     References:
       CVE-2026-10520 - CVSS 10.0 OS command injection in Ivanti Sentry
         MICS API (managementConfigService/handleMessage endpoint).
         Unauthenticated; achieves root RCE. CISA KEV since 2026-06-11.
         Backdoors observed within 24 hours of PoC release.
       CVE-2026-10523 - CVSS 9.9 authentication bypass companion to
         CVE-2026-10520; allows creation of arbitrary admin accounts.

     Log source prerequisites:
       - Traefik access log in JSON format forwarded to Wazuh
         (localfile block with log_format=json in ossec.conf)
       - Built-in Wazuh JSON decoder (decoded_as=json)
       - JSON field names follow Traefik defaults:
           RequestPath, RequestMethod, RequestHost, DownstreamStatus,
           ClientHost, entryPointName, RouterName, ServiceName,
           request_User-Agent

     Severity tiers:
       High   (11-12) - Suspicious MICS API access, investigate promptly
       Critical (13)  - Direct CVE exploit path POST to handleMessage
       Critical (14)  - Repeated scanning / brute-force of MICS API
     ============================================================ -->

<group name="initial_access,exploit_pubfacing,ivanti_sentry,">

  <!-- ===========================================================
       T1190 - Exploit Public-Facing Application
       Ivanti Sentry MICS API — CVE-2026-10520 / CVE-2026-10523
       Rule IDs: 101800-101810
       =========================================================== -->

  <!-- Any HTTP access to the Ivanti Sentry MICS API path -->
  <!-- Baseline: any request under /mics/api/ is suspicious          -->
  <!-- in environments that do not intentionally expose this endpoint -->
  <rule id="101800" level="0">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">^/mics/api/</field>
    <description>Ivanti Sentry MICS API access: $(RequestPath) from $(ClientHost) [baseline rule 101800]</description>
    <group>ivanti_sentry,mics_api,</group>
  </rule>

  <!-- MICS API accessed — anomalous unless MICS admin is expected    -->
  <rule id="101801" level="11">
    <if_sid>101800</if_sid>
    <description>Ivanti Sentry MICS API endpoint $(RequestPath) accessed via $(RequestMethod) from $(ClientHost) — anomalous MICS management API access (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,initial_access,</group>
  </rule>

  <!-- POST to MICS API returning 200 or 500 — actionable execution   -->
  <!-- HTTP 200 = command accepted; HTTP 500 = server-side execution   -->
  <!-- error (may still indicate successful exploitation with side     -->
  <!-- effects or blind RCE). HTTP 405 (method not allowed) is NOT     -->
  <!-- matched here — that response indicates probing without success. -->
  <rule id="101802" level="12">
    <if_sid>101800</if_sid>
    <field name="RequestMethod">POST</field>
    <field name="DownstreamStatus" type="pcre2">^(200|500)$</field>
    <description>Ivanti Sentry MICS API POST returning $(DownstreamStatus) from $(ClientHost) — possible CVE-2026-10520 exploitation attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,initial_access,exploit_attempt,</group>
  </rule>

  <!-- Direct hit on the CVE-2026-10520 vulnerable endpoint           -->
  <!-- POST to /mics/api/v2/sentry/mics-config/handleMessage is the   -->
  <!-- primary exploitation path (OS command injection via the         -->
  <!-- command=execute parameter in the handleMessage handler).        -->
  <rule id="101803" level="13">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">mics-config/handleMessage</field>
    <field name="RequestMethod">POST</field>
    <description>Ivanti Sentry CVE-2026-10520 exploit path: POST to mics-config/handleMessage from $(ClientHost) — unauthenticated OS command injection (CVSS 10.0, CISA KEV) (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,cve_2026_10520,initial_access,rce,critical,</group>
  </rule>

  <!-- ANY access to the handleMessage endpoint (GET probe or POST)   -->
  <rule id="101804" level="12">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">mics-config/handleMessage</field>
    <description>Ivanti Sentry MICS handleMessage endpoint probed from $(ClientHost) — CVE-2026-10520 reconnaissance or exploitation (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,cve_2026_10520,initial_access,</group>
  </rule>

  <!-- CVE-2026-10523: auth bypass — POST to admin/user-management API-->
  <!-- that should require authentication returning 200/201            -->
  <rule id="101805" level="12">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">^/mics/api/v2/sentry/(users|admins|accounts|auth|roles)/</field>
    <field name="RequestMethod" type="pcre2">^(POST|PUT|PATCH)$</field>
    <field name="DownstreamStatus" type="pcre2">^(200|201)$</field>
    <description>Ivanti Sentry admin account API $(RequestPath) accepted $(RequestMethod) from $(ClientHost) — potential CVE-2026-10523 auth bypass + account creation (T1190/T1136.001)</description>
    <mitre>
      <id>T1190</id>
      <id>T1136.001</id>
    </mitre>
    <group>ivanti_sentry,cve_2026_10523,initial_access,account_creation,</group>
  </rule>

  <!-- Frequency: MICS API being scanned (10+ requests in 60 seconds) -->
  <!-- Indicates automated exploitation tooling or vulnerability scan  -->
  <rule id="101806" level="0" timeframe="60" frequency="10">
    <if_sid>101800</if_sid>
    <same_field>ClientHost</same_field>
    <description>Ivanti Sentry MICS API repeated access — frequency baseline (101806)</description>
    <group>ivanti_sentry,mics_api,frequency,</group>
  </rule>

  <rule id="101807" level="14" frequency="10" timeframe="60">
    <if_sid>101800</if_sid>
    <same_field>ClientHost</same_field>
    <description>Ivanti Sentry MICS API scanned by $(ClientHost) — 10+ requests in 60 seconds indicates automated exploitation tooling for CVE-2026-10520 (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,scanning,critical,</group>
  </rule>

  <!-- MICS API accessed from public/external IP (non-RFC1918)        -->
  <!-- MICS management API should never be internet-accessible;        -->
  <!-- external access is always critical regardless of path.          -->
  <rule id="101808" level="13">
    <if_sid>101800</if_sid>
    <field name="ClientHost" type="pcre2">(?!^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|::1|localhost))</field>
    <description>Ivanti Sentry MICS API accessed from external IP $(ClientHost) — MICS admin API must not be internet-facing; CVE-2026-10520 exposure (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,external_access,critical,</group>
  </rule>

  <!-- MICS API returning errors (400/401/403/404/500) in burst        -->
  <!-- Indicates failed exploitation attempts or fuzzing               -->
  <rule id="101809" level="11">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">^/mics/api/</field>
    <field name="DownstreamStatus" type="pcre2">^(400|401|403|404|405|500|502|503)$</field>
    <description>Ivanti Sentry MICS API error $(DownstreamStatus) from $(ClientHost) path $(RequestPath) — failed exploitation or recon of CVE-2026-10520 (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,exploit_probe,</group>
  </rule>

  <!-- MICS config backup/restore endpoints — can be abused to        -->
  <!-- exfiltrate config containing hashed credentials or to inject   -->
  <!-- malicious config blobs                                          -->
  <rule id="101810" level="12">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">^/mics/api/v2/sentry/(export|import|backup|restore|config-download|config-upload)</field>
    <description>Ivanti Sentry MICS config export/import API $(RequestPath) accessed from $(ClientHost) — potential configuration exfiltration or malicious config injection (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ivanti_sentry,mics_api,config_access,</group>
  </rule>

</group>

    <field name="win.eventdata.commandLine" type="pcre2">202\.61\.160\.201</field>
    <description>WhatsApp VBScript campaign: Connection attempt to known C2 IP 202.61.160.201 on $(agent.name) — ValleyRAT/Gh0st RAT infrastructure (T1105)</description>
    <mitre>

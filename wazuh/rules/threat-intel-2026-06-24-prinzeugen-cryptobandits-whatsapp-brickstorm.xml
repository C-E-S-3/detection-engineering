<!-- ============================================================
     Threat Intelligence Detection Rules — 2026-06-24 Batch 4
     Sources:
       - Prinz Eugen: Go-based ransomware (ROOTBOY) — BleepingComputer/ThreatDown 2026-06-20
         File ext: .prinzeugen; dropper: servertool.exe; via RDP; no ransom note
       - CryptoBandits: USB LNK worm + Tor crypto clipper — Microsoft 2026-06-17
         ugate.exe Tor proxy; WScript from C:\Users\Public\Documents\[5char]\
       - WhatsApp VBScript / ManageEngine RMM — Kaspersky Securelist 2026-06-22
         Chinese-linked actor; VBScript via WhatsApp; UAC bypass; RMM backdoor
         C2: 202.61.160[.]201 (ValleyRAT/Gh0st RAT infra overlap)
       - QUIETVAULT: AI-assisted credential stealer — M-Trends 2026
         Ollama/LLM CLI spawns shell; accesses .ssh/.aws/credential paths
       - GreatXML: WinRE BitLocker bypass PoC — Nightmare Eclipse 2026-06-22
         Physical access; WinRE answer file spawns SYSTEM cmd.exe; no CVE yet
       - BRICKSTORM: In-memory network appliance backdoor — UNC6201/UNC5807
         Targets Ivanti/Fortinet/Cisco edge devices; syslog shell pattern detection

     Rule IDs: 103496-103540
     Author: SecOps Purple Team
     Date: 2026-06-24

     MITRE ATT&CK Coverage:
       T1486  Data Encrypted for Impact (Prinz Eugen)
       T1070.004  Indicator Removal: File Deletion (Prinz Eugen self-delete)
       T1489  Service Stop (Prinz Eugen process kill)
       T1091  Replication Through Removable Media (CryptoBandits)
       T1059.007  Command and Scripting Interpreter: JavaScript (CryptoBandits)
       T1053.005  Scheduled Task/Job (CryptoBandits persistence)
       T1090.003  Proxy: Multi-hop Proxy (CryptoBandits Tor)
       T1562.001  Impair Defenses: Disable or Modify Tools (CryptoBandits Defender exclusion)
       T1059.005  Command and Scripting Interpreter: Visual Basic (WhatsApp VBScript)
       T1548.002  Abuse Elevation Control Mechanism: Bypass UAC (WhatsApp campaign)
       T1219  Remote Access Software (ManageEngine RMM abuse)
       T1105  Ingress Tool Transfer (WhatsApp C2 download)
       T1552.001  Unsecured Credentials: Credentials in Files (QUIETVAULT)
       T1083  File and Directory Discovery (QUIETVAULT AI enumeration)
       T1542.001  Pre-OS Boot: System Firmware (GreatXML WinRE)
       T1505.003  Server Software Component: Web Shell (BRICKSTORM)
     ============================================================ -->

<!-- =============================================================
     SECTION 1: Prinz Eugen Ransomware (ROOTBOY, Go-based)
     T1486 / T1489 / T1070.004
     Rules: 103496-103502
     Detection: .prinzeugen extension, servertool.exe, process kill bursts
     ============================================================= -->

<group name="impact,ransomware,prinz_eugen,initial_access,cryptobandits,usb_worm,execution,whatsapp_vbscript_rmm,credential_access,quietvault,ai_malware,defense_evasion,greatxml,winre_bypass,persistence,brickstorm,network_appliance,">

  <!-- .prinzeugen extension via Wazuh FIM (requires FIM on user data dirs) -->
  <rule id="103496" level="15">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">(?i)\.prinzeugen$</field>
    <description>Prinz Eugen ransomware: encrypted file with .prinzeugen extension detected on $(agent.name) — ROOTBOY ransomware (T1486)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,prinz_eugen,impact,high_fidelity,</group>
  </rule>

  <!-- .prinzeugen extension via Sysmon Event 11 (file create) -->
  <rule id="103497" level="15">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.prinzeugen$</field>
    <description>Prinz Eugen ransomware: Sysmon file-create with .prinzeugen extension on $(agent.name) — ROOTBOY active encryption (T1486)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,prinz_eugen,impact,high_fidelity,</group>
  </rule>

  <!-- servertool.exe — known Prinz Eugen dropper binary name -->
  <rule id="103498" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\servertool\.exe$</field>
    <description>Prinz Eugen ransomware: servertool.exe execution detected on $(agent.name) — known Prinz Eugen encryptor dropper (T1486, T1036.005)</description>
    <mitre>
      <id>T1486</id>
      <id>T1036.005</id>
    </mitre>
    <group>ransomware,prinz_eugen,impact,</group>
  </rule>

  <!-- servertool.exe process self-deletion (T1070.004 — binary deletes itself after encryption) -->
  <rule id="103499" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(cmd\.exe\s+/c\s+del|del\s+/[fqs]+)\s+.*servertool\.exe</field>
    <description>Prinz Eugen ransomware: servertool.exe self-deletion command detected on $(agent.name) — post-encryption anti-forensic cleanup (T1070.004)</description>
    <mitre>
      <id>T1070.004</id>
      <id>T1486</id>
    </mitre>
    <group>ransomware,prinz_eugen,defense_evasion,</group>
  </rule>

  <!-- Mass process termination — Prinz Eugen kills processes holding file handles -->
  <rule id="103500" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(taskkill\s+/f\s+(/im\s+\S+\s+){3,}|net\s+stop\s+.+&amp;&amp;\s*net\s+stop)</field>
    <description>Ransomware: Bulk process/service termination to release file handles on $(agent.name) — pre-encryption preparation (T1489)</description>
    <mitre>
      <id>T1489</id>
      <id>T1486</id>
    </mitre>
    <group>ransomware,impact,service_stop,</group>
  </rule>

  <!-- Multiple .prinzeugen files created in short burst — active encryption in progress -->
  <rule id="103501" level="15" frequency="10" timeframe="60">
    <if_matched_sid>103497</if_matched_sid>
    <same_field>agent.name</same_field>
    <description>Prinz Eugen ransomware: mass encryption burst — 10+ files with .prinzeugen extension in 60s on $(agent.name) — active ransomware execution (T1486)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,prinz_eugen,impact,high_fidelity,</group>
  </rule>

  <!-- Prinz Eugen RDP initial access marker: servertool.exe parent is mstsc/rdp session -->
  <rule id="103502" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\servertool\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(explorer|cmd|powershell|mstsc)\.exe$</field>
    <description>Prinz Eugen ransomware: servertool.exe spawned interactively from $(win.eventdata.parentImage) on $(agent.name) — hands-on-keyboard RDP operator pattern (T1486, T1078)</description>
    <mitre>
      <id>T1486</id>
      <id>T1078</id>
    </mitre>
    <group>ransomware,prinz_eugen,impact,initial_access,</group>
  </rule>



<!-- =============================================================
     SECTION 2: CryptoBandits USB LNK Worm + Tor Crypto Clipper
     T1091 / T1059.007 / T1053.005 / T1090.003 / T1562.001
     Rules: 103503-103511
     Detection: ugate.exe, WScript from Public\Documents, schtasks by scripts,
                PowerShell Defender exclusion for public path
     ============================================================= -->



  <!-- ugate.exe — renamed Tor binary; high-confidence IOC -->
  <rule id="103503" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ugate\.exe$</field>
    <description>CryptoBandits: ugate.exe (renamed Tor proxy) execution on $(agent.name) — USB LNK worm Tor C2 component active (T1090.003)</description>
    <mitre>
      <id>T1090.003</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,tor_proxy,command_and_control,high_fidelity,</group>
  </rule>

  <!-- WScript/CScript executing JS from C:\Users\Public\Documents\[5char]\ staging path -->
  <rule id="103504" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(wscript|cscript)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Users\\Public\\Documents\\[a-z]{4,6}\\</field>
    <description>CryptoBandits: WScript/CScript executing from Public\Documents staging path on $(agent.name) — USB LNK worm JS payload execution (T1059.007)</description>
    <mitre>
      <id>T1059.007</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,execution,initial_access,</group>
  </rule>

  <!-- WScript/CScript parent is Explorer — indicates USB LNK shortcut opened by user -->
  <rule id="103505" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(wscript|cscript)\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\explorer\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Users\\Public\\</field>
    <description>CryptoBandits: Explorer spawning scripting engine in Public path on $(agent.name) — user executed USB LNK shortcut (T1059.007, T1091)</description>
    <mitre>
      <id>T1059.007</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,execution,initial_access,</group>
  </rule>

  <!-- schtasks created by scripting engine — CryptoBandits persistence via scheduled task -->
  <rule id="103506" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(wscript|cscript|powershell|cmd)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create\s+</field>
    <description>CryptoBandits: Scheduled task created by scripting engine on $(agent.name) — USB worm persistence installation (T1053.005)</description>
    <mitre>
      <id>T1053.005</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,persistence,scheduled_task,</group>
  </rule>

  <!-- PowerShell Add-MpPreference ExclusionPath for Public\Documents — Defender exclusion -->
  <rule id="103507" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Add-MpPreference\s+.*ExclusionPath</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)Users\\Public\\Documents</field>
    <description>CryptoBandits: PowerShell adding Defender exclusion for Public\Documents path on $(agent.name) — USB worm evasion setup (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,defense_evasion,disable_defender,</group>
  </rule>

  <!-- File created in CryptoBandits 5-char staging directory pattern -->
  <rule id="103508" level="12">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)Users\\Public\\Documents\\[a-z]{4,6}\\[a-z]{4,6}\.(js|vbs|ps1|bat|cmd)$</field>
    <description>CryptoBandits: Malicious script staged in Public\Documents\[5char]\ directory on $(agent.name) — USB worm payload drop (T1027)</description>
    <mitre>
      <id>T1027</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,execution,</group>
  </rule>

  <!-- Correlation: ugate.exe + schtasks creation within 60s — high confidence CryptoBandits -->
  <rule id="103509" level="15" frequency="2" timeframe="60">
    <if_matched_sid>103503,103506</if_matched_sid>
    <same_field>agent.name</same_field>
    <description>CryptoBandits: Tor proxy (ugate.exe) AND scheduled task creation detected in 60s on $(agent.name) — high confidence USB LNK worm activity (T1090.003, T1053.005)</description>
    <mitre>
      <id>T1090.003</id>
      <id>T1053.005</id>
      <id>T1091</id>
    </mitre>
    <group>cryptobandits,command_and_control,persistence,high_fidelity,correlation,</group>
  </rule>

  <!-- .lnk file replacing document file in a removable drive path -->
  <rule id="103510" level="11">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\.(doc|docx|xlsx|xls|pdf|pptx?|txt)\.lnk$</field>
    <description>USB Worm: LNK file created masquerading as document extension on $(agent.name) — possible USB LNK worm file replacement (T1091, T1036)</description>
    <mitre>
      <id>T1091</id>
      <id>T1036</id>
    </mitre>
    <group>usb_worm,initial_access,</group>
  </rule>

  <!-- SOCKS5 on localhost:9050 — Tor proxy configured by ugate.exe -->
  <rule id="103511" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ugate\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(--socks5|9050|localhost.*9050|127\.0\.0\.1.*9050)</field>
    <description>CryptoBandits: ugate.exe Tor SOCKS5 proxy configured on localhost:9050 — all C2 traffic tunneled via Tor (T1090.003)</description>
    <mitre>
      <id>T1090.003</id>
    </mitre>
    <group>cryptobandits,tor_proxy,command_and_control,</group>
  </rule>



<!-- =============================================================
     SECTION 3: WhatsApp VBScript / ManageEngine RMM Campaign
     T1059.005 / T1548.002 / T1219 / T1105
     Rules: 103512-103520
     Chinese-linked actor; VBScript phishing via WhatsApp;
     ManageEngine Endpoint Central deployed as RMM backdoor
     C2 server: 202.61.160.201 (ValleyRAT/Gh0st RAT infra)
     ============================================================= -->



  <!-- VBScript execution from Downloads or AppData user-writable paths -->
  <rule id="103512" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(wscript|cscript)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\.(vbs|vbe)\s</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\\Downloads\\|\\AppData\\(Roaming|Local)\\|\\Desktop\\|\\Temp\\)</field>
    <description>WhatsApp VBScript campaign: VBScript executed from user-writable path on $(agent.name) — possible WhatsApp lure execution (T1059.005)</description>

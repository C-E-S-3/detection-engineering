<!-- ============================================================
     Threat Intelligence Detection Rules  - 2026-06-24 Batch 5
     Sources:
       - AryStinger: D-Link/NAS router botnet  - XLab Qianxin June 2026
         C2: eixfi.ajb8.com / 107.150.106.14; CVE-2013-3307, CVE-2016-5681
         Converts infected devices into SOCKS5 proxies / scanning nodes
       - Icarus (ShinyHunters/UNC6240): Klue OAuth -> Salesforce CRM breach
         4 attacker IPs; Python-urllib automation; bulk CRM exfiltration
         Victims: Huntress, Recorded Future, Tanium, Jamf, and hundreds more

     Rule IDs: 103541-103557
     Author: SecOps Purple Team
     Date: 2026-06-24

     MITRE ATT&CK Coverage:
       T1190   Exploit Public-Facing Application (AryStinger CVEs)
       T1601   Modify System Image (dropbear/gs-netcat on routers)
       T1090   Proxy (AryStinger SOCKS5 tunneling infrastructure)
       T1071.001 Application Layer Protocol: Web (AryStinger C2 HTTP/S Protobuf+XOR)
       T1565   Data Manipulation (AryStinger DNS hijacking)
       T1040   Network Sniffing (AryStinger traffic monitoring)
       T1078.004 Valid Accounts: Cloud Accounts (Icarus OAuth theft)
       T1213   Data from Information Repositories (Icarus Salesforce CRM)
       T1530   Data from Cloud Storage Object (Icarus Salesforce REST API)
       T1567   Exfiltration Over Web Service (Icarus via Salesforce API)
       T1059.006 Command and Scripting Interpreter: Python (Icarus urllib automation)
     ============================================================ -->

<!-- ============================================================
     SECTION 1: AryStinger Botnet IOC Detection
     XLab Qianxin June 2026  - 4,000+ D-Link/NAS compromised devices
     C2: eixfi.ajb8.com / 107.150.106.14
     CVEs: CVE-2013-3307 (D-Link DIR-850L), CVE-2016-5681 (DIR-818LW),
           CVE-2025-11837 (NAS devices  - Go variant)
     TTPs: T1190, T1601, T1090, T1071.001, T1565, T1040
     Rules: 103541-103549
     ============================================================ -->

<group name="threat_intel,ioc_network,arystinger,botnet,icarus,klue_breach,">

  <!-- AryStinger primary propagation IP  - firewall block/allow log -->
  <rule id="103541" level="14">
    <if_group>firewall</if_group>
    <field name="data.dest_ip">^107\.150\.106\.14$</field>
    <description>IOC: Outbound to AryStinger botnet propagation IP (107.150.106.14) - detected March 2026 spreading 0-VT ELF payload via CVE-2013-3307/CVE-2016-5681 to D-Link DIR-850L/DIR-818LW routers (T1190, T1071.001)</description>
    <mitre>
      <id>T1190</id>
      <id>T1071.001</id>
    </mitre>
    <group>ioc_c2,arystinger,botnet,network_device,</group>
  </rule>

  <!-- AryStinger inbound from propagation IP (device under attack) -->
  <rule id="103542" level="13">
    <if_group>firewall</if_group>
    <field name="data.src_ip">^107\.150\.106\.14$</field>
    <description>IOC: Inbound from AryStinger botnet propagation IP (107.150.106.14) - active exploit attempt targeting network/NAS devices via CVE-2013-3307 or CVE-2016-5681 (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ioc_exploit,arystinger,botnet,inbound_attack,</group>
  </rule>

  <!-- AryStinger C2 domain DNS query via OPNsense Unbound -->
  <rule id="103543" level="14">
    <if_group>unbound,dns,</if_group>
    <field name="data.query" type="pcre2">(?i)eixfi\.ajb8\.com</field>
    <description>IOC: DNS query for AryStinger botnet C2 domain eixfi.ajb8.com - Protobuf+XOR C2 channel; /auth endpoint for device identity; converts hosts to SOCKS5 proxy nodes (T1071.001, T1090)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1090</id>
    </mitre>
    <group>ioc_c2,arystinger,botnet,dns,</group>
  </rule>

  <!-- AryStinger C2 domain via Suricata DNS EVE -->
  <rule id="103544" level="14">
    <if_sid>86601</if_sid>
    <field name="dns.query.rrname" type="pcre2">(?i)eixfi\.ajb8\.com</field>
    <description>Suricata: DNS lookup for AryStinger C2 domain eixfi.ajb8.com - botnet node calling home (T1071.001)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1090</id>
    </mitre>
    <group>ioc_c2,arystinger,botnet,suricata,dns,</group>
  </rule>

  <!-- Suricata: traffic to/from AryStinger IP -->
  <rule id="103545" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.dest_ip" type="pcre2">^107\.150\.106\.14$</field>
    <description>Suricata: Traffic to AryStinger botnet C2/propagation IP (107.150.106.14) - router/NAS compromise or scanning activity (T1190)</description>
    <mitre>
      <id>T1190</id>
      <id>T1071.001</id>
    </mitre>
    <group>ioc_c2,arystinger,botnet,suricata,</group>
  </rule>

  <!-- dropbear SSH server unexpectedly executed on Linux host  - AryStinger persistence -->
  <rule id="103546" level="13">
    <if_group>auditd,</if_group>
    <field name="audit.exe" type="pcre2">(?i)(dropbear|dropbearmulti)$</field>
    <description>AryStinger persistence: dropbear SSH server executed on $(agent.name) - lightweight SSH server installed by router/NAS botnet for persistent remote access (T1601, T1021.004)</description>
    <mitre>
      <id>T1601</id>
      <id>T1021.004</id>
    </mitre>
    <group>persistence,arystinger,botnet,dropbear,network_device,</group>
  </rule>

  <!-- gs-netcat execution  - alternative AryStinger persistence channel -->
  <rule id="103547" level="13">
    <if_group>auditd,</if_group>
    <field name="audit.exe" type="pcre2">(?i)gs-netcat$</field>
    <description>AryStinger persistence: gs-netcat executed on $(agent.name) - alternative persistent remote management channel used when dropbear is unavailable; associated with AryStinger botnet infrastructure (T1601, T1090)</description>
    <mitre>
      <id>T1601</id>
      <id>T1090</id>
    </mitre>
    <group>persistence,arystinger,botnet,tunnel,network_device,</group>
  </rule>

  <!-- AryStinger DNS hijacking: unexpected DNS config change on network device syslog -->
  <rule id="103548" level="12">
    <if_group>syslog,</if_group>
    <field name="data.hostname" type="pcre2">(?i)(opnsense|pfsense|router|gateway|nas|synology|qnap)</field>
    <field name="data.message" type="pcre2">(?i)(dns.*(server|resolv|hijack|redirect|spoof)|resolv\.conf.*writ|nameserver.*changed)</field>
    <description>AryStinger DNS hijacking: DNS configuration change detected on network device $(data.hostname) - AryStinger botnet tampers with router DNS to redirect victim browsing (T1565)</description>
    <mitre>
      <id>T1565</id>
      <id>T1071.001</id>
    </mitre>
    <group>arystinger,botnet,dns_hijack,network_device,</group>
  </rule>

  <!-- AryStinger correlation: IOC IP + DNS C2 combination (high confidence) -->
  <rule id="103549" level="15" frequency="2" timeframe="300">
    <if_matched_sid>103541,103543,103544,103545</if_matched_sid>
    <description>AryStinger CORRELATION: Multiple IOC signals (IP + DNS) within 5 minutes - $(agent.name) may be compromised AryStinger botnet node or actively being exploited (T1190, T1090)</description>
    <mitre>
      <id>T1190</id>
      <id>T1090</id>
      <id>T1071.001</id>
    </mitre>
    <group>ioc_c2,arystinger,botnet,correlation,high_fidelity,</group>
  </rule>




<!-- ============================================================
     SECTION 2: Icarus Extortion / Klue OAuth / Salesforce CRM Breach
     Datadog Security Labs + Huntress, June 2026
     Attacker: Icarus (possibly ShinyHunters / UNC6240)

    <description>IOC: Traffic from Icarus extortion group IP (138.226.246.94) - observed in Salesforce RestApi audit logs during Klue OAuth supply chain CRM exfiltration; Icarus/ShinyHunters (T1078.004, T1213)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1213</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,shinyhunters,extortion,</group>
  </rule>

  <rule id="103551" level="14">
    <if_group>firewall</if_group>
    <field name="data.src_ip">^212\.86\.125\.24$</field>
    <description>IOC: Traffic from Icarus extortion group IP (212.86.125.24) - Klue OAuth Salesforce CRM bulk exfiltration; Python-urllib/3.12 automation; Icarus/ShinyHunters (T1078.004, T1530)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1530</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,shinyhunters,extortion,</group>
  </rule>

  <rule id="103552" level="14">
    <if_group>firewall</if_group>
    <field name="data.src_ip">^213\.111\.148\.90$</field>
    <description>IOC: Traffic from Icarus extortion group IP (213.111.148.90) - Klue OAuth Salesforce CRM exfiltration; victims include Huntress Recorded Future Tanium; Icarus/ShinyHunters (T1078.004, T1567)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1567</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,shinyhunters,extortion,</group>
  </rule>

  <rule id="103553" level="14">
    <if_group>firewall</if_group>
    <field name="data.src_ip">^94\.154\.32\.160$</field>
    <description>IOC: Traffic from Icarus extortion group IP (94.154.32.160) - Klue OAuth Salesforce CRM exfiltration; Netherlands/France/Ukraine region; Icarus/ShinyHunters (T1078.004, T1567)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1567</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,shinyhunters,extortion,</group>
  </rule>

  <!-- Suricata: any of the 4 Icarus IPs -->
  <rule id="103554" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.src_ip" type="pcre2">^(138\.226\.246\.94|212\.86\.125\.24|213\.111\.148\.90|94\.154\.32\.160)$</field>
    <description>Suricata: Traffic from Icarus extortion group IP - Klue OAuth Salesforce CRM breach actor (ShinyHunters/UNC6240); June 2026 supply chain attack (T1078.004)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1567</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,suricata,shinyhunters,</group>
  </rule>

  <!-- Python-urllib user-agent in web/proxy logs  - Icarus exfiltration TTP -->
  <rule id="103555" level="11">
    <if_group>web,nginx,apache,traefik,</if_group>
    <field name="data.http_user_agent" type="pcre2">(?i)Python-urllib/3\.(1[2-9]|[2-9]\d)</field>
    <description>Icarus TTP: Python-urllib automation user-agent detected in web logs on $(agent.name) - matches exact user-agent (Python-urllib/3.12, /3.14) observed during Klue/Salesforce CRM bulk exfiltration (T1059.006, T1213)</description>
    <mitre>
      <id>T1059.006</id>
      <id>T1213</id>
    </mitre>
    <group>icarus,klue_breach,web_automation,python,data_exfiltration,</group>
  </rule>

  <!-- High-volume API requests from single IP in short window  - Icarus exfil pattern -->
  <rule id="103556" level="12" frequency="200" timeframe="900">
    <if_matched_group>web,nginx,apache,traefik,</if_matched_group>
    <same_srcip />
    <description>Icarus TTP: High-volume API request burst - 200+ requests in 15 minutes from same source IP (T1213, T1530) - matches Icarus exfiltration pattern of ~1,000 Salesforce API queries per 15-minute window</description>
    <mitre>
      <id>T1213</id>
      <id>T1530</id>
    </mitre>
    <group>icarus,klue_breach,api_abuse,data_exfiltration,</group>
  </rule>

  <!-- Icarus correlation: IOC IP + Python-urllib (high fidelity) -->
  <rule id="103557" level="15" frequency="2" timeframe="600">
    <if_matched_sid>103550,103551,103552,103553,103554,103555</if_matched_sid>
    <description>Icarus CORRELATION: Klue OAuth breach IOC IP + Python-urllib automation detected together within 10 minutes - high-fidelity signal for active Icarus/ShinyHunters CRM exfiltration (T1078.004, T1213)</description>
    <mitre>
      <id>T1078.004</id>
      <id>T1213</id>
      <id>T1567</id>
    </mitre>
    <group>ioc_c2,icarus,klue_breach,shinyhunters,correlation,high_fidelity,</group>
  </rule>

</group>

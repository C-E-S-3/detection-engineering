<!-- ============================================================
     TuxBot v3: LLM-Assisted IoT Botnet — Iranian-Nexus, SHA512 DGA, P2P C2
     MITRE ATT&CK Techniques:
       T1568.002 - Domain Generation Algorithms (SHA512-seeded DGA backup C2)
       T1573     - Encrypted Channel (TCP 2222 with SSH-2.0-CNC-Control-Server banner)
       T1071     - Application Layer Protocol (multi-protocol: TCP, DNS TXT, HTTP, P2P)
       T1498     - Network Denial of Service (DDoS capability)
       T1496     - Resource Hijacking (embedded XMR cryptominer)
     Rule IDs: 104089-104097
     Author: SecOps Engineer
     Date: 2026-07-21
     References:
       - Unit 42 (2026-07-15): unit42.paloaltonetworks.com/tuxbot-v3-evolution-iot-botnet/
       - threat-intel/2026-07-16_unit42-tuxbot-v3-llm-assisted-iot-botnet.md
     Attribution: Iranian-nexus (moderate confidence, Unit 42); Keksec/Kaitori IoT
                  botnet ecosystem overlap; developer domain hosted on Arvan Cloud CDN
     Log source prerequisites:
       - Firewall/network logs (firewall group) with data.dest_ip / data.src_ip
         Required for rules 104089-104091 (C2 IP and shared infra contacts)
       - OPNsense Unbound DNS logs (unbound,dns groups) with data.query
         Required for rule 104092 (DGA domain DNS lookup)
       - Suricata EVE JSON -> Wazuh SID 86601
         Required for rules 104093-104097 (Suricata network detections)
     Coverage notes:
       - Primary C2: 209.182.237.133 (Singapore; TCP 2222; SSH-2.0-CNC-Control-Server banner)
       - Shared infra: 185.10.68.127 (Keksec/TuxBot overlap; flagged malicious May 2026)
       - Dev domain: digikalas.online (Arvan Cloud CDN; leaked via Git log in TuxBot sample)
       - TCP 2222 is non-standard for legitimate IoT device egress — alert broadly on it
       - SHA512 DGA generates additional domains; block digikalas.online as known seed anchor
       - TuxBot targets IoT architectures: ARM, MIPS, MIPSEL, MIPS64, x86_64, PowerPC, RISC-V
     Severity tiers:
       14 - Direct connection to known TuxBot/Keksec C2 or shared infra IP (confirmed IOC)
       14 - DNS lookup for TuxBot developer domain digikalas.online (confirmed IOC)
       11 - Outbound TCP 2222 to any external host (non-standard; IoT C2 indicator)
     ============================================================ -->

<group name="threat_intel,ioc_network,tuxbot,iot_botnet,iranian_nexus,keksec,">

  <!-- ===========================================================
       Firewall: Outbound traffic to TuxBot v3 primary C2 IP
       Rule IDs: 104089-104091
       209.182.237.133 — TuxBot v3 primary C2 server in Singapore;
       TCP 2222 with SSH-2.0-CNC-Control-Server banner (Unit 42).
       185.10.68.127 — Shared infra with Keksec/Kaitori botnet ecosystem;
       flagged malicious May 2026 by threat intel feeds.
       Both IPs should be blocked at the perimeter; any outbound
       contact from a homelab host strongly indicates compromise.
       =========================================================== -->

  <!-- Outbound to TuxBot v3 primary C2 IP (firewall allow/block log) -->
  <rule id="104089" level="14">
    <if_group>firewall</if_group>
    <field name="data.dest_ip">^209\.182\.237\.133$</field>
    <description>IOC: TuxBot v3 C2 contact -- outbound to 209.182.237.133 (Singapore; TCP 2222; SSH-2.0-CNC-Control-Server; Iranian-nexus IoT botnet; T1573, T1071). Isolate host immediately. (Unit 42 2026-07-15)</description>
    <mitre>
      <id>T1573</id>
      <id>T1071</id>
    </mitre>
    <group>ioc_c2,tuxbot,iot_botnet,iranian_nexus,</group>
  </rule>

  <!-- Inbound from TuxBot v3 primary C2 IP (device being recruited/scanned) -->
  <rule id="104090" level="13">
    <if_group>firewall</if_group>
    <field name="data.src_ip">^209\.182\.237\.133$</field>
    <description>IOC: TuxBot v3 inbound from primary C2 IP 209.182.237.133 -- active exploit attempt or IoT device recruitment scan from Iranian-nexus botnet infrastructure (T1498, T1496). Block and investigate targeted hosts.</description>
    <mitre>
      <id>T1498</id>
      <id>T1496</id>
    </mitre>
    <group>ioc_c2,tuxbot,iot_botnet,iranian_nexus,inbound_scan,</group>
  </rule>

  <!-- Outbound to Keksec/TuxBot shared infra IP 185.10.68.127 -->
  <rule id="104091" level="14">
    <if_group>firewall</if_group>
    <field name="data.dest_ip">^185\.10\.68\.127$</field>
    <description>IOC: Contact with Keksec/TuxBot shared infrastructure IP 185.10.68.127 -- flagged malicious May 2026; overlaps with Keksec/Kaitori IoT botnet ecosystem and TuxBot v3 staging/relay (T1071, T1496). Isolate host immediately.</description>
    <mitre>
      <id>T1071</id>
      <id>T1496</id>
    </mitre>
    <group>ioc_c2,tuxbot,keksec,iot_botnet,iranian_nexus,</group>
  </rule>

  <!-- ===========================================================
       DNS: Lookup for TuxBot developer infrastructure domain
       Rule IDs: 104092-104093
       digikalas.online — developer domain leaked via Git log in a
       TuxBot v3 sample; hosted on Iran's Arvan Cloud CDN. Any DNS
       query for this domain from a homelab host indicates compromise
       or active TuxBot C2 communication (DNS TXT polling channel).
       =========================================================== -->

  <!-- OPNsense Unbound DNS: query for TuxBot developer domain -->
  <rule id="104092" level="14">
    <if_group>unbound,dns,</if_group>
    <field name="data.query" type="pcre2">(?i)digikalas\.online</field>
    <description>IOC: DNS query for TuxBot v3 developer domain digikalas.online -- hosted on Iran's Arvan Cloud CDN; leaked via Git log in TuxBot sample; possible DGA seed or DNS TXT C2 polling channel (T1568.002, T1071). Host likely compromised IoT device.</description>
    <mitre>
      <id>T1568.002</id>
      <id>T1071</id>
    </mitre>
    <group>ioc_c2,tuxbot,iot_botnet,dns,dga,iranian_nexus,</group>
  </rule>

  <!-- Suricata EVE: DNS lookup for TuxBot developer domain -->
  <rule id="104093" level="14">
    <if_sid>86601</if_sid>
    <field name="dns.query.rrname" type="pcre2">(?i)digikalas\.online</field>
    <description>Suricata: DNS lookup for TuxBot v3 developer domain digikalas.online -- Iranian-nexus IoT botnet SHA512 DGA seed domain or DNS TXT C2 channel; Arvan Cloud CDN hosted (T1568.002, T1071). Host likely TuxBot-infected IoT device.</description>
    <mitre>
      <id>T1568.002</id>
      <id>T1071</id>
    </mitre>
    <group>ioc_c2,tuxbot,iot_botnet,suricata,dns,dga,iranian_nexus,</group>
  </rule>

  <!-- ===========================================================
       Suricata: Network traffic to TuxBot IOC IPs
       Rule IDs: 104094-104095
       Alert on Suricata-observed traffic to either TuxBot IOC IP.
       Suricata sees both directions (src and dest), so a single
       rule per IP covers bidirectional activity.
       =========================================================== -->

  <!-- Suricata: traffic to/from TuxBot v3 primary C2 IP -->
  <rule id="104094" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.dest_ip" type="pcre2">^209\.182\.237\.133$</field>
    <description>Suricata: Traffic to TuxBot v3 C2 IP 209.182.237.133 (Singapore; TCP 2222; SSH-2.0-CNC-Control-Server banner; Iranian-nexus IoT botnet) -- host is TuxBot-infected or actively being recruited (T1573). Isolate and investigate.</description>
    <mitre>
      <id>T1573</id>
      <id>T1071</id>
    </mitre>
    <group>ioc_c2,tuxbot,iot_botnet,suricata,iranian_nexus,</group>
  </rule>

  <!-- Suricata: traffic to/from Keksec/TuxBot shared infra IP -->
  <rule id="104095" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.dest_ip" type="pcre2">^185\.10\.68\.127$</field>
    <description>Suricata: Traffic to Keksec/TuxBot shared infrastructure IP 185.10.68.127 -- flagged malicious May 2026; TuxBot v3 staging or relay node overlapping Keksec/Kaitori botnet ecosystem (T1071, T1496). Investigate source host immediately.</description>
    <mitre>
      <id>T1071</id>
      <id>T1496</id>
    </mitre>
    <group>ioc_c2,tuxbot,keksec,iot_botnet,suricata,iranian_nexus,</group>
  </rule>

  <!-- ===========================================================
       Firewall: Outbound TCP 2222 to external hosts
       Rule IDs: 104096-104097
       TCP 2222 is the TuxBot v3 C2 port. While port 2222 can be
       used for alternate SSH services, outbound TCP 2222 from IoT
       devices or homelab hosts to external IPs is abnormal and
       warrants investigation. This rule is broader than the IOC-
       specific rules above and may catch DGA-resolved C2 domains.
       TuxBot also presents SSH banner SSH-2.0-CNC-Control-Server
       on port 2222 — a highly specific IoT botnet indicator.
       =========================================================== -->

  <!-- Firewall: outbound TCP 2222 to any external IP -->
  <rule id="104096" level="11">
    <if_group>firewall</if_group>
    <field name="data.dest_port">^2222$</field>
    <field name="data.direction" negate="yes" type="pcre2">(?i)^in(bound)?$</field>
    <description>Suspicious outbound TCP 2222 to $(data.dest_ip) -- non-standard port used by TuxBot v3 IoT botnet C2 server (SSH-2.0-CNC-Control-Server banner; 209.182.237.133). Legitimate IoT devices rarely initiate outbound TCP 2222. Investigate source host. (T1573, T1568.002)</description>
    <mitre>
      <id>T1573</id>
      <id>T1568.002</id>
    </mitre>
    <group>tuxbot,iot_botnet,non_standard_port,suspicious_egress,</group>
  </rule>

  <!-- Suricata: outbound TCP 2222 detected by IDS -->
  <rule id="104097" level="11">
    <if_sid>86601</if_sid>
    <field name="alert.dest_port" type="pcre2">^2222$</field>
    <description>Suricata: Outbound TCP 2222 from $(alert.src_ip) to $(alert.dest_ip) -- non-standard port associated with TuxBot v3 IoT botnet C2 (Iranian-nexus; primary C2 209.182.237.133). Verify if traffic targets known TuxBot IOC IPs; isolate if confirmed. (T1573)</description>
    <mitre>
      <id>T1573</id>
      <id>T1568.002</id>
    </mitre>
    <group>tuxbot,iot_botnet,suricata,non_standard_port,suspicious_egress,</group>
  </rule>

</group>

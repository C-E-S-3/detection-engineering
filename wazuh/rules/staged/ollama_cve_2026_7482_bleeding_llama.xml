<!-- ============================================================
     Ollama "Bleeding Llama" — CVE-2026-7482
     CVSS 9.1 CRITICAL — Unauthenticated Heap OOB Read / Memory Exfil
     MITRE ATT&CK:
       T1190  — Exploit Public-Facing Application
       T1552.001 — Unsecured Credentials: Credentials In Files (API key exfil)
       T1041  — Exfiltration Over C2 Channel (model push to attacker registry)
     Rule IDs: 103858-103863
     CISA KEV: Not yet listed (PoC public, 300K+ exposed servers)
     Author: SecOps Engineer (Purple Team)
     Date: 2026-07-13
     References:
       - https://nvd.nist.gov/vuln/detail/CVE-2026-7482
       - https://www.cyera.com/research/bleeding-llama-critical-unauthenticated-memory-leak-in-ollama
       - https://thehackernews.com/2026/05/ollama-out-of-bounds-read-vulnerability.html

     Vulnerability summary:
       CVE-2026-7482 "Bleeding Llama" is a heap out-of-bounds read in the
       GGUF model loader of Ollama (all versions before v0.17.1). An
       unauthenticated attacker sends a crafted GGUF file with manipulated
       tensor shape metadata to /api/create, causing Ollama to read beyond
       the intended heap buffer.

       Attack flow (three unauthenticated API calls):
         1. POST /api/create  — upload malicious GGUF, trigger OOB read
         2. POST /api/push    — push "model" to attacker-controlled registry;
                                response body contains leaked heap contents
                                (LLM API keys, system prompts, user messages,
                                AWS credentials embedded in env vars)

       Proof-of-concept is public. Patched in Ollama v0.17.1 (Feb 25, 2026)
       but release notes did not flag it as a security fix; many instances
       remain unpatched.

       ~175,000 Ollama instances publicly accessible without authentication.

     Log source prerequisites:
       Traefik reverse proxy access log (JSON) forwarded to Wazuh.
       JSON field names: RequestMethod, RequestPath, RequestHost,
       DownstreamStatus, ClientHost, request_header.Content-Length.
       Built-in Wazuh JSON decoder (decoded_as=json).

     Severity rationale:
       0   — Base anchor: POST /api/create (Ollama model creation, no alert alone)
       0   — Base anchor: POST /api/push (Ollama model push, no alert alone)
       11  — POST /api/create with large body (>500KB) — likely GGUF upload
       12  — POST /api/push returning 2xx — model data pushed to registry (possible exfil)
       14  — POST /api/create followed by POST /api/push within 10 min (attack chain)
       13  — 3+ distinct /api/create POSTs from same IP in 5 min (enumeration/probing)
     ============================================================ -->

<group name="initial_access,credential_access,ollama,cve_2026_7482,bleeding_llama,">

  <!-- ===========================================================
       Rule 103858: Base anchor — POST /api/create
       Ollama model creation endpoint. Used in legitimate model
       management AND as step 1 of the CVE-2026-7482 attack.
       Level 0: no alert; provides context for chaining.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103858" level="0">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/api/create\b</field>
    <description>Ollama: POST to /api/create from $(ClientHost) (base anchor) (CVE-2026-7482)</description>
    <group>ollama,api_access,cve_2026_7482,</group>
  </rule>

  <!-- ===========================================================
       Rule 103859: Base anchor — POST /api/push
       Ollama model push endpoint. In CVE-2026-7482 exploitation,
       pushing a model to an attacker-controlled registry leaks
       heap memory contents (API keys, credentials) in the response.
       Level 0: no alert; provides context for chaining.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103859" level="0">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/api/push\b</field>
    <description>Ollama: POST to /api/push from $(ClientHost) (base anchor) (CVE-2026-7482)</description>
    <group>ollama,api_access,cve_2026_7482,</group>
  </rule>

  <!-- ===========================================================
       Rule 103860: Large POST to /api/create (GGUF upload)
       The CVE-2026-7482 exploit requires uploading a malicious GGUF
       file. Legitimate Ollama model creation via the API typically
       uses a small JSON payload (model name + FROM directive).
       A large Content-Length on /api/create indicates a direct
       GGUF file upload consistent with the exploit payload.
       Level 11: unusual, warrants investigation.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103860" level="11">
    <if_sid>103858</if_sid>
    <field name="request_Content-Length" type="pcre2">^[1-9]\d{5,}$</field>
    <description>Ollama CVE-2026-7482: POST to /api/create with large body (&gt;100KB) from $(ClientHost) - possible malicious GGUF upload (Bleeding Llama step 1, T1190)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ollama,api_access,gguf_upload,cve_2026_7482,bleeding_llama,</group>
  </rule>

  <!-- ===========================================================
       Rule 103861: Successful POST to /api/push (model exfil)
       In the CVE-2026-7482 attack, POST /api/push to an
       attacker-controlled registry returns the leaked heap memory
       (API keys, credentials) in the push response stream.
       A 2xx response on /api/push means data was transmitted to
       the registry destination — potential credential exfiltration.
       Level 12: high concern; push to external registry is unusual.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103861" level="12">
    <if_sid>103859</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>Ollama CVE-2026-7482: POST /api/push returned $(DownstreamStatus) from $(ClientHost) to $(RequestHost) - model data pushed to registry; heap memory may have been exfiltrated (T1041, T1552.001)</description>
    <mitre>
      <id>T1190</id>
      <id>T1041</id>
      <id>T1552.001</id>
    </mitre>
    <group>ollama,api_access,exfiltration,model_push,cve_2026_7482,bleeding_llama,</group>
  </rule>

  <!-- ===========================================================
       Rule 103862: /api/create followed by /api/push — exploitation chain
       The documented CVE-2026-7482 attack is exactly two API calls:
         1. POST /api/create (upload malicious GGUF — rule 103858)
         2. POST /api/push   (push model to exfil heap — rule 103859)
       Both from the same source IP within 10 minutes is high-confidence
       Bleeding Llama exploitation. An attacker exfiltrating heap data
       (API keys, credentials) will complete both steps in quick succession.
       Level 14: near-certain active attack.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103862" level="14" timeframe="600">
    <if_matched_sid>103858</if_matched_sid>
    <if_sid>103859</if_sid>
    <same_field>ClientHost</same_field>
    <description>Ollama CVE-2026-7482 EXPLOITATION CHAIN: $(ClientHost) POST to /api/create then /api/push within 10 min - Bleeding Llama attack; heap memory (LLM API keys, credentials) likely exfiltrated to attacker registry (T1190/T1041); initiate incident response</description>
    <mitre>
      <id>T1190</id>
      <id>T1041</id>
      <id>T1552.001</id>
    </mitre>
    <group>ollama,exploitation_chain,credential_access,exfiltration,cve_2026_7482,bleeding_llama,critical,</group>
  </rule>

  <!-- ===========================================================
       Rule 103863: Multiple /api/create POSTs — enumeration/probing
       Repeated POST /api/create requests from the same source
       within 5 minutes suggest an attacker probing the endpoint
       with different GGUF payloads to find the heap offset or
       maximize the OOB read. Three or more attempts indicates
       automated exploitation tooling.
       Level 13: high concern.
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->
  <rule id="103863" level="13" frequency="3" timeframe="300">
    <if_matched_sid>103858</if_matched_sid>
    <same_field>ClientHost</same_field>
    <description>Ollama CVE-2026-7482: 3+ POST to /api/create from $(ClientHost) within 5 min - likely automated Bleeding Llama probing; GGUF payload enumeration in progress (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ollama,api_access,enumeration,scanner,cve_2026_7482,bleeding_llama,</group>
  </rule>

</group>

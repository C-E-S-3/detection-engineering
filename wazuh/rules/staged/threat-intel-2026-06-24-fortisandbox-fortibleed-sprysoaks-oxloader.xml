<!-- ==============================================================
     SECTION 1: CVE-2026-25089  - Fortinet FortiSandbox OS Command Injection
     T1190 (Exploit Public-Facing Application) / T1059.004 (Unix Shell)
     CVSS 9.8 Critical; unauthenticated network-based; not yet CISA KEV
     FG-IR-26-141; VNC start-feature JSON input second-order OS injection

     Detection approach:
       - Suricata IDS: POST to /json/api or /start-vnc endpoint with JSON body
         containing command-injection metacharacters (;, |, $(), ``, &)
       - Suricata: HTTP 500 burst from FortiSandbox management IP after crafted POST
       - Wazuh syslog: FortiSandbox system log unexpected process spawn
       - Correlation: probe pattern (rapid POSTs) from same source
     ============================================================== -->
<group name="threat_intel_2026_06_24,initial_access,exploit_pubfacing,fortisandbox,credential_access,defense_evasion,persistence,execution,supply_chain,">

  <!-- Rule 103600  - Suricata: POST to FortiSandbox VNC start API with injection metacharacters
       CVE-2026-25089 targets the VNC start feature at /json/api/v1/advanced-threat/start-vnc
       or similar path. Attacker sends crafted JSON with OS metacharacters in parameters.
       Level 13: unauthenticated CVSS 9.8 critical; direct RCE vector. -->
  <rule id="103600" level="13">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(CVE-2026-25089|fortisandbox.*vnc|FG-IR-26-141|start.vnc.*inject|fortisandbox.*command.inject)</field>
    <description>Suricata: FortiSandbox CVE-2026-25089 VNC API command injection attempt - unauthenticated RCE (T1190)</description>
    <mitre>
      <id>T1190</id>
      <id>T1059.004</id>
    </mitre>
    <group>ids,suricata,command_injection,fortisandbox,cve_2026_25089,</group>
  </rule>

  <!-- Rule 103601  - Suricata: generic POST to FortiSandbox management API with cmd injection chars
       Catches attacker POST requests to FortiSandbox JSON API endpoints containing
       OS command injection metacharacters: semicolons, pipe, backtick, $() substitution.
       Level 12: broad FortiSandbox API probe; lower confidence than explicit CVE sig. -->
  <rule id="103601" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(fortisandbox|ET WEB_SERVER.*fortisandbox)</field>
    <field name="alert.http.method" type="pcre2">^POST$</field>
    <description>Suricata: Unauthenticated POST to FortiSandbox API - possible CVE-2026-25089 probe (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ids,suricata,fortisandbox,cve_2026_25089,</group>
  </rule>

  <!-- Rule 103602  - Linux auditd: shell spawned by web service process (FortiSandbox exploitation)
       CVE-2026-25089 causes the web application to spawn unexpected child processes
       (sh, bash, id, whoami, curl) via command injection in VNC JSON input.
       auditd execve events capture the spawning process; ppid of a web server
       combined with an interactive shell exe indicates post-exploitation.
       Level 14: shell spawned by web service is near-confirmation of exploitation. -->
  <rule id="103602" level="14">
    <if_sid>100600</if_sid>
    <field name="audit.key">exec</field>
    <field name="audit.exe" type="pcre2">(?i)^/(bin|usr/bin)/(sh|bash|dash|curl|wget|python3?|perl|nc|ncat)$</field>
    <field name="hostname" type="pcre2">(?i)(fortisandbox|fsandbox)</field>
    <description>FortiSandbox: unexpected shell/tool $(audit.exe) executed on $(hostname) - possible CVE-2026-25089 web injection exploitation (T1059.004)</description>
    <mitre>
      <id>T1190</id>
      <id>T1059.004</id>
    </mitre>
    <group>linux,auditd,exploit,webshell,fortisandbox,cve_2026_25089,</group>
  </rule>

  <!-- Rule 103603  - Suricata: burst of HTTP 500 errors from FortiSandbox management
       Exploitation probing CVE-2026-25089 often produces rapid HTTP 500 responses
       as the server errors on invalid JSON payloads during parameter fuzzing.
       20+ 500-response alerts from same source in 60s = automated exploitation.
       Level 12: fuzzing pattern correlates with CVE-2026-25089 discovery phase. -->
  <rule id="103603" level="12" frequency="20" timeframe="60">
    <if_matched_sid>103601</if_matched_sid>
    <same_srcip></same_srcip>
    <description>FortiSandbox probe burst: 20+ POST requests in 60s from $(srcip) - automated CVE-2026-25089 exploitation scan (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ids,suricata,fortisandbox,scan,cve_2026_25089,</group>
  </rule>




<!-- ==============================================================
     SECTION 2: FortiBleed  - FortiGate Credential Harvesting Campaign
     T1040 (Network Sniffing) / T1078 (Valid Accounts) / T1003 (Credential Dump)
     Russian-speaking actors; 430k+ FortiGate devices targeted since Feb 2026
     SOCRadar intelligence, June 24, 2026

     TTPs observed:
       1. Credential spray against FortiGate SSL-VPN and admin interfaces
       2. Successful login from new IP -> deploy custom sniffer via DIAG SNIFFER
       3. Sniffer captures cleartext/session credentials from passing traffic
       4. Harvested credentials used for lateral movement

     Detection approach:
       - FortiGate syslog (CEF/keyvalue via Wazuh agent): auth failure bursts
       - FortiGate syslog: DIAG SNIFFER or packet-capture CLI command execution
       - FortiGate syslog: admin login from unusual source IP (new country)
       - Frequency: 10+ auth failures followed by single success from same IP
     ============================================================== -->

  <!-- Rule 103604  - FortiGate syslog: excessive admin authentication failures
       FortiBleed actors perform credential spraying against FortiGate admin
       GUI (port 443/8443) and SSL-VPN. 10+ failures in 120s is spray indicator.
       Level 10: credential spray; medium severity until success is confirmed. -->
  <rule id="103604" level="10" frequency="10" timeframe="120">
    <if_matched_sid>5503,5551</if_matched_sid>
    <same_srcip></same_srcip>
    <field name="data.product" type="pcre2">(?i)(fortigate|fortios|fortiproxy)</field>
    <description>FortiGate: 10+ authentication failures in 120s from $(srcip) - possible FortiBleed credential spray (T1078)</description>
    <mitre>
      <id>T1078</id>
      <id>T1110.003</id>
    </mitre>
    <group>authentication,brute_force,fortigate,fortibleed,</group>
  </rule>

  <!-- Rule 103605  - FortiGate syslog: DIAG SNIFFER command executed by admin
       Core FortiBleed TTP: after gaining admin access, attackers execute
       "diagnose sniffer packet" to capture network traffic and harvest credentials.
       The sniffer command appears in FortiGate event logs as subtype=system action.
       Level 14: sniffer deployment on a firewall is highly anomalous  - near-certain compromise. -->
  <rule id="103605" level="14">
    <if_sid>4716,4717</if_sid>
    <field name="data.logdesc" type="pcre2">(?i)(sniffer|packet.capture|diagnose.sniffer|diag.sniffer)</field>
    <field name="data.product" type="pcre2">(?i)(fortigate|fortios|fortiproxy)</field>
    <description>FortiGate: packet sniffer/DIAG SNIFFER executed by admin $(data.user) - FortiBleed network sniffing TTP (T1040)</description>
    <mitre>
      <id>T1040</id>
    </mitre>
    <group>network_sniffing,fortigate,fortibleed,critical,</group>
  </rule>

  <!-- Rule 103606  - Suricata: FortiGate sniffer keyword match in management session
       If traffic to FortiGate management ports includes "sniffer" or "packet-capture"
       in the HTTP body or CLI session stream, that is the FortiBleed sniffer deployment.
       Level 14: confirms FortiBleed network sniffing activity over management channel. -->
  <rule id="103606" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(FortiGate.*sniffer|FortiBleed|diagnose.sniffer.packet|ET POLICY.*fortigate.*sniffer)</field>
    <description>Suricata: FortiGate sniffer deployment pattern detected - FortiBleed campaign T1040</description>
    <mitre>
      <id>T1040</id>
    </mitre>
    <group>ids,suricata,network_sniffing,fortigate,fortibleed,</group>
  </rule>

  <!-- Rule 103607  - FortiGate syslog: admin login from new/unexpected source country
       FortiBleed actors log in to compromised FortiGate from Russian-speaking regions
       or tor/VPN exit nodes after obtaining credentials via spraying.
       Level 11: new-country login is a medium-high signal of FortiBleed compromise. -->
  <rule id="103607" level="11">
    <if_sid>5501</if_sid>
    <field name="data.product" type="pcre2">(?i)(fortigate|fortios|fortiproxy)</field>
    <field name="data.subtype" type="pcre2">(?i)(admin|system)</field>
    <field name="data.action" type="pcre2">(?i)(login|logon)</field>
    <field name="data.authproto" type="pcre2">(?i)(https|gui|ssh)</field>
    <description>FortiGate: admin login via $(data.authproto) by $(data.user) from $(data.srcip) - verify against known admin IPs (FortiBleed indicator T1078)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication,fortigate,fortibleed,</group>
  </rule>

  <!-- Rule 103608  - FortiBleed correlation: spray burst followed by admin login success
       Chained rule: if 103604 (brute force burst) fired against a FortiGate and
       then 103607 (admin login success) fires from the same source, high confidence
       the spray succeeded  - FortiBleed actor now has admin access.
       Level 15: successful compromise of FortiGate firewall is maximum severity. -->
  <rule id="103608" level="15" timeframe="300">
    <if_matched_sid>103604</if_matched_sid>
    <same_srcip></same_srcip>
    <if_sid>103607</if_sid>
    <description>FortiBleed CRITICAL: credential spray from $(srcip) succeeded - admin login confirmed after 10+ failures. FortiGate likely compromised (T1078/T1110)</description>
    <mitre>
      <id>T1078</id>
      <id>T1110.003</id>
    </mitre>
    <group>authentication,brute_force,fortigate,fortibleed,critical,</group>
  </rule>




<!-- ==============================================================
     SECTION 3: SprySOCKS  - China-Linked Cross-Platform Backdoor
     T1014 (Rootkit) / T1055 (Process Injection) / T1071.001 (C2 over Web)
     Previously Linux-only; June 2026 variant adds Windows kernel driver
     WIN_DRV: kernel driver for process/network concealment
     WIN_PLUS: userland variant; 30+ backdoor commands

     Detection approach:
       - Windows: kernel driver installation without valid vendor signature
       - Windows: driver-level process list suppression (missing known processes)
       - Linux: long-lived outbound TCP socket on unusual port from system process
       - Suricata: SprySOCKS custom C2 binary protocol patterns
     ============================================================== -->

  <!-- Rule 103609  - Windows: unsigned kernel driver installation via Sysmon event 4 (SprySOCKS WIN_DRV)
       SprySOCKS WIN_DRV installs a kernel driver with no valid code-signing cert
       to conceal processes and network connections from userland tools.
       Sysmon Event 4 (ServiceControl) or Sysmon Event 1 catching sc.exe creating
       a kernel driver service from a user-writeable path detects this behavior.
       Level 13: unsigned kernel driver from user path is highly anomalous. -->
  <rule id="103609" level="13">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^(1|4)$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(sc\.exe|cmd\.exe|powershell\.exe)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(type=\s*kernel|binPath.*\\(AppData|Temp|ProgramData|Users\\[^\\]+\\AppData).*\.sys)</field>
    <description>Windows: kernel driver service created from user-writeable path by $(win.eventdata.image) - SprySOCKS WIN_DRV rootkit indicator (T1014/T1543.003)</description>
    <mitre>
      <id>T1014</id>
      <id>T1543.003</id>
    </mitre>
    <group>windows,driver,rootkit,sprysoaks,</group>
  </rule>

  <!-- Rule 103610  - Suricata: SprySOCKS C2 protocol detection
       SprySOCKS uses a custom binary C2 protocol over TCP with a recognizable
       header structure. Suricata signatures match the binary magic bytes or
       connection characteristics (long-lived, beaconing interval, encrypted payload).
       Level 12: custom binary C2 protocol is strong backdoor indicator. -->
  <rule id="103610" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(SprySOCKS|WIN_DRV|WIN_PLUS|ET MALWARE.*China.*Backdoor|ET MALWARE.*SprySOCKS)</field>
    <description>Suricata: SprySOCKS China-linked backdoor C2 protocol detected - T1071.001 (T1014)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1014</id>
    </mitre>
    <group>ids,suricata,c2,sprysoaks,china_apt,</group>
  </rule>

  <!-- Rule 103611  - Linux: SprySOCKS long-lived outbound connection from system process
       Linux variant of SprySOCKS establishes persistent outbound TCP connections
       from processes that should not have external network access (system daemons).
       High port (>10000) outbound from init, systemd-journal, dbus, or similar daemons.
       Level 11: daemon with unexpected outbound connection; moderate confidence. -->
  <rule id="103611" level="11">
    <if_sid>100600</if_sid>
    <field name="audit.key">network_modifications</field>
    <field name="audit.syscall" type="pcre2">^connect$</field>
    <field name="audit.exe" type="pcre2">(?i)^/(usr/lib|lib/systemd|usr/sbin|sbin)/(systemd-journal|dbus-daemon|NetworkManager|cups|rsyslogd)</field>
    <description>Linux: system daemon $(audit.exe) made unexpected outbound connect() syscall - SprySOCKS Linux C2 indicator (T1071.001)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1014</id>
    </mitre>
    <group>linux,network,c2,sprysoaks,china_apt,</group>
  </rule>

  <!-- Rule 103612  - Windows: process with driver-level concealment characteristics
       SprySOCKS WIN_DRV hides processes by intercepting list enumeration.
       Detection: Wazuh process inventory (agent syscheck/rootcheck) flags
       discrepancy between process list from OS API and from /proc equivalent.
       Windows rootcheck detecting hidden processes is direct WIN_DRV indicator.
       Level 14: rootkit hiding processes from OS API is near-certain compromise. -->
  <rule id="103612" level="14">
    <if_sid>510,511,512</if_sid>
    <match>Hidden process</match>
    <description>Wazuh rootcheck: hidden process detected - SprySOCKS WIN_DRV kernel driver concealment or similar rootkit (T1014)</description>
    <mitre>
      <id>T1014</id>
      <id>T1055</id>
    </mitre>
    <group>rootkit,hidden_process,sprysoaks,</group>
  </rule>




<!-- ==============================================================
     SECTION 4: OXLOADER + CastleStealer Campaign (REF8372)
     T1204.001 (User Execution: Malicious Link) / T1555 (Credentials from Stores)
     Russian-speaking, financially motivated; Google Ads malvertising delivery
     OXLOADER: staged downloader in TEMP; obfuscated PowerShell
     CastleStealer: targets Chrome/Firefox credentials, crypto wallets, Telegram

     Detection approach:
       - Windows: process chain  - browser (Chrome/Edge/Firefox) download -> temp execution
       - Windows: CastleStealer credential path access (AppData\Local\Google\Chrome\User Data)
       - Windows: OXLOADER staging via multiple consecutive executable drops in TEMP
       - Suricata: OXLOADER C2 beaconing domain pattern
     ============================================================== -->

  <!-- Rule 103613  - Windows: executable spawned from TEMP after browser download
       OXLOADER is delivered via browser download (triggered by malicious Google Ad).
       The initial dropper lands in %TEMP% or %APPDATA% and immediately self-executes.
       Browser process (chrome.exe, msedge.exe, firefox.exe) is parent of TEMP executable.
       Level 11: browser spawning temp executables is suspicious but not exclusive to OXLOADER. -->
  <rule id="103613" level="11">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(chrome\.exe|msedge\.exe|firefox\.exe|brave\.exe|opera\.exe)</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(\\Temp\\|\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\)</field>
    <description>Windows: browser $(win.eventdata.parentImage) spawned executable from TEMP path - OXLOADER malvertising delivery indicator (T1204.001)</description>
    <mitre>
      <id>T1204.001</id>
      <id>T1566.002</id>
    </mitre>
    <group>windows,execution,browser,oxloader,castlestealer,</group>
  </rule>

  <!-- Rule 103614  - Windows: process accessing Chrome/Firefox credential databases
       CastleStealer reads browser credential stores to harvest saved passwords.
       Accessing Login Data, Cookies, or Web Data SQLite DBs from a non-browser process
       is the primary CastleStealer credential-harvest behavioral signal.
       Level 12: credential store access by unknown process is high confidence theft. -->
  <rule id="103614" level="12">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^(11|23)$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(Google\\Chrome\\User Data\\Default\\(Login Data|Cookies|Web Data)|Mozilla\\Firefox\\Profiles\\.*\.(db|sqlite)|Brave-Browser\\User Data\\Default\\Login Data)</field>
    <field name="win.eventdata.image" type="pcre2">(?i)^(?!.*(chrome|msedge|firefox|brave|opera|chromium|GoogleUpdate).exe)</field>
    <description>Windows: non-browser process $(win.eventdata.image) accessing browser credential database - CastleStealer credential theft (T1555.003)</description>
    <mitre>
      <id>T1555.003</id>
      <id>T1552.001</id>
    </mitre>
    <group>windows,credential_access,browser,castlestealer,oxloader,</group>
  </rule>

  <!-- Rule 103615  - Windows: crypto wallet path access by unknown process
       CastleStealer also targets cryptocurrency wallet files: Exodus, Electrum,
       MetaMask browser extension storage, and Telegram session files.
       Process reading wallet DB files from AppData is a CastleStealer indicator.
       Level 13: crypto wallet file access by non-wallet process = active theft. -->
  <rule id="103615" level="13">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^(11|23)$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(\\Exodus\\exodus\.wallet|\\Electrum\\wallets\\|\\MetaMask\\|\\Telegram Desktop\\tdata\\|\\Roaming\\Binance\\|\.wallet\.dat$)</field>
    <description>Windows: process $(win.eventdata.image) accessing crypto wallet or Telegram session file - CastleStealer active exfiltration (T1555)</description>
    <mitre>
      <id>T1555</id>
      <id>T1552.001</id>
    </mitre>
    <group>windows,credential_access,crypto,castlestealer,oxloader,</group>
  </rule>

  <!-- Rule 103616  - Windows: multiple staged executables dropped to TEMP in rapid succession
       OXLOADER stages additional payloads (CastleStealer and other modules) by
       dropping multiple executables to TEMP/APPDATA in quick succession.
       5+ new executable file creations in TEMP within 30 seconds = OXLOADER staging.
       Level 12: rapid multi-stage executable drop in TEMP is unusual and suspicious. -->
  <rule id="103616" level="12" frequency="5" timeframe="30">
    <if_matched_sid>103613</if_matched_sid>
    <same_dstip></same_dstip>
    <description>OXLOADER: 5+ executable drops in TEMP within 30s - multi-stage payload staging pattern (T1204.001)</description>
    <mitre>
      <id>T1204.001</id>
    </mitre>
    <group>windows,execution,oxloader,staged_payload,</group>
  </rule>

  <!-- Rule 103617  - Suricata: OXLOADER/CastleStealer C2 beaconing
       OXLOADER phones home to attacker C2 after installation; CastleStealer
       exfiltrates stolen data over HTTP/HTTPS to Russian-hosted infrastructure.
       Suricata ET MALWARE rules detect REF8372 campaign C2 patterns.
       Level 12: confirmed C2 from infected host. -->
  <rule id="103617" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(OXLOADER|CastleStealer|REF8372|ET MALWARE.*Russian.*stealer|ET MALWARE.*castlestealer)</field>
    <description>Suricata: OXLOADER/CastleStealer C2 beacon detected - REF8372 Russian info-stealer campaign (T1071.001)</description>
    <mitre>
      <id>T1071.001</id>
      <id>T1041</id>
    </mitre>
    <group>ids,suricata,c2,infostealer,oxloader,castlestealer,</group>
  </rule>




<!-- ==============================================================
     SECTION 5: NarwhalRAT / ScarCruft APT37  - North Korea
     T1566.001 (Phishing: Spearphishing Attachment) / T1204.002 (User Execution: Malicious File)
     T1547.009 (Boot/Logon Autostart: Shortcut Modification)
     North Korea-linked ScarCruft group; fake Microsoft Account security alerts
     Delivery: phishing email -> ZIP -> LNK -> mshta.exe -> PowerShell -> NarwhalRAT DLL
     Persistence: rundll32 launching DLL from AppData via Registry Run key

     Detection approach:
       - Windows: LNK file execution from ZIP extraction path (User\AppData\Downloads)
       - Windows: mshta.exe -> PowerShell download chain
       - Windows: rundll32 loading DLL from AppData with known NarwhalRAT argument
       - Windows: Registry Run key set to rundll32 AppData DLL (persistence)
     ============================================================== -->

  <!-- Rule 103618  - Windows: LNK shortcut execution from ZIP extraction directory
       NarwhalRAT delivery: victim opens ZIP archive containing LNK file disguised
       as Microsoft Account security notification PDF/document. LNK executes mshta.exe.
       LNK file in %USERPROFILE%\Downloads\ or %TEMP%\ executed by explorer.exe.
       Level 12: LNK from Downloads/Temp is common phishing delivery vector. -->
  <rule id="103618" level="12">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(mshta\.exe|wscript\.exe|cscript\.exe|cmd\.exe|powershell\.exe)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\.lnk|ShellExecute|\.hta)</field>
    <field name="win.eventdata.currentDirectory" type="pcre2">(?i)(\\Downloads\\|\\Temp\\|\\AppData\\Local\\Temp\\)</field>
    <description>Windows: suspicious LNK/HTA execution from Downloads/Temp by $(win.eventdata.image) - NarwhalRAT APT37 delivery (T1204.002)</description>
    <mitre>
      <id>T1204.002</id>
      <id>T1547.009</id>
    </mitre>
    <group>windows,execution,phishing,narwhalrat,apt37,</group>
  </rule>

  <!-- Rule 103619  - Windows: mshta.exe spawning PowerShell download (NarwhalRAT stage 2)
       After LNK executes mshta.exe, it runs an HTA script that launches PowerShell
       to download the NarwhalRAT DLL payload from attacker C2.
       mshta.exe -> powershell.exe with -enc or IEX(New-Object Net.WebClient).DownloadString
       is the characteristic NarwhalRAT stage-2 chain.
       Level 13: mshta -> PowerShell download is near-certain malicious payload delivery. -->
  <rule id="103619" level="13">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)mshta\.exe</field>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(DownloadString|DownloadFile|WebClient|IEX|Invoke-Expression|FromBase64String|-enc |-encodedcommand)</field>
    <description>Windows: mshta.exe spawned PowerShell downloader - NarwhalRAT APT37 stage-2 payload delivery (T1059.001/T1566.001)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1566.001</id>
    </mitre>
    <group>windows,execution,phishing,narwhalrat,apt37,north_korea,</group>
  </rule>

  <!-- Rule 103620  - Windows: rundll32 loading DLL from AppData (NarwhalRAT persistence)
       NarwhalRAT persists by writing a DLL to %APPDATA%\Roaming\[random]\ and
       configuring a Registry Run key to load it via rundll32.exe at logon.
       rundll32.exe executing a DLL from AppData\Roaming is the persistence indicator.
       Level 13: rundll32 from AppData is uncommon legitimate behavior; high confidence. -->
  <rule id="103620" level="13">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(AppData\\Roaming\\|AppData\\Local\\)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\.dll</field>
    <description>Windows: rundll32.exe loading DLL from AppData - NarwhalRAT APT37 persistence mechanism (T1547.009/T1055)</description>
    <mitre>
      <id>T1547.009</id>
      <id>T1055</id>
    </mitre>
    <group>windows,persistence,narwhalrat,apt37,north_korea,</group>
  </rule>

  <!-- Rule 103621  - Windows: Registry Run key set to rundll32 AppData DLL
       The persistence Registry key at HKCU\Software\Microsoft\Windows\CurrentVersion\Run
       pointing to rundll32.exe loading a DLL from AppData is written by NarwhalRAT
       as a startup persistence mechanism. Wazuh syscheck/registry monitoring detects this.
       Level 13: new Run key pointing to AppData DLL is strong persistence indicator. -->
  <rule id="103621" level="13">
    <if_sid>61603</if_sid>
    <field name="win.system.eventID" type="pcre2">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(HKCU|HKEY_CURRENT_USER)\\Software\\Microsoft\\Windows\\CurrentVersion\\Run</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(rundll32.*AppData.*\.dll|AppData.*rundll32)</field>
    <description>Windows: Registry Run key created pointing to rundll32/AppData DLL - NarwhalRAT APT37 logon persistence (T1547.001)</description>
    <mitre>
      <id>T1547.001</id>
      <id>T1547.009</id>
    </mitre>
    <group>windows,persistence,registry,narwhalrat,apt37,north_korea,</group>
  </rule>




<!-- ==============================================================
     SECTION 6: WordPress Supply Chain + Gravity SMTP CVE-2026-4020
     T1195.002 (Supply Chain Compromise: Software Supply Chain)  - ShapedPlugin
     T1552 (Unsecured Credentials)  - Gravity SMTP CVE-2026-4020 (CVSS 5.3)

     ShapedPlugin supply chain: backdoor in Product Slider Pro, Real Testimonials Pro,
     Smart Post Show Pro via Easy Digital Downloads update infrastructure (June 22, 2026).
     Backdoor: PHP callback to attacker C2 on plugin activation or update.

     Gravity SMTP CVE-2026-4020: unauthenticated GET to /wp-json/gravitysmtp/v1/settings
     returns plaintext SMTP credentials, API keys, and OAuth tokens without authentication.
     ~100,000 sites affected.

     Detection approach:
       - Web access log: unauthenticated GET to /wp-json/gravitysmtp/v1/settings (403 expected)
       - Suricata: Gravity SMTP API endpoint scan pattern
       - Suricata: ShapedPlugin C2 callback domain or PHP obfuscation pattern
       - PHP/Wazuh: WordPress plugin executing outbound HTTP from admin context
     ============================================================== -->

  <!-- Rule 103622  - Web log: unauthenticated access to Gravity SMTP settings API
       CVE-2026-4020 allows any unauthenticated HTTP GET to
       /wp-json/gravitysmtp/v1/settings to return all SMTP credentials and API keys.
       Web server access logs showing 200-response to this endpoint from non-admin IPs
       indicates exploitation of this credential exposure vulnerability.
       Level 12: credential API endpoint returning 200 to unauthenticated request = exploit. -->
  <rule id="103622" level="12">
    <if_sid>31103,31100,31102</if_sid>
    <url>/wp-json/gravitysmtp/v1/settings</url>
    <match>200</match>
    <description>Web: Gravity SMTP CVE-2026-4020 - unauthenticated GET to settings API returned 200 - credential exposure likely (T1552)</description>
    <mitre>
      <id>T1552</id>
      <id>T1190</id>
    </mitre>
    <group>web,wordpress,credential_exposure,gravity_smtp,cve_2026_4020,</group>
  </rule>

  <!-- Rule 103623  - Web log: scan for Gravity SMTP CVE-2026-4020 endpoint
       Attackers scanning for vulnerable Gravity SMTP installations probe
       /wp-json/gravitysmtp/v1/settings across large IP ranges, typically returning
       404 (not installed) or 200 (vulnerable). 10+ probes in 60s = scan.
       Level 10: scanning activity; lower severity as may not succeed. -->
  <rule id="103623" level="10" frequency="10" timeframe="60">
    <if_matched_sid>103622</if_matched_sid>
    <same_srcip></same_srcip>
    <description>Web: Gravity SMTP settings API probe burst (10+ in 60s) from $(srcip) - CVE-2026-4020 mass scanning T1190</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,wordpress,scan,gravity_smtp,cve_2026_4020,</group>
  </rule>

  <!-- Rule 103624  - Suricata: ShapedPlugin backdoor C2 callback detection
       Compromised ShapedPlugin plugins execute a PHP callback to attacker infrastructure
       when activated or when a plugin update is installed. Suricata detects the
       outbound HTTP POST from the WordPress server to the attacker C2 domain.
       Level 13: server-side outbound PHP callback is strong supply chain compromise indicator. -->
  <rule id="103624" level="13">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(ShapedPlugin.*backdoor|supply.chain.*WordPress|ET MALWARE.*WordPress.*plugin.*beacon|shapedplugin.*callback)</field>
    <description>Suricata: ShapedPlugin WordPress supply chain backdoor callback detected - C2 communication from compromised plugin (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1071.001</id>
    </mitre>
    <group>ids,suricata,supply_chain,wordpress,shapedplugin,c2,</group>
  </rule>

  <!-- Rule 103625  - Web: WordPress plugin PHP file modified outside expected update time
       Wazuh FIM (syscheck) monitoring WordPress plugin directories detects unexpected
       PHP file modifications. ShapedPlugin backdoor modifies plugin PHP files to add
       obfuscated callback code. File modification outside business hours / maintenance
       windows in the wp-content/plugins directory is a supply chain compromise indicator.
       Level 11: PHP file changes in plugins can be legitimate but warrant review. -->
  <rule id="103625" level="11">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">(?i)/wp-content/plugins/(product-slider-pro|real-testimonials-pro|smart-post-show-pro|wp-smart-post-show)/.*\.php$</field>
    <description>WordPress: ShapedPlugin plugin PHP file modified - $(file) - verify integrity; possible supply chain backdoor (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1505.003</id>
    </mitre>
    <group>fim,wordpress,supply_chain,shapedplugin,</group>
  </rule>

  <!-- Rule 103626  - Web: WordPress unauthenticated plugin update endpoint access
       ShapedPlugin's Easy Digital Downloads (EDD) update infrastructure was the
       delivery vector for the backdoored plugin updates. Attackers may also probe
       WordPress sites for EDD license-check endpoints to find vulnerable plugin versions.
       Level 10: plugin version enumeration; reconnaissance indicator. -->
  <rule id="103626" level="10">
    <if_sid>31103,31100,31102</if_sid>
    <url type="pcre2">(?i)/wp-json/(edd|easy-digital-downloads)/v1/(software-licensing|update-check|license)</url>
    <description>Web: WordPress EDD license/update check probed - possible ShapedPlugin supply chain pre-compromise reconnaissance (T1592)</description>
    <mitre>
      <id>T1592</id>
      <id>T1195.002</id>
    </mitre>
    <group>web,wordpress,reconnaissance,shapedplugin,supply_chain,</group>
  </rule>

</group>

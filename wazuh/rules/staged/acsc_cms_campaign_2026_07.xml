<!-- ============================================================
     ACSC CMS Exploitation Campaign - July 2026
     Multi-CVE WordPress and CMS Platform Webshell Deployment

     Advisory: Australian Cyber Security Centre (ACSC) 2026-07-11
     Campaign summary: Large-scale exploitation of CMS plugins deploying
     PHP webshells for persistent access, credential theft, and lateral
     movement. Campaign may be AI-assisted in exploit scaling.

     CVEs covered in this file:
       CVE-2026-0740  - Ninja Forms File Uploads <=3.3.26 (CVSS 9.8)
                        Unauthenticated arbitrary file upload -> RCE
       CVE-2026-1357  - WPvivid Backup <=0.9.123 (CVSS 9.8)
                        Predictable null-byte AES key bypass -> PHP upload -> RCE
       CVE-2026-31843 - pay-uz Laravel <=2.2.24 (CVSS 9.8)
                        Unauthenticated PHP payment hook overwrite -> RCE
       CVE-2025-32432 - Craft CMS 3.x/4.x/5.x (CVSS 10.0) [CISA KEV]
                        Unauthenticated code injection via asset transform (T1190)
       CVE-2026-1969  - ThemeREX Addons <2.38.5 (CVSS 5.3)
                        Incomplete fix for CVE-2024-13448; AJAX file upload bypass
       CVE-2025-7443  - BerqWP <2.1.3 (unauthenticated file upload)
       CVE-2025-7852  - WPBookit <1.6.9 (unauthenticated file upload -> RCE)
       CVE-2025-13486 - ACF Extended (arbitrary file upload via AJAX)

     Already covered separately:
       CVE-2026-3844  - Breeze Cache (PR #57, rules 103770-103779)
       CVE-2026-48907 - Joomla JCE (staged/joomla_jce_cve_2026_48907_php_upload_rce.xml)

     MITRE ATT&amp;CK:
       T1190     - Exploit Public-Facing Application (TA0001 Initial Access)
       T1505.003 - Server Software Component: Web Shell (TA0003 Persistence)
       T1059.004 - Command and Scripting Interpreter: Unix Shell (via webshell)
       T1078     - Valid Accounts (credential theft post-webshell)
       T1105     - Ingress Tool Transfer (secondary payload staging)

     Log source prerequisites:
       - Traefik access logs in JSON format forwarded to Wazuh.
         Fields: RequestMethod, RequestPath, DownstreamStatus, ClientHost,
         RequestHost (rules 103780-103796, 103799)
       - Wazuh FIM / syscheck enabled on CMS web root directories
         (rules 103797, 103798): parent rule 554 (file added to system)

     Rule IDs: 103780-103799
     Author: SecOps Engineer (Purple Team)
     Date: 2026-07-12
     ESKA: ESKA-457
     ============================================================ -->

<!-- ============================================================
     CVE-2026-0740: NINJA FORMS FILE UPLOADS - UNAUTHENTICATED RCE
     Rule IDs: 103780-103783
     Ninja Forms File Uploads plugin <=3.3.26; missing file type
     validation in NF_FU_AJAX_Controllers_Uploads::handle_upload.
     Unauthenticated attackers can upload arbitrary PHP files via
     the nf_fu_upload WordPress AJAX action.
     ============================================================ -->

<group name="initial_access,webshell,wordpress,ninja_forms,acsc_cms_campaign,">

  <!-- POST to Ninja Forms file upload AJAX action -->
  <rule id="103780" level="10">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?:wp-admin/admin-ajax\.php.*action=nf_fu_upload|wp-content/plugins/ninja-forms-uploads?/)</field>
    <description>ACSC CMS Campaign CVE-2026-0740: POST to Ninja Forms file upload AJAX action from $(ClientHost) to $(RequestHost)$(RequestPath) - unauthenticated upload attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,ninja_forms,cve_2026_0740,initial_access,file_upload,</group>
  </rule>

  <!-- Ninja Forms upload returned 2xx - file write likely succeeded -->
  <rule id="103781" level="14">
    <if_sid>103780</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>ACSC CMS Campaign CVE-2026-0740: Ninja Forms upload action returned 2xx to $(ClientHost) - unauthenticated file write CONFIRMED; PHP webshell may have been deployed (T1190/T1505.003)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505.003</id>
    </mitre>
    <group>wordpress,ninja_forms,cve_2026_0740,initial_access,file_upload,rce_success,</group>
  </rule>

  <!-- 5+ Ninja Forms upload probes from same IP in 60s - automated scanner -->
  <rule id="103782" level="12" frequency="5" timeframe="60">
    <if_matched_sid>103780</if_matched_sid>
    <same_field>ClientHost</same_field>
    <description>ACSC CMS Campaign CVE-2026-0740: 5+ Ninja Forms upload probes from $(ClientHost) in 60s - automated mass-scanning for CVE-2026-0740 (T1190)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,ninja_forms,cve_2026_0740,scanner,initial_access,</group>
  </rule>

  <!-- Webshell command execution in Ninja Forms upload path -->
  <rule id="103783" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">wp-content/uploads/nf-uploads/.*\.ph(?:p\d?|tml).*(?:cmd=|exec=|shell=|c=|command=|system=|passthru=|eval=)</field>
    <description>ACSC CMS Campaign CVE-2026-0740: Command execution parameter in Ninja Forms upload directory from $(ClientHost) - WEBSHELL ACTIVE; PHP backdoor executing commands (T1505.003/T1059.004)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1059.004</id>
    </mitre>
    <group>wordpress,ninja_forms,cve_2026_0740,webshell,execution,high_confidence,</group>
  </rule>

</group>


<!-- ============================================================
     CVE-2026-1357: WPVIVID BACKUP - PREDICTABLE KEY BYPASS -> RCE
     Rule IDs: 103784-103787
     WPvivid Backup <=0.9.123; AES decryption failure falls through
     to null-byte key, allowing attacker to predict encryption and
     upload malicious PHP to publicly accessible directories via
     the wpvivid_action=send_to_site AJAX handler.
     ============================================================ -->

<group name="initial_access,webshell,wordpress,wpvivid,acsc_cms_campaign,">

  <!-- POST to WPvivid send_to_site action - crypto bypass upload vector -->
  <rule id="103784" level="11">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">wp-admin/admin-ajax\.php.*wpvivid_action=send_to_site</field>
    <description>ACSC CMS Campaign CVE-2026-1357: POST to WPvivid send_to_site AJAX action from $(ClientHost) to $(RequestHost)$(RequestPath) - predictable AES key bypass upload attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,cve_2026_1357,initial_access,file_upload,</group>
  </rule>

  <!-- WPvivid send_to_site returned 2xx - PHP file write succeeded -->
  <rule id="103785" level="14">
    <if_sid>103784</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>ACSC CMS Campaign CVE-2026-1357: WPvivid send_to_site returned 2xx to $(ClientHost) - unauthenticated PHP file write CONFIRMED via null-byte AES bypass (T1190/T1505.003)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505.003</id>
    </mitre>
    <group>wordpress,wpvivid,cve_2026_1357,initial_access,rce_success,file_upload,high_confidence,</group>
  </rule>

  <!-- 3+ WPvivid send_to_site probes in 60s - automated exploitation attempt -->
  <rule id="103786" level="12" frequency="3" timeframe="60">
    <if_matched_sid>103784</if_matched_sid>
    <same_field>ClientHost</same_field>
    <description>ACSC CMS Campaign CVE-2026-1357: 3+ WPvivid send_to_site requests from $(ClientHost) in 60s - automated CVE-2026-1357 exploitation attempt (T1190)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,cve_2026_1357,scanner,initial_access,</group>
  </rule>

  <!-- PHP file created in WPvivid staging directory (FIM) -->
  <rule id="103787" level="15">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">wp-content/(?:uploads/wpvivid|backups/wpvivid|cache/wpvivid)/.*\.ph(?:p\d?|tml)$</field>
    <description>ACSC CMS Campaign CVE-2026-1357: PHP file created in WPvivid directory $(file) - WEBSHELL DROP via null-byte AES bypass; investigate immediately (T1505.003)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,cve_2026_1357,webshell,persistence,syscheck_file,high_confidence,</group>
  </rule>

</group>


<!-- ============================================================
     CVE-2026-31843: PAY-UZ LARAVEL - UNAUTHENTICATED PHP OVERWRITE
     Rule IDs: 103788-103790

<!-- ============================================================
     CVE-2025-32432: CRAFT CMS - UNAUTHENTICATED CODE INJECTION
     Rule IDs: 103791-103794
     Craft CMS 3.0-3.9.14, 4.0-4.14.14, 5.0-5.6.16 (CVSS 10.0)
     CISA KEV (added 2026-03-20). CWE-94 code injection via the
     image transform/asset action controller. Extends CVE-2023-41892.
     Unauthenticated attackers inject PHP code via crafted POST
     to Craft action controllers with template/transform parameters.
     ============================================================ -->

<group name="initial_access,webshell,craft_cms,acsc_cms_campaign,">

  <!-- POST to Craft CMS action controller endpoint - base anchor -->
  <rule id="103791" level="10">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)(?:/actions/assets/(?:generate-transform|edit-image|save-asset)|/index\.php\?(?:p=|action=)(?:admin/)?actions/assets/|/actions/app/migrate)</field>
    <description>ACSC CMS Campaign CVE-2025-32432: POST to Craft CMS asset action controller from $(ClientHost) to $(RequestHost)$(RequestPath) - potential code injection probe (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>craft_cms,cve_2025_32432,initial_access,exploit_pubfacing,</group>
  </rule>

  <!-- Craft CMS action with PHP code injection pattern in path/query -->
  <rule id="103792" level="13">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/actions/.*?(?:transforms?\[|__class__|phpinfo|system\(|passthru|eval\(|base64_decode|assert\(|preg_replace.*[/e])</field>
    <description>ACSC CMS Campaign CVE-2025-32432: Craft CMS action path contains PHP code injection pattern from $(ClientHost) to $(RequestHost)$(RequestPath) - active exploit attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>craft_cms,cve_2025_32432,initial_access,exploit_pubfacing,code_injection,high_confidence,</group>
  </rule>

  <!-- Craft CMS action controller returned 2xx - injection may have executed -->
  <rule id="103793" level="14">
    <if_sid>103791</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>ACSC CMS Campaign CVE-2025-32432: Craft CMS asset action returned 2xx to $(ClientHost) - code injection payload acknowledged; correlate with webshell file creation on host (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>craft_cms,cve_2025_32432,initial_access,rce_success,high_confidence,</group>
  </rule>

  <!-- PHP file created in Craft CMS public web directories (FIM) -->
  <rule id="103794" level="15">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?:web|public|public_html|webroot|htdocs)/(?:cpresources|uploads|assets|files|images)/.*\.ph(?:p\d?|tml)$</field>
    <description>ACSC CMS Campaign CVE-2025-32432: PHP file created in Craft CMS public resource directory $(file) - WEBSHELL DEPLOYED; initiate immediate incident response (T1505.003)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1190</id>
    </mitre>
    <group>craft_cms,cve_2025_32432,webshell,persistence,syscheck_file,high_confidence,</group>
  </rule>

</group>


<!-- ============================================================
     ACSC CMS CAMPAIGN - ADDITIONAL WORDPRESS PLUGIN EXPLOITS
     Rule IDs: 103795-103799
     Covers additional CVEs from ACSC advisory targeting WordPress:
       CVE-2026-1969  - ThemeREX Addons <2.38.5 (CVSS 5.3)
                        AJAX file upload bypass (incomplete fix)
       CVE-2025-7443  - BerqWP (unauthenticated file upload)
       CVE-2025-7852  - WPBookit (unauthenticated file upload -> RCE)
       CVE-2025-13486 - ACF Extended (arbitrary file upload via AJAX)
     Plus generic campaign-level patterns for webshell activation.
     ============================================================ -->

<group name="initial_access,webshell,wordpress,acsc_cms_campaign,">

  <!-- ThemeREX Addons CVE-2026-1969: AJAX upload bypass -->
  <rule id="103795" level="11">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">wp-admin/admin-ajax\.php.*action=(?:trx_addons_(?:upload|ajax)|acfe_ajax_upload|berqwp_(?:upload|ajax)|wpbookit_(?:upload|ajax)|nf_fu_)</field>
    <description>ACSC CMS Campaign: POST to vulnerable WordPress plugin upload AJAX action (ThemeREX/BerqWP/WPBookit/ACF Extended) from $(ClientHost) to $(RequestHost)$(RequestPath) - unauthenticated file upload attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,cve_2026_1969,acsc_cms_campaign,initial_access,file_upload,</group>
  </rule>

  <!-- Plugin upload action returned 2xx - file write succeeded -->
  <rule id="103796" level="14">
    <if_sid>103795</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>ACSC CMS Campaign: WordPress plugin upload action returned 2xx to $(ClientHost) - unauthenticated file write SUCCEEDED; PHP webshell likely deployed (T1190/T1505.003)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505.003</id>
    </mitre>
    <group>wordpress,acsc_cms_campaign,initial_access,rce_success,file_upload,high_confidence,</group>
  </rule>

  <!-- Generic: PHP file accessed in WordPress uploads dir with shell params -->
  <rule id="103797" level="14">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">wp-content/uploads/.*\.ph(?:p\d?|tml).*(?:cmd=|exec=|shell=|c=|command=|system=|passthru=|eval=|run=|op=)</field>
    <description>ACSC CMS Campaign: Webshell command execution parameter in wp-content/uploads PHP path from $(ClientHost) to $(RequestHost)$(RequestPath) - active webshell executing commands (T1505.003/T1059.004)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1059.004</id>
    </mitre>
    <group>wordpress,webshell,execution,acsc_cms_campaign,high_confidence,</group>
  </rule>

  <!-- Generic: PHP/PHTML file created in CMS upload directories (FIM) -->
  <rule id="103798" level="13">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?:wp-content/uploads|wp-content/cache|wp-content/themes/[^/]+|wp-content/plugins/[^/]+/tmp)/.*\.ph(?:p\d?|tml)$</field>
    <description>ACSC CMS Campaign: PHP file created in WordPress upload/cache/plugin directory $(file) - potential webshell deployment matching ACSC July 2026 campaign pattern (T1505.003)</description>
    <mitre>
      <id>T1505.003</id>
      <id>T1105</id>
    </mitre>
    <group>wordpress,webshell,persistence,syscheck_file,acsc_cms_campaign,</group>
  </rule>

  <!-- Multi-CVE scanner: requests to multiple CMS exploit endpoints in 120s -->
  <rule id="103799" level="13" frequency="3" timeframe="120">
    <if_matched_group>acsc_cms_campaign,initial_access,</if_matched_group>
    <same_field>ClientHost</same_field>
    <description>ACSC CMS Campaign: 3+ CMS exploit endpoint requests from $(ClientHost) in 120s across multiple plugin targets - automated mass-exploitation campaign matching ACSC July 2026 advisory (T1190)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,acsc_cms_campaign,scanner,initial_access,multi_cve,</group>
  </rule>

</group>

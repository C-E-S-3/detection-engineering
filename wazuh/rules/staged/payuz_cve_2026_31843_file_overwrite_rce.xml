<!-- ============================================================
     pay-uz Laravel — Unauthenticated PHP File Overwrite RCE
     CVE-2026-31843 — CVSS 9.8 CRITICAL
     MITRE ATT&amp;CK:
       T1190     — Exploit Public-Facing Application
       T1505.003 — Server Software Component: Web Shell
       T1059.004 — Command and Scripting Interpreter: Unix Shell
     Rule IDs: 103801–103805
     ACSC CMS Campaign Advisory: 2026-07-11
     Author: SecOps Engineer (Purple Team) — ESKA-457
     Date: 2026-07-12
     References:
       - https://nvd.nist.gov/vuln/detail/CVE-2026-31843

     Vulnerability summary:
       CVE-2026-31843 is an unauthenticated PHP file overwrite vulnerability in
       the pay-uz Laravel payment gateway package (version ≤2.2.24, CVSS 9.8).
       The pay-uz plugin exposes API endpoints (/api/payuz/ or /payuz/) without
       authentication enforcement. A vulnerable endpoint accepts arbitrary file
       path and content parameters, allowing attackers to overwrite existing PHP
       files on the server (config files, view templates, or controllers) with
       attacker-controlled PHP code. Unlike file upload CVEs, CVE-2026-31843
       overwrites existing legitimate PHP files rather than creating new ones,
       evading simple "new file" detection heuristics. Any subsequent HTTP
       request that causes Laravel to include the overwritten file triggers RCE
       under the web server process.

       Part of ACSC advisory 2026-07-11 large-scale CMS exploitation campaign.

     Log source prerequisites:
       - Traefik access log in JSON format forwarded to Wazuh
       - Built-in Wazuh JSON decoder (decoded_as=json)
       - JSON field names follow Traefik defaults:
           RequestPath, RequestMethod, RequestHost, DownstreamStatus,
           ClientHost

     Detection note:
       CVE-2026-31843 exploits the POST body to deliver file content; this
       is not visible in Traefik access logs. Rules 103801-103802 detect
       the exploit attempt via URL path and response code. Rules 103803-103805
       detect post-exploitation indicators (PHP execution in storage paths)
       that apply regardless of whether the exploit used this CVE or another.

     Severity rationale:
       0  — Base anchor (no alert; used for chaining)
       13 — POST to pay-uz file-write endpoint (exploit attempt)
       15 — File-write endpoint returned 2xx (PHP file overwrite confirmed)
       15 — PHP file accessed in Laravel public/storage path (overwritten file executing)
       15 — Webshell command parameter in Laravel public/storage PHP file (active RCE)
       13 — 3+ rapid pay-uz API probes from same IP (automated exploit tool)
     ============================================================ -->

<group name="initial_access,exploit_pubfacing,laravel,payuz,webshell,cve_2026_31843,">

  <!-- ===========================================================
       T1190 — Exploit Public-Facing Application
       Rules 103801–103805: pay-uz file overwrite RCE detection
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->

  <!-- Base anchor: POST to pay-uz API routes.
       pay-uz registers routes under /api/payuz/ or /payuz/ in Laravel
       applications. CVE-2026-31843 exploits a sub-route within this namespace
       that accepts file path/content parameters without authentication.
       Level 0: no alert — used for chaining only. -->
  <rule id="103801" level="0">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/(?:api/)?pay(?:-|_)?uz/</field>
    <description>pay-uz: POST to pay-uz Laravel API route from $(ClientHost) (base anchor) (CVE-2026-31843)</description>
    <group>laravel,payuz,initial_access,cve_2026_31843,</group>
  </rule>

  <!-- POST to pay-uz file-write or configuration endpoint.
       The vulnerable endpoint is a sub-route of the pay-uz namespace that
       handles file content — typically a callback, config, or update handler.
       These route names are not part of the normal payment processing flow
       (payment routes use /payment, /process, /checkout).
       Level 13: high-confidence exploit attempt — non-payment route targeted. -->
  <rule id="103802" level="13">
    <if_sid>103801</if_sid>
    <field name="RequestPath" type="pcre2">(?i)/(?:callback|notify|webhook|config|update|file|write|install|setup|upload|settings)/</field>
    <description>pay-uz CVE-2026-31843: POST to pay-uz file-write/config endpoint from $(ClientHost) to $(RequestHost)$(RequestPath) — unauthenticated PHP file overwrite exploitation attempt; config or view file likely overwritten (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>laravel,payuz,initial_access,exploit_pubfacing,cve_2026_31843,</group>
  </rule>

  <!-- File-write endpoint returned 2xx — PHP overwrite confirmed.
       A 2xx response from the pay-uz file-write endpoint confirms the
       overwrite request was accepted and a PHP file was modified. Any
       subsequent request including that file path triggers RCE.
       Level 15: file overwrite confirmed — incident response required. -->
  <rule id="103803" level="15">
    <if_sid>103801</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>pay-uz CVE-2026-31843: pay-uz API returned $(DownstreamStatus) to $(ClientHost) — PHP file overwrite CONFIRMED at $(RequestHost); any subsequent PHP include may trigger RCE; initiate incident response (T1190/T1505.003)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505</id>
    </mitre>
    <group>laravel,payuz,initial_access,exploit_pubfacing,webshell,upload_success,cve_2026_31843,critical,</group>
  </rule>

  <!-- PHP file accessed in Laravel public/storage path.
       CVE-2026-31843 overwrites PHP files in the Laravel webroot or
       public/storage/ (symlink to storage/app/public/). A request to a
       PHP file in these directories is anomalous — Laravel does not place
       executable PHP files in public/storage/ by design.
       Level 15: T1505.003 — overwritten PHP file executing. -->
  <rule id="103804" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:public/storage|storage/app/public|public/payuz)/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>pay-uz CVE-2026-31843: PHP file accessed in Laravel public/storage path from $(ClientHost) to $(RequestHost)$(RequestPath) — PHP files should not exist in Laravel storage; likely PHP file overwrite via CVE-2026-31843 executing (T1505.003)</description>
    <mitre>
      <id>T1505</id>
      <id>T1190</id>
    </mitre>
    <group>laravel,payuz,webshell,post_exploitation,cve_2026_31843,critical,</group>
  </rule>

  <!-- Webshell command parameter in Laravel public/storage PHP file.
       After overwriting a PHP file with a webshell, the attacker activates
       it by sending OS command parameters to the overwritten file's URL.
       Level 15: T1059.004 — active command execution via overwritten file. -->
  <rule id="103805" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:public|storage)/.*\.ph(?:p[3-8]?|tml).*(?:cmd=|command=|exec=|shell=|c=|run=|system=|pass=|passwd=)</field>
    <description>pay-uz CVE-2026-31843: webshell command parameter in Laravel public/storage path $(RequestPath) from $(ClientHost) — active command execution via overwritten PHP file (T1059.004/T1505.003); initiate incident response</description>
    <mitre>
      <id>T1059</id>
      <id>T1505</id>
    </mitre>
    <group>laravel,payuz,webshell,execution,post_exploitation,cve_2026_31843,critical,</group>
  </rule>

</group>

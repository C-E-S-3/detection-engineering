<!-- ============================================================
     Threat Intelligence Detection Rules  - 2026-06-24 Batch 7
     Sources:
       - CVE-2026-41089: Windows Netlogon Stack-Based Buffer Overflow RCE (CVSS 9.8 Critical)
         0-click unauthenticated RCE on domain controllers; actively exploited June 2026
         Affected: Windows Server 2012 R2 through 2025 (all currently supported)
         Patched: Microsoft May 2026 Patch Tuesday (KB5058386 family)
         Reports: BleepingComputer 2026-06-01, Help Net Security 2026-06-01, CCB warning

       - Cordyceps CI/CD Supply Chain Vulnerability (June 24, 2026)
         Novee Security disclosure; class of CI/CD workflow misconfigurations allowing
         unauthenticated attackers to hijack GitHub Actions via crafted PR comments/branches
         Affected: 300+ high-impact GitHub repos (Microsoft, Google, Apache, Cloudflare)
         No single CVE; systemic pattern: excessive PR permissions triggering privileged workflows
         Reports: The Hacker News 2026-06-24, SecurityWeek 2026-06-24

       - CVE-2025-48595: Android Framework Integer Overflow LPE (CISA KEV, June 2, 2026)
         Local privilege escalation via malicious intent; CVSS High
         Affected: Android 14, 15, 16 (unpatched pre-June 2026 Security Update)
         Limited targeted exploitation; pattern consistent with commercial spyware
         Fixed: Android June 2026 Security Update (2026-06-05 patch level)

       - CVE-2026-7473: Arista EOS Incomplete Tunnel Decapsulation (CISA KEV, June 9, 2026)
         CVSS 6.9; no patch planned; mitigation via ACLs only
         Affected: Arista 7020R, 7280R/R2, 7500R/R2 (VXLAN/GRE/decap-group configs)
         Attacker can inject traffic by sending unexpected tunneled packets to configured IPs
         Reports: SecurityWeek "No Patch Planned", crash.run research, Arista Advisory 0137

     Rule IDs: 103627-103645
     Author: SecOps Purple Team
     Date: 2026-06-24

     MITRE ATT&CK Coverage:
       T1190        Exploit Public-Facing Application (CVE-2026-41089 DC attack surface)
       T1210        Exploitation of Remote Services (Netlogon RPC exploitation)
       T1543.003    Create or Modify System Process: Windows Service (Netlogon crash/restart)
       T1078.002    Valid Accounts: Domain Accounts (post-compromise DC pivot)
       T1195.001    Supply Chain Compromise: Software Supply Chain (Cordyceps CI/CD)
       T1552.004    Unsecured Credentials: Private Keys (CI secret exfiltration)
       T1059.004    Command and Scripting Interpreter: Unix Shell (Cordyceps code exec)
       T1404        Exploit OS Vulnerabilities (CVE-2025-48595 Android LPE)
       T1205        Traffic Signaling (Arista EOS tunnel injection)
       T1572        Protocol Tunneling (Arista CVE-2026-7473 unauthorized decap)
     ============================================================ -->


<!-- ==============================================================
     SECTION 1: CVE-2026-41089  - Windows Netlogon Stack-Based Buffer Overflow RCE
     T1210 (Exploitation of Remote Services) / T1190 (Exploit Public-Facing Application)
     CVSS 9.8 Critical; 0-click unauthenticated; actively exploited since June 2026
     Affects all Windows Server versions; patch: KB5058386 family (May 2026 Patch Tuesday)

     Detection approach:
       - Windows Application Event Log: Event ID 1000 (lsass.exe crash with netlogon.DLL)
       - Windows System Event Log: Event ID 7036 (Netlogon service stopped/started)
       - Windows Security Event Log: Event ID 5805 (Netlogon channel negotiation failure)
       - Windows Security Event Log: Event IDs 5827-5831 (Netlogon secure channel errors)
       - Windows Security Event Log: Event ID 4742 (computer account change on DC)
       - Frequency correlation: burst of 5805/5827 errors preceding lsass crash = exploitation
     ============================================================== -->
<group name="threat_intel_2026_06_24,windows,netlogon,supply_chain,android,mobile,network,arista,">

  <!-- Rule 103627  - Anchor: Netlogon channel establishment failure (Event ID 5805)
       Event 5805 fires when a machine fails to establish a Netlogon secure channel.
       Exploitation sends malformed RPC requests that cause channel negotiation failures.
       Level 10: single event is noisy; used as correlation base for rules 103629-103631. -->
  <rule id="103627" level="10">
    <if_sid>60010</if_sid>
    <field name="win.system.eventID">^5805$</field>
    <field name="win.system.channel">Security</field>
    <description>Netlogon secure channel establishment failure on $(hostname) from $(win.eventdata.machineName) - possible CVE-2026-41089 exploitation probe (T1210)</description>
    <mitre>
      <id>T1210</id>
    </mitre>
    <group>netlogon,channel_failure,dc_attack,</group>
  </rule>

  <!-- Rule 103628  - Netlogon RPC error events (5827/5828/5829/5830/5831)
       These events indicate Netlogon refused a secure channel request due to security
       policy or protocol violation; a burst of these is consistent with CVE-2026-41089
       exploit tooling probing for a vulnerable domain controller.
       Level 11: explicit Netlogon secure channel error; higher fidelity. -->
  <rule id="103628" level="11">
    <if_sid>60010</if_sid>
    <field name="win.system.eventID">^582[789]$|^583[01]$</field>
    <field name="win.system.channel">Security</field>
    <description>Netlogon secure channel error (EventID $(win.system.eventID)) on $(hostname) - Netlogon authentication anomaly consistent with CVE-2026-41089 exploitation (T1210)</description>
    <mitre>
      <id>T1210</id>
    </mitre>
    <group>netlogon,channel_error,dc_attack,</group>
  </rule>

  <!-- Rule 103629  - lsass.exe crash with netlogon.DLL as fault module
       A successful CVE-2026-41089 exploit triggers a stack overflow in lsass.exe via
       the Netlogon RPC path. Application Event ID 1000 records the crash with
       win.eventdata.faultModuleName = netlogon.DLL.
       Level 14: lsass crashing with netlogon.DLL is a strong exploitation indicator. -->
  <rule id="103629" level="14">
    <if_sid>60010</if_sid>
    <field name="win.system.eventID">^1000$</field>
    <field name="win.system.channel">Application</field>
    <field name="win.eventdata.applicationName" type="pcre2">(?i)\\?lsass\.exe$</field>
    <field name="win.eventdata.faultModuleName" type="pcre2">(?i)netlogon(\.dll)?$</field>
    <description>CRITICAL: lsass.exe crashed with netlogon.DLL as fault module on $(hostname) (ExceptionCode: $(win.eventdata.exceptionCode)) - CVE-2026-41089 RCE exploitation in progress (T1210)</description>
    <mitre>
      <id>T1210</id>
      <id>T1190</id>
    </mitre>
    <group>netlogon,lsass_crash,cve_2026_41089,critical_dc_event,</group>
  </rule>

  <!-- Rule 103630  - Netlogon service stopped (System event ID 7036)
       After a successful overflow, the Netlogon service may stop or restart.
       System Event ID 7036 records service state changes.
       Level 12: unexpected Netlogon stop mid-day warrants investigation. -->
  <rule id="103630" level="12">
    <if_sid>60010</if_sid>
    <field name="win.system.eventID">^7036$</field>
    <field name="win.system.channel">System</field>
    <field name="win.eventdata.param1" type="pcre2">(?i)^Netlogon$</field>
    <field name="win.eventdata.param2" type="pcre2">(?i)(stopped|running)</field>
    <description>Netlogon service state change on domain controller $(hostname) - unexpected Netlogon stop/restart may indicate CVE-2026-41089 exploitation (T1543.003)</description>
    <mitre>
      <id>T1543.003</id>
      <id>T1210</id>
    </mitre>
    <group>netlogon,service_restart,dc_attack,</group>
  </rule>

  <!-- Rule 103631  - Correlation: Netlogon channel failure burst (>=5 in 120s) from same source
       CVE-2026-41089 exploit tooling typically sends rapid RPC probes before triggering
       the overflow. Five 5805 errors from a single machine within 2 minutes is a strong
       pre-exploitation probe indicator.
       Level 14: coordinated burst attack against Netlogon; critical alert. -->
  <rule id="103631" level="14" frequency="5" timeframe="120">
    <if_matched_sid>103627</if_matched_sid>
    <same_field>win.eventdata.machineName</same_field>
    <description>Netlogon channel failure burst from $(win.eventdata.machineName) on $(hostname) - 5+ failures in 120s, CVE-2026-41089 domain controller exploit sweep (T1210)</description>
    <mitre>
      <id>T1210</id>
      <id>T1190</id>
    </mitre>
    <group>netlogon,channel_failure,cve_2026_41089,exploit_burst,correlation,</group>
  </rule>

  <!-- Rule 103632  - Post-compromise: domain computer account modification after Netlogon anomaly
       After gaining SYSTEM on a DC via CVE-2026-41089, attackers frequently modify
       computer account attributes (4742) or create new privileged accounts (4720).
       This rule flags 4742 (computer account changed) as a post-exploitation pivot signal.
       Level 12: computer account changes on DCs are uncommon and high-value pivots. -->
  <rule id="103632" level="12">
    <if_sid>60010</if_sid>
    <field name="win.system.eventID">^4742$</field>
    <field name="win.system.channel">Security</field>
    <description>Domain computer account modified on DC $(hostname) by $(win.eventdata.subjectUserName) - monitor in context of Netlogon anomalies for CVE-2026-41089 post-exploitation (T1078.002)</description>
    <mitre>
      <id>T1078.002</id>
    </mitre>
    <group>netlogon,post_exploitation,domain_controller,account_manipulation,</group>
  </rule>

  <!-- Rule 103633  - Suricata: malformed Netlogon RPC traffic signature
       IDS engines may detect oversized or malformed DCE-RPC Netlogon calls
       as anomalous. Catches CVE-2026-41089 network-layer exploitation attempts.
       Level 13: direct IDS match on Netlogon exploit traffic. -->
  <rule id="103633" level="13">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(CVE-2026-41089|netlogon.*overflow|netlogon.*exploit|netlogon.*rce|MS-NRPC.*overflow)</field>
    <description>Suricata: malformed Netlogon RPC traffic detected - CVE-2026-41089 domain controller exploit attempt (T1210)</description>
    <mitre>
      <id>T1210</id>
      <id>T1190</id>
    </mitre>
    <group>ids,suricata,netlogon,cve_2026_41089,domain_controller,</group>
  </rule>




<!-- ==============================================================
     SECTION 2: Cordyceps  - CI/CD GitHub Actions Supply Chain Vulnerability
     T1195.001 (Supply Chain Compromise: Software Supply Chain)
     T1552.004 (Unsecured Credentials: Private Keys)
     T1059.004 (Command and Scripting Interpreter: Unix Shell)
     Novee Security disclosure June 24, 2026; no CVE; systemic GitHub Actions misconfiguration

     Detection approach:
       - GitHub Actions audit log: workflow_run triggered by pull_request from fork
         with elevated permissions (write/admin secrets access)
       - CI environment: process execution in GitHub runner with suspicious parent
         (e.g., github_actions spawning curl/bash with credential endpoints)
       - File creation: .github/workflows/*.yml modification by external fork contributor
       - Secrets exfiltration: outbound HTTPS from CI runner to non-GitHub endpoints
         carrying Authorization headers or CI_* environment variable values
       - Agent: GitHub Enterprise audit log via webhook -> Wazuh custom decoder
     ============================================================== -->

  <!-- Rule 103634  - CI/CD workflow triggered by forked PR with write-secrets permission
       The core Cordyceps pattern: a workflow file grants write permission to pull_request
       events from forks; an external contributor's PR comment triggers privileged execution.
       Detection via GitHub audit log events forwarded to Wazuh via webhook.
       Level 12: unauthorized external code executing in privileged CI context. -->
  <rule id="103634" level="12">
    <if_sid>87701</if_sid>
    <field name="github.action" type="pcre2">(?i)(workflows\.completed|workflow_run\.requested)</field>
    <field name="github.event" type="pcre2">(?i)(pull_request|pull_request_target)</field>
    <field name="github.actor_is_outside_collaborator">true</field>
    <description>GitHub Actions workflow triggered by external fork contributor $(github.actor) - verify PR permissions comply with Cordyceps supply chain hardening (T1195.001)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>cicd,cordyceps,github_actions,fork_pr_trigger,</group>
  </rule>

  <!-- Rule 103635  - GitHub audit: workflow has write token scope from pull_request_target
       The critical misconfiguration: pull_request_target grants the triggering PR access
       to repository write scope and secrets. This is the most common Cordyceps pattern.
       Level 13: write scope granted to untrusted fork code; immediate review needed. -->
  <rule id="103635" level="13">
    <if_sid>87701</if_sid>
    <field name="github.action" type="pcre2">(?i)workflow_run</field>
    <field name="github.workflow_trigger" type="pcre2">(?i)pull_request_target</field>
    <field name="github.token_scope" type="pcre2">(?i)(write|admin)</field>
    <description>GitHub Actions pull_request_target workflow with write token scope executed by $(github.actor) - Cordyceps CI/CD supply chain risk: secrets may be accessible (T1195.001)</description>
    <mitre>
      <id>T1195.001</id>
      <id>T1552.004</id>
    </mitre>
    <group>cicd,cordyceps,github_actions,pull_request_target,secret_access,</group>
  </rule>

  <!-- Rule 103636  - CI runner spawning unexpected exfiltration-style process
       After hijacking a workflow, attackers run commands in the CI environment to
       exfiltrate secrets (curl with authorization headers, env variable dumps, etc.).
       Sysmon/auditd process events from GitHub-hosted or self-hosted runners.
       Level 13: CI runner spawning credential exfiltration pattern. -->
  <rule id="103636" level="13">
    <if_sid>61603,80792</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)(runner\.Worker|github.*runner|actions-runner)</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(curl.*(Authorization|Bearer|token|secret)|env\s*\|.*curl|printenv.*token|base64.*GITHUB_TOKEN)</field>
    <description>Suspicious credential exfiltration command in CI runner on $(hostname): $(win.eventdata.commandLine) - possible Cordyceps supply chain CI hijack (T1552.004)</description>
    <mitre>
      <id>T1552.004</id>
      <id>T1059.004</id>
    </mitre>
    <group>cicd,cordyceps,credential_exfiltration,ci_runner,</group>
  </rule>

  <!-- Rule 103637  - GitHub audit: unexpected secrets access event in workflow
       GitHub audit log records when a workflow accesses organization or repo secrets.
       An external fork PR triggering secret access is a clear Cordyceps exploitation signal.
       Level 13: secrets accessed by workflow triggered from external contributor. -->
  <rule id="103637" level="13">
    <if_sid>87701</if_sid>
    <field name="github.action" type="pcre2">(?i)(secret\.accessed|org\.secret_accessed|repo\.secret_accessed)</field>
    <field name="github.actor_is_outside_collaborator">true</field>
    <description>GitHub repository secret accessed in workflow triggered by external contributor $(github.actor) - Cordyceps CI/CD credential theft pattern (T1552.004)</description>
    <mitre>
      <id>T1552.004</id>
      <id>T1195.001</id>
    </mitre>
    <group>cicd,cordyceps,secret_access,github_audit,</group>
  </rule>

  <!-- Rule 103638  - .github/workflows/*.yml modified by external contributor PR
       Cordyceps attackers may submit PRs that modify workflow files directly to
       insert malicious steps. This rules flags workflow YAML file changes in external PRs.
       Level 11: workflow file modification by untrusted contributor requires review. -->
  <rule id="103638" level="11">
    <if_sid>87701</if_sid>
    <field name="github.action" type="pcre2">(?i)(pr\.files_changed|push)</field>
    <field name="github.head_repo_owner" type="pcre2">(?i)\w+</field>
    <field name="github.filename" type="pcre2">(?i)\.github/workflows/.*\.ya?ml$</field>
    <description>GitHub Actions workflow file modified in PR from fork by $(github.actor) - review for Cordyceps supply chain injection (T1195.001)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>cicd,cordyceps,workflow_modification,github_audit,</group>
  </rule>




<!-- ==============================================================
     SECTION 3: CVE-2025-48595  - Android Framework Integer Overflow LPE
     T1404 (Exploit OS Vulnerabilities)  - Android local privilege escalation
     CISA KEV added June 2, 2026; CVSS High; Android 14/15/16
     Targeted exploitation consistent with commercial spyware / nation-state
     Fixed: Android June 2026 Security Update (patch level 2026-06-05 or later)

     Detection approach:
       - MDM/EMM (Microsoft Intune, Jamf) compliance event: device patch level &lt; 2026-06-05
       - Android enterprise log: unexpected process with escalated UID (root/system)
         spawned from non-system app (UID >= 10000) on an unpatched device
       - Wazuh syscheck: unexpected app acquiring system/root UID in Android managed logs
       - Network-level: C2 beacon from compromised Android device (spyware pattern)
       - Wazuh agent on MDM log forwarder: device out-of-compliance event
     ============================================================== -->

  <!-- Rule 103639  - MDM: Android device reporting patch level below CVE-2025-48595 fix
       MDM platforms forward compliance events to SIEM. Devices below Android 2026-06-05
       patch level remain vulnerable. This rule alerts on vulnerable enrolled devices.
       Level 10: informational  - vulnerable device inventory; use for patch prioritization. -->
  <rule id="103639" level="10">
    <decoded_as>json</decoded_as>
    <field name="mdm.platform" type="pcre2">(?i)android</field>
    <field name="mdm.security_patch_level" type="pcre2">^202[0-5]-|^2026-0[1-5]-(?!0[5-9]|[1-9][0-9])|^2026-06-0[1-4]$</field>
    <field name="mdm.event_type" type="pcre2">(?i)(compliance|enrollment|checkin)</field>
    <description>Android device $(mdm.device_name) enrolled via MDM has patch level $(mdm.security_patch_level) - vulnerable to CVE-2025-48595 LPE (CISA KEV); patch to 2026-06-05+ (T1404)</description>
    <mitre>
      <id>T1404</id>
    </mitre>
    <group>android,mdm,cve_2025_48595,patch_compliance,</group>
  </rule>

  <!-- Rule 103640  - Android enterprise log: non-system app gaining elevated UID
       CVE-2025-48595 exploitation causes a normal app (UID >= 10000) to gain
       system or root UID (UID &lt; 1000). Android enterprise/work-profile audit logs
       forwarded via MDM may capture this anomalous UID escalation.
       Level 14: app gaining root/system UID outside expected system context. -->
  <rule id="103640" level="14">
    <decoded_as>json</decoded_as>
    <field name="android.event_type" type="pcre2">(?i)(process_started|uid_changed|privilege_escalation)</field>
    <field name="android.process_uid" type="pcre2">^([0-9]|[1-9][0-9]{0,2}|1000)$</field>
    <field name="android.parent_uid" type="pcre2">^[1-9][0-9]{4,}$</field>
    <description>Android: non-system app (UID $(android.parent_uid)) spawned process with escalated UID $(android.process_uid) - CVE-2025-48595 LPE exploit pattern on $(android.device_id) (T1404)</description>
    <mitre>
      <id>T1404</id>
    </mitre>
    <group>android,privilege_escalation,cve_2025_48595,uid_escalation,</group>
  </rule>

  <!-- Rule 103641  - Suricata: known Android spyware C2 IOC for CVE-2025-48595 exploiters
       Limited targeted exploitation pattern consistent with commercial spyware (Pegasus-like)
       operators who weaponize Android LPE CVEs. Matches known spyware C2 network patterns.
       Level 12: device communicating with known mobile spyware infrastructure. -->
  <rule id="103641" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(CVE-2025-48595|android.*framework.*overflow|android.*lpe.*c2|mobile.*spyware.*c2)</field>
    <description>Suricata: network signature match for CVE-2025-48595 Android LPE campaign C2 traffic from $(src_ip) - possible targeted mobile exploitation (T1404)</description>
    <mitre>
      <id>T1404</id>
    </mitre>
    <group>ids,suricata,android,cve_2025_48595,spyware_c2,</group>
  </rule>




<!-- ==============================================================
     SECTION 4: CVE-2026-7473  - Arista EOS Incomplete Tunnel Decapsulation
     T1572 (Protocol Tunneling) / T1205 (Traffic Signaling)
     CISA KEV added June 9, 2026; CVSS 6.9; NO PATCH PLANNED (mitigation via ACL only)
     Affected: Arista 7020R, 7280R/R2, 7500R/R2 (VXLAN/GRE/decap-group configurations)

     Vulnerability: switch accepts and decapsulates tunnel traffic for protocols not
     configured; attacker sends VXLAN-encapsulated packets to a GRE-configured IP
     and the switch forwards the inner payload, bypassing network segmentation.

     Detection approach:
       - Suricata: unexpected tunnel protocol to Arista switch management/data IPs
         (VXLAN on port 4789 / GRE protocol 47 from non-datacenter sources)
       - Arista syslog: ACL hit on unexpected tunnel traffic (if ACL mitigation applied)
       - Suricata: east-west tunnel traffic between VLANs that should not communicate
       - Network flow: excessive VXLAN/GRE packets from unexpected source ranges
     ============================================================== -->

  <!-- Rule 103642  - Suricata: unexpected VXLAN traffic to non-configured VTEP
       CVE-2026-7473 allows sending VXLAN to an Arista IP configured only for GRE.
       Unexpected VXLAN (UDP/4789) destined for known Arista device IPs may indicate
       active exploitation of this misconfiguration bypass.
       Level 11: unexpected tunnel protocol reaching network infrastructure. -->
  <rule id="103642" level="11">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(CVE-2026-7473|arista.*tunnel|vxlan.*unexpected|ET POLICY.*VXLAN|unexpected.*decapsulat)</field>
    <description>Suricata: unexpected tunnel encapsulation toward Arista EOS device from $(src_ip) - possible CVE-2026-7473 tunnel injection (T1572)</description>
    <mitre>
      <id>T1572</id>
      <id>T1205</id>
    </mitre>
    <group>ids,suricata,arista,cve_2026_7473,tunnel_inject,</group>
  </rule>

  <!-- Rule 103643  - Arista syslog: ACL hit on unexpected tunnel protocol
       If ACL mitigation is applied per Arista advisory 0137, the ACL will generate
       syslog messages when it blocks unexpected tunnel traffic. This rule catches
       those ACL hits as evidence of active CVE-2026-7473 exploitation attempts.
       Level 12: ACL blocking unexpected tunnel protocol  - active probe detected. -->
  <rule id="103643" level="12">
    <field name="arista.syslog.facility" type="pcre2">(?i)(SECURITY|ACL|ACLMGR|IPACL)</field>
    <field name="arista.syslog.message" type="pcre2">(?i)(tunnel.*denied|decap.*acl.*drop|unexpected.*tunnel.*protocol|vxlan.*denied|gre.*denied)</field>
    <description>Arista EOS ACL blocked unexpected tunnel protocol on $(arista.interface) from $(src_ip) - CVE-2026-7473 exploitation attempt blocked by ACL mitigation (T1572)</description>
    <mitre>
      <id>T1572</id>
    </mitre>
    <group>arista,cve_2026_7473,acl_block,tunnel_inject,</group>
  </rule>

  <!-- Rule 103644  - Network flow: high-rate VXLAN/GRE from non-datacenter source
       An attacker exploiting CVE-2026-7473 to inject traffic at scale would generate
       high volumes of tunnel-protocol packets from an unexpected source range.
       Catches scanning/lateral movement via tunnel injection.
       Level 12: high-rate tunnel traffic from unexpected source. -->
  <rule id="103644" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)(ET SCAN.*VXLAN|ET SCAN.*GRE.*(flood|scan|sweep)|tunnel.*scan|arista.*vxlan.*scan)</field>
    <description>Suricata: high-rate VXLAN/GRE scan from $(src_ip) - possible CVE-2026-7473 Arista EOS tunnel injection sweep (T1572)</description>
    <mitre>
      <id>T1572</id>
      <id>T1046</id>
    </mitre>
    <group>ids,suricata,arista,cve_2026_7473,tunnel_scan,network_scan,</group>
  </rule>

  <!-- Rule 103645  - Arista syslog: unexpected inner payload forwarded post-decapsulation
       When CVE-2026-7473 succeeds, the switch silently forwards the inner payload.
       Arista may log abnormal forwarding events or TCAM exceptions for unrecognized
       traffic types that bypass configured filters.
       Level 11: Arista logging unexpected forwarding event; verify tunnel config. -->
  <rule id="103645" level="11">
    <field name="arista.syslog.message" type="pcre2">(?i)(unexpected.*forward|decap.*forward.*anomaly|tunnel.*forward.*unknown|inner.*payload.*forwarded|TCAM.*tunnel.*exception)</field>
    <description>Arista EOS forwarded unexpected inner tunnel payload on $(arista.interface) - possible CVE-2026-7473 bypass of network segmentation (T1572)</description>
    <mitre>
      <id>T1572</id>
      <id>T1205</id>
    </mitre>
    <group>arista,cve_2026_7473,unexpected_forwarding,tunnel_bypass,</group>
  </rule>

</group>

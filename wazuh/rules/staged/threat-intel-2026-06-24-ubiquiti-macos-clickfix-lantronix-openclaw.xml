       Level 14: known active C2 infrastructure across two concurrent campaigns.
       ================================================================ -->
  <rule id="103570" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.dest_ip" type="pcre2">^91\.92\.242\.30$</field>
    <description>Suricata: Outbound connection to AMOS/ClawHavoc C2 IP 91.92.242.30 - active C2 IOC (T1071.001)</description>
    <mitre>
      <id>T1071.001</id>
    </mitre>
    <group>ids,suricata,amos,clawhavoc,c2_ioc,</group>
  </rule>

  <!-- ================================================================
       Rule 103571  - Network IOC: hgodpcx.ajb8[.]com secondary C2 domain
       Secondary AMOS C2 domain from Unit 42 June 23, 2026 IOC set.
       Level 14: confirmed threat intel IOC.
       ================================================================ -->
  <rule id="103571" level="14">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">(?i)hgodpcx\.ajb8\.com</field>
    <description>Suricata: Connection to AMOS secondary C2 domain hgodpcx.ajb8.com - ClickFix stealer IOC (T1071.001)</description>
    <mitre>

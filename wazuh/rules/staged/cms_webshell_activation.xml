<!-- ============================================================
     ACSC CMS Campaign  - Generic CMS Webshell Activation Patterns
     MITRE ATT&amp;CK:
       T1505.003  - Server Software Component: Web Shell
       T1059.004  - Command and Scripting Interpreter: Unix Shell
       T1190      - Exploit Public-Facing Application
     Rule IDs: 103812-103820
     ACSC CMS Campaign Advisory: 2026-07-11
     Author: SecOps Engineer (Purple Team)  - ESKA-457
     Date: 2026-07-12

     Purpose:
       Generic webshell activation detection rules covering PHP webshell
       deployment and execution patterns across common CMS platforms:
       WordPress, Craft CMS, Laravel, Joomla, and generic web applications.

       These rules complement the CVE-specific detections (103789-103811)
       and detect webshell activity that does not match a specific CVE
       signature  - including shells dropped by unpatched CVEs not yet
       covered by named rules, or by exploits where the initial access
       vector is unknown.

       The common pattern across all ACSC CMS campaign CVEs is:
         1. Exploit public-facing CMS plugin/component (T1190)
         2. Upload or write a PHP webshell to a web-accessible path
         3. Activate the webshell via HTTP GET/POST with command parameters
            (T1505.003 -> T1059.004)

       These rules detect steps 2 and 3 generically.

     Log source prerequisites:
       - Traefik access log in JSON format forwarded to Wazuh
       - Built-in Wazuh JSON decoder (decoded_as=json)
       - JSON field names follow Traefik defaults:
           RequestPath, RequestMethod, RequestHost, DownstreamStatus,
           ClientHost

     Severity rationale:
       14  - PHP file in WordPress uploads path (PHP should not exist there)
       15  - Webshell cmd params in any CMS upload/media path (active RCE)
       15  - Known webshell filename in CMS upload directory (high-confidence)
       13  - POST to PHP file in CMS upload/media path (webshell activation)
       14  - PHP file in Laravel public/storage path (anomalous by design)
       14  - PHP file in Craft CMS web-accessible asset path (anomalous by design)
       13  - 5+ PHP-in-uploads requests from same IP in 60s (path discovery scan)
       12  - POST to WordPress admin-ajax.php with PHP filename indicator (upload)
       15  - Webshell cmd params in CMS plugin/theme upload path (active RCE)
     ============================================================ -->

<group name="initial_access,exploit_pubfacing,webshell,cms,acsc_cms_campaign,">

  <!-- ===========================================================
       T1505.003  - Web Shell / T1059.004  - Unix Shell
       Rules 103812-103820: Generic CMS webshell activation detection
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->

  <!-- PHP file accessed in WordPress uploads directory (generic WP webshell).
       WordPress does not place executable PHP files under /wp-content/uploads/
       by design. Any request to a .php or .phtml file at this path is anomalous
       and indicates a webshell uploaded via a WordPress plugin file upload
       vulnerability (CVE-2026-0740, CVE-2026-1357, CVE-2026-3844, and others).
       Also used as the base anchor for the rapid-probe frequency rule (103820).
       Level 14: high-confidence webshell  - PHP must not exist in WP uploads. -->
  <rule id="103812" level="14">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/wp-content/uploads/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>CMS webshell: PHP file accessed in WordPress uploads path from $(ClientHost) to $(RequestHost)$(RequestPath) - WordPress does not place PHP files in wp-content/uploads/; likely webshell from ACSC CMS campaign (T1505.003)</description>
    <mitre>
      <id>T1505</id>
    </mitre>
    <group>wordpress,webshell,post_exploitation,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- Webshell command parameters in any CMS upload/media directory PHP file.
       Covers all common CMS upload and media paths across platforms:
         WordPress: /wp-content/uploads/
         Joomla:    /media/, /images/
         Craft CMS: /uploads/, /assets/
         Laravel:   /storage/
         Generic:   /files/
       Matches common webshell command parameter names in the request URL.
       Level 15: active webshell command execution  - T1059.004. -->
  <rule id="103813" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:wp-content/uploads|media|images|uploads|assets|files|storage)/.*\.ph(?:p[3-8]?|tml).*(?:cmd=|command=|exec=|shell=|c=|run=|system=|pass=|passwd=)</field>
    <description>CMS webshell: active webshell command parameter in CMS upload/media path $(RequestPath) from $(ClientHost) - PHP webshell executing OS commands; ACSC CMS campaign post-exploitation (T1059.004/T1505.003); initiate incident response</description>
    <mitre>
      <id>T1059</id>
      <id>T1505</id>
    </mitre>
    <group>webshell,execution,post_exploitation,cms_webshell,acsc_cms_campaign,critical,</group>
  </rule>

  <!-- Known webshell filename accessed in a CMS upload directory.
       Common webshell tool names used in ACSC CMS campaign and observed
       across CMS exploitation incidents: c99, r57, b374k, wso (Web Shell
       by Orb), alfa (Alfa Shell), indoxploit, shellbot. Also covers generic
       descriptive names (shell.php, cmd.php, backdoor.php, webshell.php)
       and obfuscated/encoded shell names (base64-shell, eval-base64).
       Level 15: known webshell filename  - near-certain malicious activity. -->
  <rule id="103814" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:wp-content/uploads|media|images|uploads|assets|files|storage)/.*(?:c99|r57|b374k|wso|alfa|indoxploit|shellbot|webshell|backdoor|shell\.|cmd\.|hack\.|passthru|eval-base64|base64-shell).*\.ph(?:p[3-8]?|tml)</field>
    <description>CMS webshell: known webshell filename in CMS upload path $(RequestPath) from $(ClientHost) - ACSC CMS campaign webshell tool detected; initiate incident response (T1505.003)</description>
    <mitre>
      <id>T1505</id>
    </mitre>
    <group>webshell,post_exploitation,cms_webshell,acsc_cms_campaign,critical,</group>
  </rule>

  <!-- POST to a PHP file in a CMS upload or media directory.
       Attackers POST to an already-uploaded webshell to pass command
       parameters via POST body (invisible in Traefik logs) rather than
       GET parameters. A POST to a .php file in any CMS upload/media
       directory is strongly anomalous  - these directories do not serve
       PHP applications under normal operation.
       Level 13: POST to PHP in upload/media directory  - active webshell use. -->
  <rule id="103815" level="13">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/(?:wp-content/uploads|media|images|uploads|assets|files|storage)/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>CMS webshell: POST to PHP file in CMS upload/media path from $(ClientHost) to $(RequestHost)$(RequestPath) - POST to PHP in upload directories indicates webshell activation with POST-body command delivery (T1505.003/T1190)</description>
    <mitre>
      <id>T1505</id>
      <id>T1190</id>
    </mitre>
    <group>webshell,post_exploitation,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- PHP file accessed in Laravel public/storage directory.
       Laravel stores user uploads in storage/app/public/ which is symlinked
       to public/storage/ via `php artisan storage:link`. Executable PHP files
       do not belong in these directories by design  - their presence indicates
       a file-overwrite or upload exploitation (e.g. CVE-2026-31843 pay-uz or
       other Laravel plugin vulnerabilities in the ACSC campaign).
       Level 14: PHP in Laravel storage is anomalous by framework design. -->
  <rule id="103816" level="14">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:public/storage|storage/app/public|storage/framework/views)/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>CMS webshell: PHP file accessed in Laravel public/storage path from $(ClientHost) to $(RequestHost)$(RequestPath) - PHP should not exist in Laravel storage directories; likely file-overwrite exploitation (T1505.003)</description>
    <mitre>
      <id>T1505</id>
      <id>T1190</id>
    </mitre>
    <group>laravel,webshell,post_exploitation,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- PHP file accessed in Craft CMS web-accessible asset directories.
       Craft CMS stores media uploads under /web/uploads/ and compiled
       resources under /cpresources/. PHP files do not belong in these
       directories by Craft CMS framework design. Their presence indicates
       post-exploitation webshell deployment, most likely via CVE-2025-32432
       (conditions/render code injection) or another Craft CMS exploit.
       Level 14: PHP in Craft CMS asset paths is anomalous by framework design. -->
  <rule id="103817" level="14">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:web/uploads|web/assets|cpresources)/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>CMS webshell: PHP file accessed in Craft CMS asset/uploads path from $(ClientHost) to $(RequestHost)$(RequestPath) - PHP should not exist in Craft CMS asset directories; likely webshell from code injection exploit (T1505.003)</description>
    <mitre>
      <id>T1505</id>
      <id>T1190</id>
    </mitre>
    <group>craftcms,webshell,post_exploitation,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- 5+ PHP file requests in WordPress uploads from same IP in 60 seconds.
       After deploying a webshell, automated exploit tools rapidly probe
       different PHP paths within /wp-content/uploads/ to discover the
       exact location of the dropped file and confirm execution capability.
       Chains from rule 103812 (PHP-in-WP-uploads base alert).
       Level 13: automated webshell path discovery or rapid shell testing. -->
  <rule id="103818" level="13" frequency="5" timeframe="60">
    <if_matched_sid>103812</if_matched_sid>
    <same_field>ClientHost</same_field>
    <description>CMS webshell: 5+ PHP file requests in WordPress uploads from $(ClientHost) in 60s - automated webshell path discovery or post-exploitation testing (T1505.003/T1059.004)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1505</id>
      <id>T1059</id>
    </mitre>
    <group>wordpress,webshell,post_exploitation,scanner,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- POST to WordPress admin-ajax.php with PHP filename in URL.
       The WordPress admin AJAX handler is a common attack vector for plugin
       file upload CVEs (Ninja Forms, WPvivid, and other ACSC campaign targets).
       When the PHP filename appears in the query string (not just the POST body),
       it indicates a direct PHP filename reference in the upload request.
       Level 12: suspicious WP AJAX upload  - correlate with upload path alerts. -->
  <rule id="103819" level="12">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/wp-admin/admin-ajax\.php.*\.ph(?:p[3-8]?|tml)</field>
    <description>CMS webshell: POST to WordPress admin-ajax.php with PHP filename in URL from $(ClientHost) to $(RequestHost)$(RequestPath) - PHP filename reference in AJAX upload request indicates plugin file upload exploitation attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,initial_access,exploit_pubfacing,file_upload,cms_webshell,acsc_cms_campaign,</group>
  </rule>

  <!-- Webshell command parameters in CMS plugin/theme upload subdirectories.
       Covers webshells deployed to plugin-specific or theme-specific upload
       subdirectories not matched by the broader rules above. Includes paths
       like /wp-content/plugins/{name}/upload/, /content/themes/{name}/upload/,
       and /components/{name}/. Designed as a catch-all for ACSC campaign
       webshells in non-standard CMS directory locations.
       Level 15: active webshell command execution  - T1059.004. -->
  <rule id="103820" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/(?:wp-content/(?:plugins|themes)/[^/]+/(?:upload|temp|cache)|components/[^/]+|attachments)/.*\.ph(?:p[3-8]?|tml).*(?:cmd=|command=|exec=|shell=|c=|run=|system=)</field>
    <description>CMS webshell: active webshell command parameter in CMS plugin/theme upload path $(RequestPath) from $(ClientHost) - ACSC campaign webshell active in plugin/component directory (T1059.004/T1505.003); initiate incident response</description>
    <mitre>
      <id>T1059</id>
      <id>T1505</id>
    </mitre>
    <group>webshell,execution,post_exploitation,cms_webshell,acsc_cms_campaign,critical,</group>
  </rule>

</group>

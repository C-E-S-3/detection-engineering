<!-- ============================================================
     Malicious npm Preinstall Hook - Cross-Platform Infostealer Detection Rules
     MITRE ATT&CK Techniques:
       T1195.002  - Compromise Software Supply Chain
       T1059.007  - Command and Scripting Interpreter: JavaScript
       T1053.005  - Scheduled Task/Job: Scheduled Task (Windows persistence)
       T1547.011  - Plist Modification (macOS LaunchAgent persistence)
       T1555.003  - Credentials from Web Browsers
     Rule IDs: 103850-103857
     Author: SecOps Engineer
     Date: 2026-07-12

     Threat: jscrambler npm supply chain compromise (July 2026) and related
             malicious npm preinstall/postinstall hook attacks.
     Reference: https://socket.dev/blog/jscrambler-supply-chain-attack
                https://socket.dev/blog/injective-sdk-npm-supply-chain-attack

     Affected packages: jscrambler 8.14.0, 8.16.0, 8.17.0, 8.18.0, 8.20.0
     Attack chain summary:
       1. Developer/CI runs npm install with affected jscrambler version
       2. dist/setup.js preinstall hook fingerprints OS, drops Rust infostealer
       3. On Windows: infostealer runs schtasks.exe for logon persistence
       4. On macOS: LaunchAgent plist written to ~/Library/LaunchAgents/
       5. Infostealer exfiltrates Chrome/Brave/Edge creds, Bitwarden, Steam tokens

     IOC hashes (SHA256):
       a742de963f14a92d24ebcbc7b44ac867e23a20d31d1b0094a13a4f83287f4e60
         dist/setup.js — malicious preinstall hook (all 5 affected versions)
       a41a523ef9517aab37ed6eea0ec881821bdcb7aefcb5c5f603adc7907f868c86
         dist/intro.js — secondary loader stage
       fbbcf4d8f98168f78f5c0c47a9ae56d59ec8ac84a7c9ca6b797fedfb8d62d2bd
         Linux ELF Rust infostealer payload
       b7ca95d1b23c8e67416a25cedf741de0917c2096bbc9d24649eea7853d054903
         Windows PE64 Rust infostealer payload (establishes schtasks persistence)
       c8fd47d36bdf7c825378593ab82ed8c24d1dc52e26b507812393e24e1d5201fd
         macOS arm64 Mach-O Rust infostealer payload (LaunchAgent persistence)

     Log source prerequisites (Windows):
       - Sysmon EventID 1 (ProcessCreate) -> Wazuh SID 61603
         Required for process ancestry rules (103850-103853)
       - Wazuh FIM (syscheck) monitoring npm node_modules directories and
         system temp paths (C:\Windows\Temp, %APPDATA%\Local\Temp)
         Required for hash detection rules (103854, 103855)

     Log source prerequisites (Linux):
       - auditd execve rules forwarded to Wazuh
         Required for npm preinstall hook execution detection (103856, 103857)
       - Wazuh syscheck monitoring /tmp, /var/tmp, ~/.npm/_npx paths
         Required for hash detection via FIM

     False positive guidance:
       - node.exe -> cmd.exe: legitimate when node-gyp MSBuild is active
         (exclude if commandLine contains "node_gyp" or "python" + "msbuild")
       - schtasks.exe spawned from node.exe has NO known legitimate use case;
         treat as near-certain malicious activity
       - npm on Linux producing new ELF binaries in temp paths is highly anomalous

     Severity tiers:
       12 - Moderate suspicion (node->cmd without known-bad indicators, Linux npm->shell)
       13 - High suspicion (node->PowerShell, node->reg.exe, LOLBin download utilities)
       14 - Near-certain malicious (node->schtasks, IOC hash match partial)
       15 - Confirmed IOC hash detected by FIM
     ============================================================ -->

<group name="supply_chain,npm,initial_access,execution,persistence,windows,linux,jscrambler,">

  <!-- ===========================================================
       Windows — node.exe spawning schtasks.exe (T1053.005, T1195.002)
       The jscrambler Windows infostealer establishes persistence by spawning
       schtasks.exe as a direct child of node.exe/node. npm install has NO
       legitimate reason to create a scheduled task. This is near-certain
       malicious activity — the infostealer is establishing logon persistence.
       =========================================================== -->
  <rule id="103850" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\node(?:\.exe)?$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <description>npm supply chain: node.exe spawned schtasks.exe on $(win.eventdata.computer) by $(win.eventdata.user) -- malicious npm preinstall hook establishing scheduled task persistence (T1053.005, T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1053.005</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,jscrambler,scheduled_task,persistence,</group>
  </rule>

  <!-- ===========================================================
       Windows — node.exe spawning high-risk LOLBins (T1105, T1195.002)
       npm preinstall hooks that download or execute secondary payloads will
       spawn certutil.exe, bitsadmin.exe, mshta.exe, wscript.exe, or cscript.exe.
       None of these have legitimate use cases in an npm install lifecycle.
       =========================================================== -->
  <rule id="103851" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\node(?:\.exe)?$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(certutil|bitsadmin|mshta|wscript|cscript|regsvr32|rundll32|forfiles|msiexec|installutil)\.exe$</field>
    <description>npm supply chain: node.exe spawned $(win.eventdata.image) on $(win.eventdata.computer) -- LOLBin invoked from npm preinstall hook; likely payload staging or script execution (T1105, T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1105</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,lolbin,payload_staging,</group>
  </rule>

  <!-- ===========================================================
       Windows — node.exe spawning PowerShell or reg.exe (T1195.002)
       PowerShell or registry manipulation from an npm install context is
       highly suspicious — common pattern for dropper hooks that adjust
       persistence (registry Run keys) or download secondary stages.
       =========================================================== -->
  <rule id="103852" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\node(?:\.exe)?$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh|reg)\.exe$</field>
    <description>npm supply chain: node.exe spawned $(win.eventdata.image) on $(win.eventdata.computer) by $(win.eventdata.user) -- PowerShell or registry modification from npm install context (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,powershell,registry,</group>
  </rule>

  <!-- ===========================================================
       Windows — node.exe spawning cmd.exe without node-gyp indicators (T1195.002)
       cmd.exe is spawned by legitimate node-gyp native builds, but only when
       the command line contains "node_gyp" or "python" with "msbuild". Any
       other cmd.exe child of node.exe is suspicious, likely a dropper shell.
       =========================================================== -->
  <rule id="103853" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\node(?:\.exe)?$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\cmd\.exe$</field>
    <field name="win.eventdata.commandLine" negate="yes" type="pcre2">(?i)(node.gyp|node_gyp|python.*msbuild|gyp-win-tool)</field>
    <description>npm supply chain: node.exe spawned cmd.exe on $(win.eventdata.computer) without node-gyp indicators -- suspicious shell invocation from npm preinstall hook (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,cmd_spawn,</group>
  </rule>

  <!-- ===========================================================
       FIM: jscrambler dist/setup.js IOC hash detected (T1195.002)
       Wazuh syscheck SHA256 hash match for the known malicious preinstall
       hook script from the jscrambler supply chain attack. Fires on any
       filesystem path — catches renamed/relocated copies.
       =========================================================== -->
  <rule id="103854" level="15">
    <if_sid>550,553,554,593</if_sid>
    <match>a742de963f14a92d24ebcbc7b44ac867e23a20d31d1b0094a13a4f83287f4e60</match>
    <description>npm supply chain: IOC match for jscrambler malicious dist/setup.js preinstall hook (SHA256 a742de96) detected by FIM on $(agent.name) -- drop Rust infostealer via npm preinstall (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,jscrambler,ioc_match,setup_js,</group>
  </rule>

  <!-- ===========================================================
       FIM: jscrambler Rust infostealer payload IOC hashes (T1195.002, T1555.003)
       Three known hashes for the cross-platform Rust infostealer payloads
       dropped by the jscrambler preinstall hook. The Wazuh <match> element
       fires if any of these hex strings appear in the alert (FIM SHA256 field).
       =========================================================== -->
  <rule id="103855" level="15">
    <if_sid>550,553,554,593</if_sid>
    <regex>fbbcf4d8f98168f78f5c0c47a9ae56d59ec8ac84a7c9ca6b797fedfb8d62d2bd|b7ca95d1b23c8e67416a25cedf741de0917c2096bbc9d24649eea7853d054903|c8fd47d36bdf7c825378593ab82ed8c24d1dc52e26b507812393e24e1d5201fd|a41a523ef9517aab37ed6eea0ec881821bdcb7aefcb5c5f603adc7907f868c86</regex>
    <description>npm supply chain: IOC match for jscrambler Rust infostealer payload detected by FIM on $(agent.name) -- cross-platform credential stealer targeting Chrome/Brave/Edge, Bitwarden, and Steam (T1195.002, T1555.003)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1555.003</id>
    </mitre>
    <group>npm_supply_chain,jscrambler,ioc_match,infostealer_payload,</group>
  </rule>

  <!-- ===========================================================
       Linux auditd: npm/node spawning shell or binary in temp paths (T1195.002)
       On Linux, a malicious npm preinstall hook will execute a shell command
       to drop and run the Rust ELF infostealer from /tmp or /var/tmp.
       Auditd execve events capturing npm spawning /bin/sh or /bin/bash to
       execute binaries in world-writable temp directories are highly anomalous.
       Requires auditd execve rules capturing process ancestry.
       =========================================================== -->
  <rule id="103856" level="13">
    <decoded_as>auditd</decoded_as>
    <field name="audit.syscall">execve</field>
    <field name="audit.exe" type="pcre2">(?i)(?:^|/)(?:npm|node|npx)$</field>
    <field name="audit.cmd" type="pcre2">(?i)(?:/tmp/|/var/tmp/|/dev/shm/)</field>
    <description>Linux npm supply chain: npm/node executed binary in temp path on $(agent.name) -- suspicious npm preinstall hook dropping and running payload from world-writable directory (T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1059.007</id>
    </mitre>
    <group>npm_supply_chain,linux,temp_exec,</group>
  </rule>

  <!-- ===========================================================
       Linux auditd: npm/node spawning curl or wget for payload download (T1105, T1195.002)
       Malicious npm hooks that fetch second-stage payloads will invoke curl
       or wget as direct children of the npm/node process. npm has no built-in
       curl/wget invocation in its install lifecycle.
       =========================================================== -->
  <rule id="103857" level="13">
    <decoded_as>auditd</decoded_as>
    <field name="audit.syscall">execve</field>
    <field name="audit.exe" type="pcre2">(?i)(?:^|/)(?:npm|node|npx)$</field>
    <field name="audit.cmd" type="pcre2">(?i)(?:^|/)(?:curl|wget|python3?\s+-c|bash\s+-[ci])</field>
    <description>Linux npm supply chain: npm/node invoked download utility on $(agent.name) -- likely malicious preinstall hook fetching payload or executing inline shell code (T1105, T1195.002)</description>
    <mitre>
      <id>T1195.002</id>
      <id>T1105</id>
    </mitre>
    <group>npm_supply_chain,linux,download_lolbin,</group>
  </rule>

</group>

<!-- ============================================================
     WPvivid Backup  - Predictable Encryption Bypass Arbitrary PHP Upload RCE
     CVE-2026-1357  - CVSS 9.8 CRITICAL
     MITRE ATT&amp;CK:
       T1190      - Exploit Public-Facing Application
       T1505.003  - Server Software Component: Web Shell
       T1059.004  - Command and Scripting Interpreter: Unix Shell
     Rule IDs: 103795-103800
     ACSC CMS Campaign Advisory: 2026-07-11
     Author: SecOps Engineer (Purple Team)  - ESKA-457
     Date: 2026-07-12
     References:
       - https://nvd.nist.gov/vuln/detail/CVE-2026-1357

     Vulnerability summary:
       CVE-2026-1357 is a predictable encryption key bypass vulnerability in the
       WPvivid Backup Plugin for WordPress (version lte 0.9.123, CVSS 9.8). WPvivid
       uses a static/predictable key when packaging backup archives for transport.
       Attackers exploit this predictability to craft a malicious backup archive
       containing arbitrary PHP files encrypted with the known key, then POST it
       to the WPvivid REST API restore endpoint without authentication. The restore
       operation extracts the PHP files into the WordPress filesystem under
       /wp-content/uploads/wpvivid/ or directly into plugin/theme directories,
       enabling unauthenticated RCE. The encryption bypass allows the attacker to
       bypass file validation that expects properly-encrypted archives.

       Part of ACSC advisory 2026-07-11 large-scale CMS exploitation campaign.

     Log source prerequisites:
       - Traefik access log in JSON format forwarded to Wazuh
       - Built-in Wazuh JSON decoder (decoded_as=json)
       - JSON field names follow Traefik defaults:
           RequestPath, RequestMethod, RequestHost, DownstreamStatus,
           ClientHost

     Severity rationale:
       0   - Base anchor (no alert; used for chaining)
       13  - POST to WPvivid backup restore/upload REST endpoint (exploit attempt)
       15  - Restore endpoint returned 2xx (PHP file extracted to webroot)
       15  - PHP file accessed in WPvivid backup storage path (webshell executing)
       13  - 3+ rapid backup probes from same IP in 60s (automated exploit tool)
       15  - Webshell command parameter in WPvivid storage PHP file (active RCE)
     ============================================================ -->

<group name="initial_access,exploit_pubfacing,wordpress,wpvivid,webshell,cve_2026_1357,">

  <!-- ===========================================================
       T1190  - Exploit Public-Facing Application
       Rules 103795-103800: WPvivid Backup bypass RCE detection
       Log source: Traefik access log (JSON decoder)
       =========================================================== -->

  <!-- Base anchor: POST to WPvivid REST API namespace.
       WPvivid exposes backup and restore functionality under /wp-json/wpvivid/.
       All REST-based exploitation traffic for CVE-2026-1357 targets this
       path prefix. Level 0: no alert  - used for chaining only. -->
  <rule id="103795" level="0">
    <decoded_as>json</decoded_as>
    <field name="RequestMethod">POST</field>
    <field name="RequestPath" type="pcre2">(?i)/wp-json/wpvivid/</field>
    <description>WPvivid: POST to WPvivid REST API namespace from $(ClientHost) (base anchor) (CVE-2026-1357)</description>
    <group>wordpress,wpvivid,initial_access,cve_2026_1357,</group>
  </rule>

  <!-- POST to a WPvivid backup restore or upload endpoint.
       The backup upload (/v1/upload, /v1/receive) and restore (/v1/restore,
       /v1/import, /v1/backup-restore) endpoints are the targets of CVE-2026-1357.
       Attackers POST a crafted archive using the predictable encryption key bypass
       to deliver PHP webshells through the restore operation.
       Level 13: direct exploitation attempt targeting the backup restore endpoint. -->
  <rule id="103796" level="13">
    <if_sid>103795</if_sid>
    <field name="RequestPath" type="pcre2">(?i)/v\d+/(?:upload|restore|import|backup-restore|receive|extract)</field>
    <description>WPvivid CVE-2026-1357: unauthenticated POST to WPvivid backup restore/upload endpoint from $(ClientHost) to $(RequestHost)$(RequestPath) - predictable encryption bypass exploitation attempt; PHP files likely uploaded via malicious archive (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,initial_access,exploit_pubfacing,file_upload,cve_2026_1357,</group>
  </rule>

  <!-- Restore endpoint returned 2xx  - PHP files extracted.
       A successful 2xx response to the WPvivid backup restore endpoint confirms
       the malicious archive was accepted and its PHP files extracted to the
       WordPress filesystem. The webshell is now web-accessible.
       Level 15: webshell deployment confirmed  - incident response required. -->
  <rule id="103797" level="15">
    <if_sid>103795</if_sid>
    <field name="DownstreamStatus" type="pcre2">^2\d{2}$</field>
    <description>WPvivid CVE-2026-1357: backup endpoint returned $(DownstreamStatus) to $(ClientHost) - malicious backup archive restore CONFIRMED at $(RequestHost); PHP files likely extracted to webroot; initiate incident response (T1190/T1505.003)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505</id>
    </mitre>
    <group>wordpress,wpvivid,initial_access,exploit_pubfacing,file_upload,webshell,upload_success,cve_2026_1357,critical,</group>
  </rule>

  <!-- PHP file accessed in WPvivid backup storage directory.
       Extracted PHP files land under /wp-content/uploads/wpvivid-backups/
       or /wp-content/uploads/wpvivid/. WordPress does not place executable
       PHP files in backup storage directories; any such request indicates
       an extracted webshell is being executed.
       Level 15: active webshell execution  - T1505.003. -->
  <rule id="103798" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/wp-content/uploads/wpvivid[^/]*/.*\.ph(?:p[3-8]?|tml)(?:\?|$)</field>
    <description>WPvivid CVE-2026-1357: PHP file accessed in WPvivid backup storage path from $(ClientHost) to $(RequestHost)$(RequestPath) - PHP should not exist in WPvivid backup storage; likely webshell extracted via malicious archive (T1505.003)</description>
    <mitre>
      <id>T1505</id>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,webshell,post_exploitation,cve_2026_1357,critical,</group>
  </rule>

  <!-- 3+ rapid backup upload/restore probes from same IP in 60 seconds.
       Automated exploit tools send rapid repeated requests to the WPvivid REST
       API to discover restore endpoints and verify archive extraction success.
       Level 13: automated CVE-2026-1357 exploit tool. -->
  <rule id="103799" level="13" frequency="3" timeframe="60">
    <if_matched_sid>103795</if_matched_sid>
    <same_field>ClientHost</same_field>
    <description>WPvivid CVE-2026-1357: 3+ WPvivid REST API probes from $(ClientHost) in 60s - automated CVE-2026-1357 exploit tool; $(RequestHost) actively targeted (T1190)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>wordpress,wpvivid,initial_access,exploit_pubfacing,scanner,cve_2026_1357,</group>
  </rule>

  <!-- Webshell command parameter in WPvivid backup storage PHP file.
       After extraction, attackers activate the webshell by sending
       OS command parameters via GET/POST to the extracted PHP file.
       Level 15: T1059.004  - active command execution via extracted webshell. -->
  <rule id="103800" level="15">
    <decoded_as>json</decoded_as>
    <field name="RequestPath" type="pcre2">(?i)/wp-content/uploads/wpvivid[^/]*/.*\.ph(?:p[3-8]?|tml).*(?:cmd=|command=|exec=|shell=|c=|run=|system=|pass=|passwd=)</field>
    <description>WPvivid CVE-2026-1357: webshell command parameter in WPvivid backup path $(RequestPath) from $(ClientHost) - active PHP webshell command execution (T1059.004/T1505.003); initiate incident response</description>
    <mitre>
      <id>T1059</id>
      <id>T1505</id>
    </mitre>
    <group>wordpress,wpvivid,webshell,execution,post_exploitation,cve_2026_1357,critical,</group>
  </rule>

</group>

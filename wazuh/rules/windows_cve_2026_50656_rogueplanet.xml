<!-- ============================================================
     RoguePlanet Windows Defender Privilege Escalation Detection Rules
     CVE-2026-50656 (CVSS 7.8 HIGH, "Exploitation More Likely")
     MITRE ATT&CK Techniques:
       T1068  - Exploitation for Privilege Escalation
     Rule IDs: 102810-102815
     Author: SecOps Engineer (Purple Team)
     Date: 2026-06-19
     References:
       - SecurityWeek — Microsoft Working on Patch for RoguePlanet (2026-06-17)
       - Help Net Security — RoguePlanet zero-day (2026-06-17)
       - Hacker News — Microsoft Confirms RoguePlanet Defender Zero-Day (2026-06-17)
       - Morphisec Blog — When Your Detector Becomes the Attack Surface
       - Windows Forum CVE-2026-50656 — technical mitigation steps

     Vulnerability summary:
       CVE-2026-50656 (RoguePlanet) is an unpatched zero-day in the Microsoft
       Malware Protection Engine (MsMpEng.exe) classified as CWE-362 (race
       condition during concurrent file access). The public PoC, published June 10,
       2026 by "Nightmare Eclipse," races MsMpEng.exe file scanning with a symlink
       swap to spawn a cmd.exe shell with SYSTEM-level privileges. No user
       interaction is required; a standard authenticated local account is sufficient.
       Microsoft has not issued a patch as of 2026-06-19.

     Log source prerequisites:
       - Sysmon installed on all Windows hosts, with EventID 1 (Process Creation)
         enabled. The standard Wazuh Sysmon integration produces SID 61603 for
         EventID 1 events.
       - Ensure sysmon config includes IntegrityLevel logging (SwiftOnSecurity
         template or equivalent).

     Detection strategy:
       Primary indicator: MsMpEng.exe spawning a command interpreter (cmd.exe,
       powershell.exe, wscript.exe, etc.) outside its expected code paths.
       Defender normally creates child processes only for scan helper utilities
       (MpCmdRun.exe, MpSigStub.exe) — any shell interpreter as a direct child
       is highly anomalous.

     Severity tiers:
       12 - MsMpEng.exe spawning any unexpected non-Defender child process
       14 - MsMpEng.exe spawning a shell interpreter (cmd.exe, powershell.exe)
       15 - MsMpEng.exe spawning a shell interpreter with SYSTEM integrity level
     ============================================================ -->

<group name="privilege_escalation,windows,rogueplanet,cve_2026_50656,">

  <!-- ===========================================================
       T1068 — Exploitation for Privilege Escalation
       Rule IDs: 102810-102815 — RoguePlanet (CVE-2026-50656)
       =========================================================== -->

  <!-- Base anchor: MsMpEng.exe (Defender Malware Protection Engine) spawning
       any child process detected via Sysmon EventID 1.
       Legitimate Defender children: MpCmdRun.exe, MpSigStub.exe, MpDlpCmd.exe. -->
  <rule id="102810" level="0">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\MsMpEng\.exe$</field>
    <description>RoguePlanet: MsMpEng.exe spawned child process $(win.eventdata.image) (base anchor) (CVE-2026-50656)</description>
  </rule>

  <!-- MsMpEng.exe spawning unexpected non-Defender binary.
       Filters out known legitimate Defender child processes; any other
       child is anomalous and warrants investigation. -->
  <rule id="102811" level="12">
    <if_sid>102810</if_sid>
    <field name="win.eventdata.image" negate="yes" type="pcre2">(?i)\\(MpCmdRun|MpSigStub|MpDlpCmd|MpUXSrv|MpCopyAccelerator|mpconsole|NisSrv|ConfigSecurityPolicy)\.exe$</field>
    <description>RoguePlanet: MsMpEng.exe spawned unexpected child $(win.eventdata.image) on $(win.eventdata.computer) -- anomalous Defender behavior; investigate for CVE-2026-50656 exploitation (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,rogueplanet,windows,defender_abuse,</group>
  </rule>

  <!-- MsMpEng.exe spawning a command-line shell interpreter.
       This is the direct behavioral outcome of the RoguePlanet race condition:
       Defender's malware engine is tricked into executing an attacker-controlled
       payload that spawns a SYSTEM-level shell. cmd.exe and PowerShell are the
       primary PoC-delivered shells, but wscript/cscript/mshta are also possible
       for more sophisticated payloads. -->
  <rule id="102812" level="14">
    <if_sid>102810</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|conhost|wsl)\.exe$</field>
    <description>RoguePlanet: MsMpEng.exe spawned shell $(win.eventdata.image) on $(win.eventdata.computer) by user $(win.eventdata.user) -- confirmed CVE-2026-50656 exploitation vector; contains SYSTEM privilege escalation (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,rogueplanet,windows,shell_spawn,</group>
  </rule>

  <!-- MsMpEng.exe spawning shell with SYSTEM integrity level — confirmed exploitation.
       The RoguePlanet PoC delivers a shell running as NT AUTHORITY\SYSTEM.
       Any shell spawned from MsMpEng.exe with System integrity is a near-certain
       confirmed exploitation of CVE-2026-50656. Initiate immediate incident response. -->
  <rule id="102813" level="15">
    <if_sid>102812</if_sid>
    <field name="win.eventdata.integrityLevel" type="pcre2">(?i)^System$</field>
    <description>RoguePlanet: MsMpEng.exe spawned SYSTEM-integrity shell $(win.eventdata.image) on $(win.eventdata.computer) -- CRITICAL: confirmed CVE-2026-50656 exploitation; SYSTEM privileges achieved; initiate immediate incident response (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,rogueplanet,windows,system_shell,critical,</group>
  </rule>

  <!-- Defender scan directory (C:\ProgramData\Microsoft\Windows Defender\Scans)
       containing unexpected executable — potential staging for RoguePlanet payload.
       Attackers drop a malicious file into a location Defender scans automatically
       to trigger the race condition; an anomalous .exe in scan working directories
       is a pre-exploitation indicator. -->
  <rule id="102814" level="12">
    <decoded_as>json</decoded_as>
    <field name="win.eventdata.eventID" type="pcre2">^(11|23)$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)C:\\ProgramData\\Microsoft\\Windows Defender\\Scans\\.*\.(exe|dll|bat|ps1|vbs|js)$</field>
    <description>RoguePlanet: Executable dropped in Windows Defender scan directory $(win.eventdata.targetFilename) on $(win.eventdata.computer) -- potential CVE-2026-50656 pre-exploitation staging; review file origin (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,rogueplanet,windows,file_staging,</group>
  </rule>

  <!-- Symlink/junction creation in Defender scan path — core RoguePlanet technique.
       The exploit swaps a legitimate file with a symlink during Defender's scan
       to redirect Defender's file write into an attacker-controlled location.
       Detecting symlink creation in Defender-monitored paths is a pre-exploitation
       indicator visible before any privilege escalation occurs. -->
  <rule id="102815" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(mklink|New-Item.*Junction|fsutil.*hardlink|fsutil.*symlink).*(Defender|MsMpEng|WdFilter)</field>
    <description>RoguePlanet: Symlink or junction creation targeting Defender paths by $(win.eventdata.user) on $(win.eventdata.computer) -- potential CVE-2026-50656 exploitation setup; race condition preparation (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,rogueplanet,windows,symlink_abuse,</group>
  </rule>

</group>

<!-- Container Image CVE Rules — Grype Integration                          -->
<!-- Rule IDs: 101400-101499                                                   -->
<!-- Detects High and Critical CVEs in running container images scanned by     -->
<!-- Grype via the container-cve-scanner Ansible role (ESKA-174).              -->
<!--                                                                           -->
<!-- MITRE ATT&CK: T1190 (Exploit Public-Facing Application)                  -->
<!-- Group: vulnerability-detector — integrates with host OS CVE alerts for   -->
<!-- a unified dashboard view alongside Wazuh's built-in vuln-detector rules. -->
<!--                                                                           -->
<!-- Architecture: see wazuh/decoders/grype_cve.xml for log format and        -->
<!-- dedup strategy. Rules anchor on decoded_as=json + integration="grype".   -->
<!--                                                                           -->
<!-- Severity → alert level mapping:                                           -->
<!--   Critical (no fix)  → 12  |  Critical (fix available)  → 13             -->
<!--   High (no fix)      → 10  |  High (fix available)      → 11             -->
<!--   Medium / Low / Negligible → logged only (no alert, rules omitted)      -->
<!--                                                                           -->
<!-- Dedup: the container-cve-scanner role deduplicates at the script level   -->
<!-- (state file per host). Rules 101410-101411 add a 1-hour within-session   -->
<!-- suppressor as a safety net for edge-case duplicate log writes.            -->

<group name="vulnerability-detector,grype,container,">

  <!-- ================================================================ -->
  <!-- BASE RULE — anchors all Grype container CVE rules                -->
  <!-- Matches JSON events where integration field equals "grype".      -->
  <!-- All Grype finding events carry this field from the scanner role. -->
  <!-- ================================================================ -->

  <rule id="101400" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration" type="pcre2">^grype$</field>
    <description>Grype: Container image CVE scan event (base anchor)</description>
  </rule>


  <!-- ================================================================ -->
  <!-- CRITICAL severity CVEs                                           -->
  <!-- CVSS 9.0-10.0 range — typically remote code execution or        -->
  <!-- unauthenticated full compromise. Require prompt patching.        -->
  <!-- ================================================================ -->

  <!-- Critical CVE — no fix available yet -->
  <rule id="101401" level="12">
    <if_sid>101400</if_sid>
    <field name="severity" type="pcre2">(?i)^critical$</field>
    <description>Grype: CRITICAL CVE $(cve_id) in $(image_name) — $(package_name) $(package_version) (no fix)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,container_cve,critical,</group>
  </rule>

  <!-- Critical CVE — fix available. Elevated level to prioritise patching. -->
  <!-- fix_version matches a version string (starts with a digit).           -->
  <rule id="101402" level="13">
    <if_sid>101401</if_sid>
    <field name="fix_version" type="pcre2">^\d[\w.+~:-]*$</field>
    <description>Grype: CRITICAL CVE $(cve_id) in $(image_name) — fix available: upgrade $(package_name) to $(fix_version)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,container_cve,critical,fix_available,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- HIGH severity CVEs                                               -->
  <!-- CVSS 7.0-8.9 range — significant risk, requires investigation.  -->
  <!-- ================================================================ -->

  <!-- High CVE — no fix available yet -->
  <rule id="101403" level="10">
    <if_sid>101400</if_sid>
    <field name="severity" type="pcre2">(?i)^high$</field>
    <description>Grype: HIGH CVE $(cve_id) in $(image_name) — $(package_name) $(package_version) (no fix)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,container_cve,high,</group>
  </rule>

  <!-- High CVE — fix available. Elevated level to prioritise patching. -->
  <rule id="101404" level="11">
    <if_sid>101403</if_sid>
    <field name="fix_version" type="pcre2">^\d[\w.+~:-]*$</field>
    <description>Grype: HIGH CVE $(cve_id) in $(image_name) — fix available: upgrade $(package_name) to $(fix_version)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>vulnerability,container_cve,high,fix_available,</group>
  </rule>


  <!-- ================================================================ -->
  <!-- WITHIN-SESSION DEDUP — safety net suppressor rules               -->
  <!-- Primary dedup is the state file in container-cve-scanner role.  -->
  <!-- These rules suppress if the same CVE+image fires twice within   -->
  <!-- 1 hour — catches edge cases like log file re-reads or duplicate  -->
  <!-- entries from parallel scan jobs on the same host.               -->
  <!--                                                                  -->
  <!-- level=0 + options>no_log suppresses the composite event itself. -->
  <!-- The parent rule (101401/101403) already fired on occurrence 1;  -->
  <!-- occurrence 2+ within 3600s fires this suppressor instead.       -->
  <!-- ================================================================ -->

  <!-- Suppress duplicate Critical CVE within same scan session (1h) -->
  <rule id="101410" level="0" frequency="2" timeframe="3600">
    <if_matched_sid>101401</if_matched_sid>
    <same_field>cve_id</same_field>
    <same_field>image_name</same_field>
    <description>Grype: Duplicate Critical CVE $(cve_id) in $(image_name) within 1h — suppressed</description>
    <options>no_log</options>
  </rule>

  <!-- Suppress duplicate High CVE within same scan session (1h) -->
  <rule id="101411" level="0" frequency="2" timeframe="3600">
    <if_matched_sid>101403</if_matched_sid>
    <same_field>cve_id</same_field>
    <same_field>image_name</same_field>
    <description>Grype: Duplicate High CVE $(cve_id) in $(image_name) within 1h — suppressed</description>
    <options>no_log</options>
  </rule>

</group>

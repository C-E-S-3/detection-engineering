<!-- Privilege Escalation Detection Rules (MITRE ATT&amp;CK TA0004) -->
<!-- Rule IDs: 100400-100499 -->
<!-- Source: Curated from SigmaHQ detection rules -->

<group name="privilege_escalation,">

  <!-- UAC Bypass via fodhelper -->
  <rule id="100400" level="14">
    <if_sid>61645</if_sid>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\ms-settings\\Shell\\Open\\command</field>
    <description>Privilege Escalation: UAC bypass via fodhelper registry modification (T1548.002)</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
    <group>privilege_escalation,uac_bypass,</group>
  </rule>

  <!-- UAC Bypass via eventvwr -->
  <rule id="100401" level="14">
    <if_sid>61645</if_sid>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\mscfile\\Shell\\Open\\command</field>
    <description>Privilege Escalation: UAC bypass via eventvwr registry modification (T1548.002)</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
    <group>privilege_escalation,uac_bypass,</group>
  </rule>

  <!-- UAC Bypass via CMSTPLUA COM Object -->
  <rule id="100402" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\dllhost\.exe$</field>
    <field name="win.eventdata.parentCommandLine" type="pcre2">(?i)\{3E5FC7F9-9A51-4367-9063-A120244FBEC7\}</field>
    <description>Privilege Escalation: UAC bypass via CMSTPLUA COM object (T1548.002)</description>
    <mitre>
      <id>T1548.002</id>
    </mitre>
    <group>privilege_escalation,uac_bypass,</group>
  </rule>

  <!-- Token Manipulation -->
  <!-- The trailing-$ clause excludes Active Directory computer/machine accounts
       (samAccountName ending in "$"). EventID 4672 fires on every privileged logon,
       and machine accounts trigger it constantly, producing a high false-positive
       rate at this severity. Genuine interactive and service accounts still alert. -->
  <rule id="100410" level="13">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4672$</field>
    <field name="win.eventdata.subjectUserName" type="pcre2">(?i)^(?!SYSTEM$|LOCAL SERVICE$|NETWORK SERVICE$|.*\$$)</field>
    <description>Privilege Escalation: Special privileges assigned to non-system account (T1134)</description>
    <mitre>
      <id>T1134</id>
    </mitre>
    <group>privilege_escalation,token_manipulation,</group>
  </rule>

  <!-- Named Pipe Impersonation -->
  <rule id="100420" level="13">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\\\\\.\\pipe\\|ImpersonateNamedPipeClient|CreateNamedPipe)</field>
    <description>Privilege Escalation: Named pipe impersonation detected (T1134.001)</description>
    <mitre>
      <id>T1134.001</id>
    </mitre>
    <group>privilege_escalation,named_pipe,</group>
  </rule>

  <!-- Exploitation via Vulnerable Driver -->
  <rule id="100430" level="13">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^6$</field>
    <field name="win.eventdata.signed">false</field>
    <description>Privilege Escalation: Unsigned driver loaded (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,vulnerable_driver,</group>
  </rule>

  <!-- Process Injection via CreateRemoteThread -->
  <rule id="100440" level="13">
    <if_sid>61644</if_sid>
    <field name="win.system.eventID">^8$</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)\\(powershell|cmd|wscript|cscript|mshta|rundll32)\.exe$</field>
    <description>Privilege Escalation: Remote thread created from scripting engine (T1055.003)</description>
    <mitre>
      <id>T1055.003</id>
    </mitre>
    <group>privilege_escalation,process_injection,</group>
  </rule>

  <!-- Unquoted Service Path Exploitation -->
  <rule id="100450" level="11">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath" type="pcre2">^[^"].*\s.*\.exe</field>
    <description>Privilege Escalation: Service installed with unquoted path containing spaces (T1574.009)</description>
    <mitre>
      <id>T1574.009</id>
    </mitre>
    <group>privilege_escalation,unquoted_service,</group>
  </rule>

</group>

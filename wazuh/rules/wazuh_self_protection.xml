<?xml version="1.0" encoding="UTF-8"?>
<!-- Wazuh SIEM Self-Protection Rules
     Detects attacks against the Wazuh SIEM infrastructure itself, including:
     - CVE-2026-25769: RCE via insecure deserialization in Wazuh cluster protocol
       (affects Wazuh 4.0.0–4.14.2; fixed in 4.14.3)
     - Wazuh API brute force and unauthorized access
     - Wazuh cluster anomalies indicating compromise
     - Post-exploitation: config tampering, agent manipulation
     MITRE ATT&amp;CK: T1190, T1110, T1562.001, T1059, T1070.002
-->
<group name="wazuh_self_protection,">

  <!-- ===== Wazuh API Brute Force / Unauthorized Access (T1110) ===== -->

  <rule id="103200" level="6">
    <if_sid>100001</if_sid>
    <match>Invalid credentials</match>
    <description>Wazuh API: invalid credentials (potential brute force) — T1110</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="103201" level="10" frequency="6" timeframe="60">
    <if_matched_sid>103200</if_matched_sid>
    <description>Wazuh API brute force: 6+ failed logins in 60s — T1110</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="103202" level="12">
    <if_sid>100001</if_sid>
    <match>Error getting token|JWT error|token expired|Unauthorized</match>
    <regex>wazuh-api|/security/user/authenticate</regex>
    <description>Wazuh API: authentication anomaly — potential unauthorized access attempt — T1110</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- ===== CVE-2026-25769: Cluster Protocol Deserialization Anomaly ===== -->

  <rule id="103210" level="12">
    <if_sid>100001</if_sid>
    <match>wazuh-clusterd</match>
    <regex>Traceback|ImportError|ModuleNotFoundError|__import__|__reduce__|object_hook</regex>
    <description>Wazuh cluster daemon: suspicious deserialization error — possible CVE-2026-25769 exploitation attempt (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,</group>
  </rule>

  <rule id="103211" level="14">
    <if_sid>100001</if_sid>
    <match>wazuh-clusterd</match>
    <regex>subprocess|os\.system|eval\(|exec\(|compile\(|importlib|builtins</regex>
    <description>Wazuh cluster daemon: Python code execution pattern in cluster log — high-confidence CVE-2026-25769 exploitation (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,</group>
  </rule>

  <rule id="103212" level="13">
    <if_sid>100001</if_sid>
    <match>wazuh-clusterd</match>
    <regex>Failed to receive|Integrity check|Invalid cluster|Unknown cluster node|Invalid node name</regex>
    <description>Wazuh cluster: unexpected node or integrity failure — potential rogue worker node (CVE-2026-25769 prerequisite) — T1190</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,</group>
  </rule>

  <!-- ===== Wazuh Process Spawning Unusual Children (post-exploitation) ===== -->

  <rule id="103220" level="15">
    <if_group>audit_command</if_group>
    <field name="audit.uid">109</field>
    <regex>bash|sh|python|python3|perl|ruby|nc|ncat|netcat|wget|curl|chmod|useradd</regex>
    <description>Wazuh process (uid 109) spawned unexpected shell/tool — possible post-exploitation via CVE-2026-25769 (T1059)</description>
    <mitre>
      <id>T1059</id>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,rootcheck,</group>
  </rule>

  <rule id="103221" level="15">
    <if_group>audit_command</if_group>
    <field name="audit.uid">109</field>
    <regex>crontab|at |schtasks|systemctl enable|useradd|adduser|passwd|ssh-keygen|authorized_keys</regex>
    <description>Wazuh process executing persistence mechanism — post-exploitation via SIEM compromise (T1059/T1543)</description>
    <mitre>
      <id>T1059</id>
      <id>T1543</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,rootcheck,</group>
  </rule>

  <!-- ===== Wazuh Configuration Tampering (T1562.001) ===== -->

  <rule id="103230" level="12">
    <if_group>syscheck</if_group>
    <match>ossec.conf|local_rules.xml|wazuh-clusterd.conf</match>
    <description>Wazuh configuration file modified — potential defense evasion/SIEM tampering (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>config_changed,</group>
  </rule>

  <rule id="103231" level="14">
    <if_group>syscheck</if_group>
    <match>ossec.conf|local_rules.xml</match>
    <field name="syscheck.event">modified</field>
    <regex type="pcre2">(?:&lt;active-response&gt;|&lt;global&gt;|&lt;cluster&gt;)</regex>
    <description>Wazuh critical config section modified (active-response/global/cluster) — high-risk defense evasion (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>config_changed,</group>
  </rule>

  <!-- ===== Wazuh Agent Manipulation (T1562.001) ===== -->

  <rule id="103240" level="10">
    <if_sid>100001</if_sid>
    <match>wazuh-agentd|ossec-agentd</match>
    <regex>Invalid shared configuration|Error unpacking|Error reading shared files|SharedFiles error</regex>
    <description>Wazuh agent: shared configuration error — possible tampered agent config distribution from compromised manager (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>wazuh_agent,</group>
  </rule>

  <rule id="103241" level="12">
    <if_sid>100001</if_sid>
    <match>wazuh-agentd|ossec-agentd</match>
    <regex>remote-config|merged.mg|agent.conf</regex>
    <field name="syscheck.event">modified</field>
    <description>Wazuh agent: merged config file modified — possible compromised manager pushing malicious config (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>wazuh_agent,config_changed,</group>
  </rule>

  <!-- ===== Wazuh Log Suppression / Alert Manipulation (T1070.002) ===== -->

  <rule id="103250" level="13">
    <if_group>syscheck</if_group>
    <match>ossec.log|alerts.json|archives.json|active-responses.log</match>
    <field name="syscheck.event">deleted</field>
    <description>Wazuh log/alert file deleted — active log suppression indicating defense evasion (T1070.002)</description>
    <mitre>
      <id>T1070.002</id>
    </mitre>
    <group>log_clear,</group>
  </rule>

  <rule id="103251" level="15">
    <if_sid>103250</if_sid>
    <match>alerts.json</match>
    <description>Wazuh alerts.json deleted — critical: SIEM blind spot created, attacker may be covering tracks (T1070.002)</description>
    <mitre>
      <id>T1070.002</id>
    </mitre>
    <group>log_clear,</group>
  </rule>

  <!-- ===== Wazuh Cluster Port Unusual Connections (T1190 prerequisite) ===== -->

  <rule id="103260" level="10">
    <if_group>firewall</if_group>
    <regex>DPT=1516|dpt=1516|port=1516</regex>
    <description>Connection to Wazuh cluster communication port 1516 — unexpected cluster node may indicate CVE-2026-25769 setup (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,network_access_control,</group>
  </rule>

  <!-- ===== Correlation: Wazuh Under Active Attack ===== -->

  <rule id="103270" level="15" frequency="3" timeframe="300">
    <if_matched_group>exploit_attempt</if_matched_group>
    <match>cve-2026-25769</match>
    <description>CRITICAL: Multiple CVE-2026-25769 exploitation signals in 5 min — Wazuh SIEM under active attack. Upgrade to 4.14.3+ immediately. (T1190)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,cve-2026-25769,</group>
  </rule>

</group>

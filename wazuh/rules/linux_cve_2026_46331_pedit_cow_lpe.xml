<!-- ============================================================
     Linux Kernel Pedit COW Local Privilege Escalation Detection Rules
     CVE-2026-46331 ("pedit COW") — CVSS 4.0: AV:L/AC:L/AT:N/PR:L/UI:N (8.5 HIGH)
     MITRE ATT&CK:
       T1068       — Exploitation for Privilege Escalation
       T1548.001   — Setuid and Setgid (post-exploit)
       T1611       — Escape to Host (container/namespace context)
     Rule IDs: 103694–103702
     Author: SecOps Engineer (Purple Team) — ESKA-394
     Date: 2026-06-27
     References:
       - https://nvd.nist.gov/vuln/detail/CVE-2026-46331
       - https://thehackernews.com/2026/06/new-linux-pedit-cow-exploit-enables.html
       - https://tuxcare.com/blog/pedit-cow-cve/
     CISA KEV: Not yet listed (as of 2026-06-27) — weaponized PoC public since 2026-06-17

     Vulnerability summary:
       A copy-on-write (COW) race condition in `net/sched/act_pedit.c` allows a
       local user to escalate to root via the Linux Traffic Control (tc) subsystem.
       The exploit requires:
         1. Unprivileged user namespaces (unshare CLONE_NEWUSER|CLONE_NEWNET)
         2. CAP_NET_ADMIN within that namespace (granted automatically in a user ns)
         3. Execution of `tc filter add ... action pedit` to trigger the race
       All Ubuntu 18.04–26.04 and kernel versions v5.18–7.1-rc7 are affected.
       Public PoC ("packet_edit_meme") appeared 2026-06-17, one day after CVE assignment.

     Log source prerequisites — add to ALL Linux hosts via Ansible (inframan):
       File: /etc/audit/rules.d/90-pedit-cow.rules

         # tc traffic control commands by non-root (pedit COW primary vector)
         -a always,exit -F arch=b64 -S execve -F uid!=0 -F exe=/sbin/tc -k pedit_cow_tc
         -a always,exit -F arch=b64 -S execve -F uid!=0 -F exe=/usr/sbin/tc -k pedit_cow_tc

         # modprobe loading tc/netfilter modules by non-root (module preloading)
         -a always,exit -F arch=b64 -S execve -F uid!=0 -F exe=/sbin/modprobe -k pedit_cow_modprobe
         -a always,exit -F arch=b64 -S execve -F uid!=0 -F exe=/usr/sbin/modprobe -k pedit_cow_modprobe
         -a always,exit -F arch=b64 -S execve -F uid!=0 -F exe=/usr/bin/kmod -k pedit_cow_modprobe

         # unshare syscall by non-root (namespace creation — exploit precondition)
         -a always,exit -F arch=b64 -S unshare -F uid!=0 -k pedit_cow_unshare

       Note: The existing `priv_esc` auditd key (rule 100610) already covers
       post-exploit sudo/su execution; no additional rule needed for that signal.

     Known PoC binary names:
       packet_edit_meme — primary public GitHub PoC binary
       pe_cow           — variant/alias used in modified PoC forks

     Severity rationale:
       10 — tc by non-root (unusual; low false-positive rate in homelab)
       13 — tc with pedit/filter keyword in args (high-confidence exploitation attempt)
       13 — modprobe loading act_pedit or cls_u32 by non-root (kernel module preload)
       15 — Known PoC binary name executed (confirmed exploitation attempt)
       11 — unshare/new user namespace by non-root (exploit precondition only)
       14 — Exploitation chain: namespace creation → tc pedit within 2 minutes
     ============================================================ -->

<group name="privilege_escalation,linux,pedit_cow,cve_2026_46331,">

  <!-- ===========================================================
       T1068 — Exploitation for Privilege Escalation
       Rules 103694–103696: tc traffic control by non-root
       Auditd prereq: -S execve -F uid!=0 -F exe=*/tc -k pedit_cow_tc
       =========================================================== -->

  <!-- Base anchor: any `tc` (iproute2 Traffic Control) execution by non-root user.
       In the homelab environment tc is an administrative tool with no legitimate
       non-root use. Wazuh routes auditd execve events with key pedit_cow_tc here. -->
  <rule id="103694" level="0">
    <decoded_as>auditd</decoded_as>
    <field name="audit.key">pedit_cow_tc</field>
    <description>Pedit COW: tc (Traffic Control) executed by non-root user (base anchor) (CVE-2026-46331)</description>
  </rule>

  <!-- tc invocation by any non-root, non-system user.
       auid=4294967295 is the unset/kernel auid — excluded to prevent false positives
       from module-init and early-boot code paths that carry no audit session.
       Level 10: suspicious but tc can be called indirectly by some init scripts. -->
  <rule id="103695" level="10">
    <if_sid>103694</if_sid>
    <field name="audit.auid" negate="yes">^0$</field>
    <field name="audit.auid" negate="yes">^4294967295$</field>
    <description>Pedit COW: tc (iproute2) executed by unprivileged uid=$(audit.auid) (exe=$(audit.exe)) — tc has no legitimate non-root use; investigate for CVE-2026-46331 exploitation attempt (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,tc_abuse,linux,cve_2026_46331,</group>
  </rule>

  <!-- tc with pedit or filter keywords in the command arguments — the exploit
       specifically requires `tc filter add ... action pedit` to trigger the COW race.
       Matching on audit.execve.a* fields or full_log catches the argument string.
       Level 13: high-confidence exploitation precursor. -->
  <rule id="103696" level="13">
    <if_sid>103695</if_sid>
    <field name="full_log" type="pcre2">(?i)\b(pedit|filter\s+add|qdisc\s+add|cls_u32|act_pedit)\b</field>
    <description>Pedit COW: tc with pedit/filter action args by unprivileged uid=$(audit.auid) — direct CVE-2026-46331 exploitation precursor; `tc filter add ... action pedit` triggers the kernel COW race (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,tc_abuse,linux,cve_2026_46331,</group>
  </rule>


  <!-- ===========================================================
       T1068 — Exploitation for Privilege Escalation
       Rules 103697–103698: modprobe loading act_pedit/cls_u32 by non-root
       Auditd prereq: -S execve -F uid!=0 -F exe=*/modprobe -k pedit_cow_modprobe
       =========================================================== -->

  <!-- Base anchor: modprobe/kmod executed by non-root with pedit_cow_modprobe key.
       The exploit may pre-load cls_u32 and act_pedit kernel modules before running
       tc. On hardened systems where kernel modules are not auto-loaded, this step
       is required. -->
  <rule id="103697" level="0">
    <decoded_as>auditd</decoded_as>
    <field name="audit.key">pedit_cow_modprobe</field>
    <description>Pedit COW: modprobe/kmod executed by non-root (base anchor) (CVE-2026-46331)</description>
  </rule>

  <!-- modprobe loading act_pedit or cls_u32 by a non-root, non-system user.
       These are the exact kernel modules required by the tc pedit subsystem.
       Legitimate module loading on these hosts is done at boot by root/systemd only.
       Matching on full_log catches the module name in the execve argv. -->
  <rule id="103698" level="13">
    <if_sid>103697</if_sid>
    <field name="audit.auid" negate="yes">^0$</field>
    <field name="audit.auid" negate="yes">^4294967295$</field>
    <field name="full_log" type="pcre2">(?i)\b(act_pedit|cls_u32|sch_ingress|act_mirred)\b</field>
    <description>Pedit COW: modprobe loading tc kernel module (act_pedit/cls_u32) by unprivileged uid=$(audit.auid) — kernel module preloading for CVE-2026-46331 exploitation; `modprobe cls_u32 act_pedit` is a documented exploitation step (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,modprobe_abuse,linux,cve_2026_46331,</group>
  </rule>


  <!-- ===========================================================
       T1068 — Exploitation for Privilege Escalation
       Rule 103699: Known PoC binary execution (any user, any method)
       Auditd prereq: existing `-S execve -k exec` or syslog process events
       =========================================================== -->

  <!-- Execution of known CVE-2026-46331 PoC binary names.
       packet_edit_meme: primary public GitHub exploit binary (first PoC, 2026-06-17)
       pe_cow: shortened alias variant seen in PoC forks
       This rule matches on both auditd (via audit.exe or full_log) and syslog
       process creation events. Level 15: near-certain active exploitation. -->
  <rule id="103699" level="15">
    <decoded_as>auditd</decoded_as>
    <field name="audit.exe" type="pcre2">(?i)(packet_edit_meme|pe_cow)</field>
    <description>Pedit COW: KNOWN PoC BINARY EXECUTED — $(audit.exe) (uid=$(audit.auid)) — confirmed CVE-2026-46331 exploitation attempt; initiate incident response immediately (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,poc_execution,linux,cve_2026_46331,critical,</group>
  </rule>

  <!-- Syslog/process-event variant: catches PoC execution where auditd is absent
       or when the binary name appears in kernel process log or syslog.
       The pcre2 pattern matches on the full log line without requiring auditd decoder. -->
  <rule id="103700" level="15">
    <match type="pcre2">(?i)\b(packet_edit_meme|pe_cow)\b</match>
    <description>Pedit COW: KNOWN PoC BINARY NAME in process/syslog event — CVE-2026-46331 exploitation tool detected; initiate incident response immediately (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,poc_execution,linux,cve_2026_46331,critical,</group>
  </rule>


  <!-- ===========================================================
       T1611 / T1068 — Namespace creation as exploit precondition
       Rule 103701: unshare() by non-root creating new user+net namespace
       Auditd prereq: -S unshare -F uid!=0 -k pedit_cow_unshare
       =========================================================== -->

  <!-- unshare() with CLONE_NEWUSER (bit 0x10000000) by non-root.
       The exploit REQUIRES unprivileged user namespaces to gain CAP_NET_ADMIN.
       On Ubuntu 18.04+ unprivileged user namespaces are enabled by default
       (kernel.unprivileged_userns_clone=1). This is not always malicious
       (containers, Bubblewrap, Flatpak), so level 11 — raise if combined with
       subsequent tc or modprobe events. -->
  <rule id="103701" level="11">
    <decoded_as>auditd</decoded_as>
    <field name="audit.key">pedit_cow_unshare</field>
    <field name="audit.auid" negate="yes">^0$</field>
    <field name="audit.auid" negate="yes">^4294967295$</field>
    <description>Pedit COW: unshare() (new user/net namespace) by unprivileged uid=$(audit.auid) — required precondition for CVE-2026-46331 exploit; investigate if followed by tc filter or modprobe events from same user (T1611/T1068)</description>
    <mitre>
      <id>T1068</id>
      <id>T1611</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,namespace_abuse,linux,cve_2026_46331,</group>
  </rule>


  <!-- ===========================================================
       T1068 — Exploitation Chain: namespace creation → tc pedit
       Rule 103702: composite correlation within 2-minute window
       =========================================================== -->

  <!-- High-confidence exploitation chain: an unprivileged user creates a new
       user/network namespace (rule 103701) and within 120 seconds executes tc
       with pedit arguments (rule 103696). This two-step sequence exactly matches
       the documented CVE-2026-46331 attack flow from the packet_edit_meme PoC:
         1. unshare(CLONE_NEWUSER|CLONE_NEWNET)
         2. tc filter add dev lo ingress ... action pedit  (triggers race)
       The 120-second window covers expected setup + exploit loop time. -->
  <rule id="103702" level="14" timeframe="120">
    <if_matched_sid>103701</if_matched_sid>
    <if_sid>103696</if_sid>
    <description>Pedit COW: EXPLOITATION CHAIN DETECTED — unprivileged namespace creation followed by tc pedit action within 2 minutes — high-confidence CVE-2026-46331 active exploitation; initiate incident response (T1068)</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>privilege_escalation,pedit_cow,exploitation_chain,linux,cve_2026_46331,critical,</group>
  </rule>

</group>
